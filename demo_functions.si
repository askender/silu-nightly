# Test for function definition and call
def greet(name):
    print("Hello, " + name)

greet("World")

# Test for function with return value
def add(a, b):
    return a + b

result = add(3, 5)
print("3 + 5 =", result)

# Test for function with control flow
def countdown(n):
    while n > 0:
        print(n)
        n = n - 1
    print("Done!")

countdown(3)