# JSON parsing: recursive descent over a document provided on stdin.
# (The document is generated by scripts/gen_json_input.py - identical
# bytes for all three implementations; generation is scaffolding, not
# part of the measured work. Exercises str indexing (O(1) on ASCII),
# recursion, and the Rust-enum-shaped value tree: JInt/JStr/JArr/JObj
# variant classes consumed through class-pattern narrowing, so the
# per-element work (arithmetic, field reads, list[str] collection) is
# static; only the value containers stay dynamic.)

class JInt:
    v: int

class JStr:
    v: str

class JArr:
    items: list

class JObj:
    o: dict


def digit_value(ch: str) -> int:
    if ch == "0":
        return 0
    if ch == "1":
        return 1
    if ch == "2":
        return 2
    if ch == "3":
        return 3
    if ch == "4":
        return 4
    if ch == "5":
        return 5
    if ch == "6":
        return 6
    if ch == "7":
        return 7
    if ch == "8":
        return 8
    return 9


def parse_string(s: str, pos: list[int]):
    # scan to the closing quote, then one slice (no per-char concat)
    pos[0] += 1
    start: int = pos[0]
    while s[pos[0]] != '"':
        pos[0] += 1
    out: str = s[start:pos[0]]
    pos[0] += 1
    return out


def parse_number(s: str, pos: list[int]) -> int:
    n: int = 0
    while pos[0] < len(s) and s[pos[0]] >= "0" and s[pos[0]] <= "9":
        n = n * 10 + digit_value(s[pos[0]])
        pos[0] += 1
    return n


def parse_array(s: str, pos: list[int]):
    result = []
    pos[0] += 1  # [
    while s[pos[0]] != "]":
        result.append(parse_value(s, pos))
        if s[pos[0]] == ",":
            pos[0] += 1
    pos[0] += 1  # ]
    return JArr(result)


def parse_object(s: str, pos: list[int]):
    result = {}
    pos[0] += 1  # {
    while s[pos[0]] != "}":
        key = parse_string(s, pos)
        pos[0] += 1  # colon
        result[key] = parse_value(s, pos)
        if s[pos[0]] == ",":
            pos[0] += 1
    pos[0] += 1  # }
    return JObj(result)


def parse_value(s: str, pos: list[int]):
    ch = s[pos[0]]
    if ch == "{":
        return parse_object(s, pos)
    if ch == "[":
        return parse_array(s, pos)
    if ch == '"':
        return JStr(parse_string(s, pos))
    return JInt(parse_number(s, pos))


doc: str = input()

# collect the parsed "name" values into a raw str list and checksum
# them - the per-element work rides the class-pattern narrowing
names: list[str] = []
total: int = 0
count: int = 0
data = parse_value(doc, [0])
match data:
    case JArr(items):
        i: int = 0
        while i < len(items):
            match items[i]:
                case JObj(o):
                    match o["id"]:
                        case JInt(n):
                            total += n
                    match o["name"]:
                        case JStr(w):
                            names.append(w)
            i += 1
        count = len(items)
    case _:
        count = 0
checksum: int = 0
i = 0
while i < len(names):
    checksum += len(names[i])
    i += 1
print(total, count, checksum, len(names))
