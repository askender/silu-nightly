# Word frequency counting: dict[str, int] over a procedural stream.
# The vocabulary is built with str(int) so the stream is deterministic
# across the interpreter, CPython and the compiled binary.
vocab: list[str] = []
i: int = 0
while i < 100:
    vocab.append("w" + str(i))
    i += 1

counts = {}
i = 0
while i < 300000:
    w = vocab[(i * 48271 + 11) % 100]
    counts[w] = counts.get(w, 0) + 1
    i += 1

total: int = 0
i = 0
while i < 100:
    total += counts["w" + str(i)]
    i += 1
print(total, len(counts))
