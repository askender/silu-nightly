d: dict[str, int] = {}
d["a"] = 1
v1: int = d.pop("missing", 7)
print(v1)
n: int = d.setdefault("b", 3)
print(n)
di: dict[int, int] = {}
di[1] = 10
v2: int = di.pop(1)
print(v2)
di.setdefault(2, 20)
print(di[2])
di.clear()
print(len(di))
# oracle shape round (2026-11-22): non-empty literals (dsi + dii) and
# value-context membership.
dl: dict[str, int] = {"p": 1, "q": 2}
print(dl["p"] + dl["q"])
print("p" in dl)
print("z" in dl)
di2: dict[int, int] = {5: 10, 7: 20}
print(di2[7])
