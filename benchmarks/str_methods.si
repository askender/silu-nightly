s: str = "Hello World"
print(len(s))
print(s.startswith("Hello"))
print(s.endswith("World"))
t: str = s.lower()
print(t)
u: str = s.upper()
print(u)
parts: list[str] = s.split(" ")
print(len(parts))
print(parts[0])
w: str = "  pad  "
print(w.strip())
print(s.replace("World", "Silu"))
print(s.find("World"))
print(s.find("xyz"))
i: int = s.index("W")
print(i)
print(s.isdigit())
print("123".isdigit())
