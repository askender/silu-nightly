# Binary trees (Benchmarks Game classic): allocator stress + recursion.
# Build a tree of depth d and count nodes recursively.

def make_tree(depth: int) -> int:
    # returns node count of a tree at this depth (1 leaf below depth 1)
    if depth <= 0:
        return 1
    return 1 + make_tree(depth - 1) + make_tree(depth - 1)


def check(depth: int) -> int:
    # iterative walk emulation: total nodes at depth d = 2^(d+1) - 1,
    # computed recursively to stress the call stack
    return make_tree(depth)


min_depth: int = 4
max_depth: int = 14

depth: int = min_depth
while depth <= max_depth:
    nodes: int = check(depth)
    print("depth", depth, "nodes", nodes)
    depth += 1
