# Test all mathematical and comparison operations

# Basic arithmetic
x = 10 + 5
y = 10 - 3
z = 10 * 2
a = 10 / 3
b = 10 // 3
c = 10 % 3
d = 2 ** 3

# Print arithmetic results
print("Arithmetic operations:")
print("x = 10 + 5 =", x)
print("y = 10 - 3 =", y)
print("z = 10 * 2 =", z)
print("a = 10 / 3 =", a)
print("b = 10 // 3 =", b)
print("c = 10 % 3 =", c)
print("d = 2 ** 3 =", d)

# Unary operations
e = +5
f = -5
g = not True
h = not False

# Print unary results
print("\nUnary operations:")
print("e = +5 =", e)
print("f = -5 =", f)
print("g = not True =", g)
print("h = not False =", h)

# Boolean operations
i = True and False
j = True or False

# Print boolean results
print("\nBoolean operations:")
print("i = True and False =", i)
print("j = True or False =", j)

# Comparison operations
k = 5 == 5
l = 5 != 3
m = 5 < 10
n = 5 <= 5
o = 10 > 5
p = 10 >= 10

# Print comparison results
print("\nComparison operations:")
print("k = 5 == 5 =", k)
print("l = 5 != 3 =", l)
print("m = 5 < 10 =", m)
print("n = 5 <= 5 =", n)
print("o = 10 > 5 =", o)
print("p = 10 >= 10 =", p)

# Chained comparisons
q = 3 < 5 < 7
r = 5 < 3 < 7

# Print chained comparison results
print("\nChained comparisons:")
print("q = 3 < 5 < 7 =", q)
print("r = 5 < 3 < 7 =", r)