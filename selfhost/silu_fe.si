# M4 self-hosting milestone (docs/m4_frontend.md): the front end of a
# Silu compiler, written in Silu itself. Reads Silu source on stdin,
# emits the Silu tuple-IR as JSON on stdout - byte-identical to what
# `silu ir --format json` produces for the same program.
# Pipeline: [this program] -> M2 (ir_interp) / M3 (ir2c) -> C -> clang.

import json


class TokKind(Enum):
    NAME = 0
    NUM = 1
    STR = 2
    OP = 3
    KW = 4
    NL = 5
    END = 6
    FSTR = 7
    BYTES = 8


class Token:
    kind: TokKind
    text: str
    line: int
    col: int


class Lexer:
    src: str
    pos: int
    line: int
    col: int
    depth: int

    # The source is materialized ONCE into a codepoint list that
    # travels as an explicit parameter (cps: list[int]); cps[i] is
    # O(1) for any source. Indexing the rawstr directly costs O(pos)
    # per char as soon as the source holds ANY multibyte UTF-8
    # (rawutf8_cp_offset walks from byte 0 to the i-th codepoint),
    # which made the whole lexer O(n^2) - one U+00A7 inside a
    # docstring was enough for siluc1 to spend minutes before even
    # reporting a parse error.

    def peek_cp(self, cps: list[int]) -> int:
        if self.pos >= len(cps):
            return -1
        return cps[self.pos]

    def peek2_cp(self, cps: list[int]) -> int:
        if self.pos + 1 >= len(cps):
            return -1
        return cps[self.pos + 1]

    def peek3_cp(self, cps: list[int]) -> int:
        if self.pos + 2 >= len(cps):
            return -1
        return cps[self.pos + 2]

    def advance(self, cps: list[int]) -> int:
        c: int = self.peek_cp(cps)
        self.pos += 1
        if c == 10:
            self.line += 1
            self.col = 0
        else:
            self.col += 1
        return c

    def text(self, cps: list[int], a: int, b: int) -> str:
        # token text = cps[a:b], clamped at both ends like rawstr
        # slicing; append+join keeps giant tokens (module docstrings)
        # O(1) amortized per char - plain concat would be O(len^2)
        if a < 0:
            a = 0
        if b > len(cps):
            b = len(cps)
        out: list[str] = []
        i: int = a
        while i < b:
            out.append(chr(cps[i]))
            i += 1
        return "".join(out)

    def skip_ws_and_comments(self, cps: list[int]) -> int:
        while self.pos < len(cps):
            c: int = self.peek_cp(cps)
            if c == 32 or c == 9:
                self.advance(cps)
            elif c == 35:
                while self.pos < len(cps) and self.peek_cp(cps) != 10:
                    self.advance(cps)
            else:
                return 0
        return 0

    def is_name_start_cp(self, c: int) -> bool:
        return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95

    def is_name_char_cp(self, c: int) -> bool:
        return self.is_name_start_cp(c) or (c >= 48 and c <= 57)

    def is_kw(self, text: str) -> bool:
        return (
            text == "def" or text == "class" or text == "if" or text == "elif"
            or text == "else" or text == "while" or text == "for" or text == "in"
            or text == "not" or text == "and" or text == "or" or text == "return"
            or text == "break" or text == "continue" or text == "pass"
            or text == "import" or text == "from"
            or text == "raise" or text == "is" or text == "None" or text == "True"
            or text == "False" or text == "lambda" or text == "del" or text == "assert"
            or text == "with" or text == "as" or text == "try" or text == "except"
            or text == "finally" or text == "global" or text == "nonlocal" or text == "yield"
            or text == "async" or text == "await" or text == "if"
        )

    def next_token(self, cps: list[int]) -> Token:
        self.skip_ws_and_comments(cps)
        if self.pos >= len(cps):
            return Token(TokKind.END, "", self.line, self.col)
        c: int = self.peek_cp(cps)
        line = self.line
        col = self.col
        if c == 10:
            self.advance(cps)
            if self.depth > 0:
                return self.next_token(cps)
            return Token(TokKind.NL, "\n", line, col)
        if (c == 98 or c == 66) and (self.peek2_cp(cps) == 34 or self.peek2_cp(cps) == 39):
            # bytes literal: b'...' / b"..." - escapes decoded later
            qb: int = self.peek2_cp(cps)
            self.advance(cps)
            self.advance(cps)
            startb: int = self.pos
            while self.pos < len(cps) and self.peek_cp(cps) != qb:
                if self.peek_cp(cps) == 92:
                    self.advance(cps)
                self.advance(cps)
            rawb: str = self.text(cps, startb, self.pos)
            self.advance(cps)
            return Token(TokKind.BYTES, rawb, line, col)
        if (c == 102 or c == 70) and (self.peek2_cp(cps) == 34 or self.peek2_cp(cps) == 39):
            # f-string: 'f' + quote ... quote, raw text (braces intact)
            q0: int = self.peek2_cp(cps)
            self.advance(cps)
            self.advance(cps)
            startf: int = self.pos
            while self.pos < len(cps) and self.peek_cp(cps) != q0:
                if self.peek_cp(cps) == 92:
                    self.advance(cps)
                self.advance(cps)
            rawf: str = self.text(cps, startf, self.pos)
            self.advance(cps)  # closing quote
            return Token(TokKind.FSTR, rawf, line, col)
        if self.is_name_start_cp(c):
            start: int = self.pos
            while self.pos < len(cps) and self.is_name_char_cp(self.peek_cp(cps)):
                self.advance(cps)
            text: str = self.text(cps, start, self.pos)
            if self.is_kw(text):
                return Token(TokKind.KW, text, line, col)
            return Token(TokKind.NAME, text, line, col)
        if c >= 48 and c <= 57:
            start: int = self.pos
            # 0x hex literal (and 0b/0o) - one token, no dot/exponent
            nxt: int = self.peek2_cp(cps)
            if c == 48 and (nxt == 120 or nxt == 88):
                self.advance(cps)
                self.advance(cps)
                while self.pos < len(cps):
                    d: int = self.peek_cp(cps)
                    if (d >= 48 and d <= 57) or (d >= 97 and d <= 102) or (d >= 65 and d <= 70):
                        self.advance(cps)
                    else:
                        break
                return Token(TokKind.NUM, self.text(cps, start, self.pos), line, col)
            if c == 48 and (nxt == 98 or nxt == 66 or nxt == 111 or nxt == 79):
                self.advance(cps)
                self.advance(cps)
                while self.pos < len(cps):
                    d: int = self.peek_cp(cps)
                    if (d >= 48 and d <= 57) or d == 95:
                        self.advance(cps)
                    else:
                        break
                return Token(TokKind.NUM, self.text(cps, start, self.pos), line, col)
            seen_dot: bool = False
            seen_exp: bool = False
            while self.pos < len(cps):
                d: int = self.peek_cp(cps)
                if (d >= 48 and d <= 57) or d == 95:
                    self.advance(cps)
                elif d == 46 and not seen_dot and not seen_exp and self.peek2_cp(cps) != 46:
                    seen_dot = True
                    self.advance(cps)
                elif (d == 101 or d == 69) and not seen_exp:
                    seen_exp = True
                    self.advance(cps)
                    nxt2: int = self.peek_cp(cps)
                    if nxt2 == 43 or nxt2 == 45:
                        self.advance(cps)
                else:
                    return Token(TokKind.NUM, self.text(cps, start, self.pos), line, col)
            return Token(TokKind.NUM, self.text(cps, start, self.pos), line, col)
        if c == 34 or c == 39:
            # triple-quoted string (multi-line, escapes honored) -
            # module/function docstrings in dual-valid sources
            if self.peek2_cp(cps) == c and self.peek3_cp(cps) == c:
                self.advance(cps)
                self.advance(cps)
                self.advance(cps)
                start: int = self.pos
                closed: bool = False
                while self.pos < len(cps):
                    if (
                        self.peek_cp(cps) == c
                        and self.peek2_cp(cps) == c
                        and self.peek3_cp(cps) == c
                    ):
                        closed = True
                        break
                    if self.peek_cp(cps) == 92:
                        self.advance(cps)
                    self.advance(cps)
                text: str = self.text(cps, start, self.pos)
                if closed:
                    self.advance(cps)
                    self.advance(cps)
                    self.advance(cps)
                return Token(TokKind.STR, text, line, col)
            q: int = self.advance(cps)
            start: int = self.pos
            while self.pos < len(cps) and self.peek_cp(cps) != q:
                if self.peek_cp(cps) == 92:
                    self.advance(cps)
                self.advance(cps)
            text: str = self.text(cps, start, self.pos)
            self.advance(cps)  # closing quote
            return Token(TokKind.STR, text, line, col)
        # operators: longest match first
        two: str = self.text(cps, self.pos, self.pos + 2)
        three: str = two
        if self.pos + 2 < len(cps):
            three = self.text(cps, self.pos, self.pos + 3)
        if three == "//=" or three == "**=":
            self.advance(cps)
            self.advance(cps)
            self.advance(cps)
            return Token(TokKind.OP, three, line, col)
        if (
            two == "//" or two == "**" or two == "<<" or two == ">>" or two == "<="
            or two == ">=" or two == "==" or two == "!=" or two == "+=" or two == "-="
            or two == "*=" or two == "/=" or two == "%=" or two == "->" or two == ":="
            or two == "|=" or two == "&=" or two == "^="
        ):
            self.advance(cps)
            self.advance(cps)
            return Token(TokKind.OP, two, line, col)
        self.advance(cps)
        if c == 40 or c == 91 or c == 123:
            self.depth += 1
        elif c == 41 or c == 93 or c == 125:
            self.depth -= 1
        return Token(TokKind.OP, self.text(cps, self.pos - 1, self.pos), line, col)


def src_cps(src: str) -> list[int]:
    # the one-time O(n) materialization every lexer user starts with
    cps: list[int] = []
    for ch in src:
        cps.append(ord(ch))
    return cps


def tokenize(src: str) -> list[Token]:
    lexer: Lexer = Lexer(src, 0, 1, 0, 0)
    cps: list[int] = src_cps(src)
    toks: list[Token] = []
    while True:
        t: Token = lexer.next_token(cps)
        toks.append(t)
        if t.kind == TokKind.END:
            return toks


def hex_val(ch: str) -> int:
    o: int = ord(ch)
    if o >= 48 and o <= 57:
        return o - 48
    if o >= 97 and o <= 102:
        return o - 87
    if o >= 65 and o <= 70:
        return o - 55
    return -1


def unescape(s: str) -> str:
    # Python-compatible escape decoding: \n \t \r \' \\" \\\\ plus
    # \xNN \uNNNN \NNN (octal) and \a \b \f \v - reference parity
    # needs the full table, not just the common subset.
    # The string is materialized ONCE into cps (chr(cps[i]) is O(1);
    # s[i] costs O(i) per access once s holds any multibyte UTF-8),
    # and the output accumulates in a list: `out = out + ch` was
    # O(len^2) - a single 90KB docstring token spent ~30s here.
    cps: list[int] = []
    for ch in s:
        cps.append(ord(ch))
    out: list[str] = []
    i: int = 0
    n: int = len(s)
    while i < n:
        ch: str = chr(cps[i])
        if ch == "\\" and i + 1 < n:
            nxt: str = chr(cps[i + 1])
            if nxt == "n":
                out.append("\n")
                i += 2
            elif nxt == "t":
                out.append("\t")
                i += 2
            elif nxt == "r":
                out.append("\r")
                i += 2
            elif nxt == '"':
                out.append('"')
                i += 2
            elif nxt == "'":
                out.append("'")
                i += 2
            elif nxt == "\\":
                out.append("\\")
                i += 2
            elif nxt == "a":
                out.append(chr(7))
                i += 2
            elif nxt == "b":
                out.append(chr(8))
                i += 2
            elif nxt == "f":
                out.append(chr(12))
                i += 2
            elif nxt == "v":
                out.append(chr(11))
                i += 2
            elif nxt == "x":
                if i + 3 < n and hex_val(chr(cps[i + 2])) >= 0 and hex_val(chr(cps[i + 3])) >= 0:
                    out.append(chr(hex_val(chr(cps[i + 2])) * 16 + hex_val(chr(cps[i + 3]))))
                    i += 4
                else:
                    out.append(ch)
                    i += 1
            elif nxt == "u":
                ok4: bool = True
                val4: int = 0
                j4: int = 2
                while j4 < 6:
                    if i + j4 >= n or hex_val(chr(cps[i + j4])) < 0:
                        ok4 = False
                        break
                    val4 = val4 * 16 + hex_val(chr(cps[i + j4]))
                    j4 += 1
                if ok4:
                    out.append(chr(val4))
                    i += 6
                else:
                    out.append(ch)
                    i += 1
            else:
                o8: int = ord(nxt)
                if o8 >= 48 and o8 <= 55:
                    val8: int = o8 - 48
                    cnt8: int = 1
                    while cnt8 < 3 and i + cnt8 + 1 < n:
                        d8: int = cps[i + cnt8 + 1]
                        if d8 >= 48 and d8 <= 55:
                            val8 = val8 * 8 + (d8 - 48)
                            cnt8 += 1
                        else:
                            break
                    if val8 < 256:
                        out.append(chr(val8))
                        i += cnt8 + 1
                    else:
                        out.append(ch)
                        i += 1
                else:
                    out.append(ch)
                    i += 1
        else:
            out.append(ch)
            i += 1
    return "".join(out)


# ---------- IR output via JValue-free list assembly ----------
# The front end builds Python-tuple IR directly and prints it with
# json.dumps-compatible formatting. A small pretty-printer walks it.


def is_num(text: str) -> bool:
    if len(text) == 0:
        return False
    for i in range(len(text)):
        ch = text[i]
        if not (ch.isdigit() or ch == "." or ch == "e" or ch == "E" or ch == "+" or ch == "-" or ch == "_"):
            return False
    return True


def to_float(text: str) -> float:
    return float(text)


def to_int(text: str) -> int:
    if "." in text or "e" in text or "E" in text:
        return int(float(text))
    if len(text) > 1 and text[0] == "0":
        c: str = text[1]
        if c == "x" or c == "X":
            return int(text, 16)
        if c == "b" or c == "B":
            return int(text, 2)
        if c == "o" or c == "O":
            return int(text, 8)
    return int(text)


def const_num(tok: Token) -> object:
    t: str = tok.text
    # 0x/0b/0o literals are always ints - their digits include e/E
    if len(t) >= 2 and t[0] == "0" and (t[1] == "x" or t[1] == "X" or t[1] == "b" or t[1] == "B" or t[1] == "o" or t[1] == "O"):
        return ["const", to_int(t)]
    if "." in t or "e" in t or "E" in t:
        fv: float = to_float(t)
        # 1e400 overflows to infinity. No plane can carry a non-finite
        # literal: this front end used to write a bare `inf` into the IR
        # JSON and the converter's own parser spun on it forever. Same
        # rejection as the python ast_processor and the Rust front end.
        if fv > 1.7976931348623157e308 or fv < -1.7976931348623157e308:
            print("M4 error line", tok.line, ": float literal out of range:", t)
            raise SystemExit(1)
        return ["const", fv]
    return ["const", to_int(t)]


def fe_const_str(tok: Token) -> object:
    return ["const", unescape(tok.text)]


def const_bytes(tok: Token) -> object:
    return ["const_b", unescape(tok.text)]


class Parser:
    toks: list[Token]
    pos: int

    def cur(self) -> Token:
        return self.toks[self.pos]

    def nxt(self) -> Token:
        t: Token = self.toks[self.pos]
        self.pos += 1
        return t

    def accept(self, text: str) -> bool:
        t: Token = self.cur()
        if (t.kind == TokKind.OP or t.kind == TokKind.KW) and t.text == text:
            self.pos += 1
            return True
        return False

    def expect(self, text: str) -> Token:
        t: Token = self.cur()
        if (t.kind != TokKind.OP and t.kind != TokKind.KW) or t.text != text:
            self.error("expected '" + text + "', got '" + t.text + "'", t)
        return self.nxt()

    def expect_kind(self, kind: TokKind) -> Token:
        t: Token = self.cur()
        if t.kind != kind:
            self.error("expected token kind " + str(kind), t)
        return self.nxt()

    def error(self, msg: str, tok: Token) -> None:
        print("M4 error line", tok.line, ":", msg)
        raise SystemExit(1)

    def at_end(self) -> bool:
        return self.cur().kind == TokKind.END

    def parse_module(self) -> object:
        stmts = []
        while not self.at_end():
            t = self.cur()
            if t.kind == TokKind.NL:
                self.nxt()
                continue
            st = self.parse_stmt()
            if hoist_is_node(st) and dyn_head(st) == "export_stmt":
                stmts.append(["line", dyn_get(st, 1)])
                stmts.append(dyn_get(st, 2))
            else:
                stmts.append(["line", t.line])
                stmts.append(st)
        return ["module", stmts]

    # ------------- statements -------------
    def parse_stmt(self) -> object:
        t = self.cur()
        if t.kind == TokKind.NAME and t.text == "match" and self.stmt_ends_with_colon():
            # soft keyword: 'match' lexes as a NAME; only a statement
            # whose last token is ':' begins a match statement
            return self.parse_match()
        if t.kind == TokKind.OP and t.text == "@":
            # @export decorator: lift the next def to external linkage
            self.nxt()
            dn = self.expect_kind(TokKind.NAME).text
            if dn != "export":
                self.error("only @export is supported", t)
            self.expect_nl()
            nd = self.cur()
            if not (nd.kind == TokKind.KW and nd.text == "def"):
                self.error("@export must decorate a def", nd)
            fdef = self.parse_func_def(True)
            return ["export_stmt", nd.line, fdef]
        if t.kind == TokKind.KW:
            if t.text == "def":
                return self.parse_func_def(False)
            if t.text == "class":
                return self.parse_class_def()
            if t.text == "if":
                return self.parse_if()
            if t.text == "while":
                return self.parse_while()
            if t.text == "for":
                return self.parse_for()
            if t.text == "return":
                return self.parse_return()
            if t.text == "break":
                self.nxt()
                self.expect_nl()
                return ["break"]
            if t.text == "continue":
                self.nxt()
                self.expect_nl()
                return ["continue"]
            if t.text == "pass":
                self.nxt()
                self.expect_nl()
                return ["pass"]
            if t.text == "import" or t.text == "from":
                return self.parse_import()
            if t.text == "raise":
                return self.parse_raise()
            if t.text == "del":
                return self.parse_del()
            if t.text == "assert":
                return self.parse_assert()
        return self.parse_simple_stmt()

    def expect_nl(self) -> None:
        t = self.cur()
        if t.kind == TokKind.NL:
            self.nxt()
        elif t.kind != TokKind.END:
            self.error("expected end of line", t)

    def parse_import(self) -> object:
        # import x[.y][ as a] / from [.]*mod[.mod] import n[ as a][, ...]
        # - unresolved names stay inert; .si resolution happens later
        if self.cur().text == "from":
            self.nxt()
            level: int = 0
            while self.accept("."):
                level += 1
            # plain str + flag: ir2c's inference dislikes object/None
            # reassignment feeding string concatenation
            mod_text: str = ""
            has_module: bool = False
            if self.cur().kind == TokKind.NAME:
                mod_text = self.expect_kind(TokKind.NAME).text
                while self.accept("."):
                    mod_text = mod_text + "." + self.expect_kind(TokKind.NAME).text
                has_module = True
            if has_module and mod_text == "c" and level == 0:
                # from c import fn [as a][, ...]: external C-ABI decls
                self.expect("import")
                pairs_c = []
                while True:
                    cn = self.expect_kind(TokKind.NAME).text
                    ca = cn
                    if self.accept("as"):
                        ca = self.expect_kind(TokKind.NAME).text
                    pairs_c.append([cn, ca])
                    if not self.accept(","):
                        break
                self.expect_nl()
                return ["c_extern", pairs_c]
            self.expect("import")
            pairs = []
            while True:
                n = self.expect_kind(TokKind.NAME).text
                asn2 = None
                if self.accept("as"):
                    asn2 = self.expect_kind(TokKind.NAME).text
                pairs.append([n, asn2])
                if not self.accept(","):
                    break
            self.expect_nl()
            if has_module:
                return ["from_import", mod_text, pairs, level]
            return ["from_import", None, pairs, level]
        self.expect("import")
        pairs = []
        while True:
            n = self.expect_kind(TokKind.NAME).text
            while self.accept("."):
                n = n + "." + self.expect_kind(TokKind.NAME).text
            asn = None
            if self.accept("as"):
                asn = self.expect_kind(TokKind.NAME).text
            pairs.append([n, asn])
            if not self.accept(","):
                break
        self.expect_nl()
        return ["import", pairs]

    def parse_func_def(self, exported: bool) -> object:
        self.expect("def")
        name = self.expect_kind(TokKind.NAME).text
        self.expect("(")
        params = []
        annos = []
        while not (self.cur().kind == TokKind.OP and self.cur().text == ")"):
            self.reject_param_default()
            pname = self.expect_kind(TokKind.NAME).text
            params.append(pname)
            annos.append(None)
            if self.accept(":"):
                annos[-1] = self.parse_annotation()
            self.reject_param_default()
            if not self.accept(","):
                break
        self.expect(")")
        ret_anno = None
        if self.accept("->"):
            ret_anno = self.parse_annotation()
        self.expect(":")
        body = self.parse_block()
        if exported:
            return ["func_def", name, params, body, annos, ret_anno, "export"]
        return ["func_def", name, params, body, annos, ret_anno]

    def reject_param_default(self) -> None:
        # `= value`, `*args`, `**kwargs`: every parameter is required.
        # Silu has no defaults; the reference front end names it the
        # same way (this parser used to answer "expected ')', got '='"
        # or "expected token kind 0")
        t = self.cur()
        if t.kind == TokKind.OP and (t.text == "=" or t.text == "*" or t.text == "**"):
            self.error("default parameter values are not part of Silu (every parameter is required)", t)

    def parse_annotation(self) -> object:
        # simple annotations: Name / Name[Name] / None
        t = self.cur()
        if t.kind == TokKind.KW and t.text == "None":
            self.nxt()
            return ["const", None]
        name = self.expect_kind(TokKind.NAME).text
        if self.accept("["):
            inner = [self.parse_annotation()]
            while self.accept(","):
                inner.append(self.parse_annotation())
            self.expect("]")
            return ["subscript", ["name", name], inner[0] if len(inner) == 1 else ["tuple", inner]]
        return ["name", name]

    def parse_class_def(self) -> object:
        self.expect("class")
        name = self.expect_kind(TokKind.NAME).text
        bases = []
        if self.accept("("):
            while not (self.cur().kind == TokKind.OP and self.cur().text == ")"):
                bases.append(self.expect_kind(TokKind.NAME).text)
                if not self.accept(","):
                    break
            self.expect(")")
        self.expect(":")
        body = self.parse_block()
        # enum: exactly one base named Enum
        if len(bases) == 1 and bases[0] == "Enum":
            members = []
            for stmt in body:
                if stmt is None:
                    continue
                if stmt[0] == "line":
                    continue
                if stmt[0] == "assign" and isinstance(stmt[1], str):
                    members.append([stmt[1], stmt[2]])
                elif stmt[0] == "name":
                    members.append([stmt[1], None])
            return ["enum_def", name, members]
        if bases:
            self.error("inheritance not supported", self.cur())
        return ["class_def", name, (), body]

    def parse_block(self) -> object:
        # expect NL, INDENT, stmt+, DEDENT (DEDENT handled by caller via
        # matching indentation; we approximate by consuming statements
        # until dedent token - simplified: parse until a NL with lower
        # indentation is seen, but this lexer has no indentation tokens.
        # Simplified: rely on parse_stmt stopping at block end via the
        # fact that the caller checks indentation - here we just consume
        # until an END/DEDENT-like condition.
        self.expect_nl()
        stmts = []
        # Simplified block parsing: read until indentation decreases below
        # the block's opening level. We track the column of the block's
        # first statement; every statement at a smaller column ends it.
        base_col = None
        while not self.at_end():
            t = self.cur()
            if t.kind == TokKind.NL:
                self.nxt()
                continue
            if base_col is None:
                base_col = t.col
            if t.col < base_col:
                break
            st = self.parse_stmt()
            if hoist_is_node(st) and dyn_head(st) == "export_stmt":
                stmts.append(["line", dyn_get(st, 1)])
                stmts.append(dyn_get(st, 2))
            else:
                stmts.append(["line", t.line])
                stmts.append(st)
        return stmts

    def parse_if(self) -> object:
        # if/elif*/else? - elif chains nest as if-in-orelse. An arm only
        # claims an elif/else at its own indentation level; a deeper
        # else belongs to an inner chain this arm's block stopped at.
        if_col = self.cur().col
        self.expect("if")
        test = self.parse_expr_nt()
        self.expect(":")
        body = self.parse_block()
        orelse = []
        t = self.cur()
        if t.kind == TokKind.KW and t.text == "elif" and t.col == if_col:
            arm_line = t.line
            self.nxt()
            inner = self.parse_if_tail(if_col)
            orelse = [["line", arm_line], inner]
        elif t.kind == TokKind.KW and t.text == "else" and t.col == if_col:
            self.nxt()
            self.expect(":")
            orelse = self.parse_block()
        return ["if", test, body, orelse]

    def parse_if_tail(self, if_col: int) -> object:
        # one elif arm: condition ':' block, then any further
        # elif/else continues the chain in its orelse
        test = self.parse_expr_nt()
        self.expect(":")
        body = self.parse_block()
        orelse = []
        t = self.cur()
        if t.kind == TokKind.KW and t.text == "elif" and t.col == if_col:
            arm_line = t.line
            self.nxt()
            orelse = [["line", arm_line], self.parse_if_tail(if_col)]
        elif t.kind == TokKind.KW and t.text == "else" and t.col == if_col:
            self.nxt()
            self.expect(":")
            orelse = self.parse_block()
        return ["if", test, body, orelse]

    def reject_loop_else(self, head: Token, what: str) -> None:
        # `else` at the loop's own column belongs to the loop. Silu has
        # no loop else; the reference front end names it the same way.
        # (An `else` further left is the partner of an enclosing `if`.)
        t = self.cur()
        if t.kind == TokKind.KW and t.text == "else" and t.col == head.col:
            self.error("'else' on a " + what + " loop is not part of Silu", t)

    def parse_while(self) -> object:
        head_w = self.cur()
        self.expect("while")
        test = self.parse_expr_nt()
        self.expect(":")
        body = self.parse_block()
        self.reject_loop_else(head_w, "while")
        return ["while", test, body]

    def parse_for(self) -> object:
        head_f = self.cur()
        self.expect("for")
        first = self.expect_kind(TokKind.NAME).text
        target = ["name", first]
        if self.cur().kind == TokKind.OP and self.cur().text == ",":
            names = [first]
            while self.cur().kind == TokKind.OP and self.cur().text == ",":
                self.nxt()
                names.append(self.expect_kind(TokKind.NAME).text)
            target = ["tuple_unpack", names]
        self.expect("in")
        iter_expr = self.parse_expr()
        self.expect(":")
        body = self.parse_block()
        self.reject_loop_else(head_f, "for")
        return ["for", target, iter_expr, body, []]

    def parse_comp_target(self) -> object:
        # comprehension target: one name, or `a, b` / `(a, b)`. The
        # two-name forms emit ["tuple", [names]] exactly like the
        # Python frontend - which used to be the only one accepting
        # them (this parser answered "expected 'in', got ','").
        paren: bool = self.cur().kind == TokKind.OP and self.cur().text == "("
        if paren:
            self.nxt()
        names = [["name", self.expect_kind(TokKind.NAME).text]]
        while self.cur().kind == TokKind.OP and self.cur().text == ",":
            self.nxt()
            if paren and self.cur().text == ")":
                break
            names.append(["name", self.expect_kind(TokKind.NAME).text])
        if paren:
            self.expect(")")
        if len(names) == 1:
            return names[0]
        return ["tuple", names]

    def stmt_ends_with_colon(self) -> bool:
        # the lexer swallows newlines inside brackets, so the first NL
        # after pos ends this statement; a match statement's last token
        # is ':' (match (x): is a match stmt, match(x) is a call)
        i: int = self.pos
        last: Token = self.toks[self.pos]
        while i < len(self.toks):
            tk: Token = self.toks[i]
            if tk.kind == TokKind.NL or tk.kind == TokKind.END:
                break
            last = tk
            i += 1
        return last.kind == TokKind.OP and last.text == ":"

    def parse_match(self) -> object:
        t0: Token = self.cur()
        if not (t0.kind == TokKind.NAME and t0.text == "match"):
            self.error("expected 'match'", t0)
        self.nxt()
        subject = self.parse_expr_nt()
        self.expect(":")
        self.expect_nl()
        cases = []
        base_col = None
        while not self.at_end():
            t = self.cur()
            if t.kind == TokKind.NL:
                self.nxt()
                continue
            if t.kind != TokKind.NAME or t.text != "case":
                break
            if base_col is None:
                base_col = t.col
            if t.col < base_col:
                break
            self.nxt()
            pattern = self.parse_pattern()
            guard = None
            if self.accept("if"):
                guard = self.parse_expr_nt()
            self.expect(":")
            body = self.parse_block()
            cases.append(["match_case", pattern, guard, body])
        return ["match", subject, cases]

    def parse_fstring(self, raw: str) -> object:
        # desugar f".." exactly like the reference front end: one
        # fmt(...) call - literal parts ({{ }} unescaped) as const
        # strings, {expr} parts re-lexed and parsed as expressions.
        # cps + append/join for the same O(1)-per-char reason as unescape.
        cps: list[int] = []
        for c0 in raw:
            cps.append(ord(c0))
        parts = []
        lit: list[str] = []
        i: int = 0
        n: int = len(raw)
        while i < n:
            ch: str = chr(cps[i])
            if ch == "{" and i + 1 < n and chr(cps[i + 1]) == "{":
                lit.append("{")
                i += 2
            elif ch == "}" and i + 1 < n and chr(cps[i + 1]) == "}":
                lit.append("}")
                i += 2
            elif ch == "{":
                if "".join(lit) != "":
                    parts.append(["const", unescape("".join(lit))])
                    lit = []
                j: int = i + 1
                while j < n and chr(cps[j]) != "}":
                    j += 1
                expr_buf: list[str] = []
                k: int = i + 1
                while k < j:
                    expr_buf.append(chr(cps[k]))
                    k += 1
                expr_src: str = "".join(expr_buf)
                sub_lexer: Lexer = Lexer(expr_src, 0, 1, 0, 0)
                sub_cps: list[int] = src_cps(expr_src)
                sub_toks: list[Token] = []
                while True:
                    st: Token = sub_lexer.next_token(sub_cps)
                    sub_toks.append(st)
                    if st.kind == TokKind.END:
                        break
                sub_parser: Parser = Parser(sub_toks, 0)
                parts.append(sub_parser.parse_expr())
                i = j + 1
            else:
                lit.append(ch)
                i += 1
        if "".join(lit) != "":
            parts.append(["const", unescape("".join(lit))])
        if len(parts) == 0:
            return ["const", ""]
        return ["call", ["name", "fmt"], parts, []]

    def parse_pattern(self) -> object:
        t = self.cur()
        # "_" lexes as a NAME, not a keyword
        if t.kind == TokKind.NAME and t.text == "_":
            self.nxt()
            return ["match_as", None, None]
        if t.kind == TokKind.NUM:
            self.nxt()
            return ["match_value", const_num(t)]
        if t.kind == TokKind.STR:
            self.nxt()
            return ["match_value", fe_const_str(t)]
        if t.kind == TokKind.NAME:
            self.nxt()
            # Enum.Member value pattern
            if self.cur().kind == TokKind.OP and self.cur().text == ".":
                self.nxt()
                member = self.expect_kind(TokKind.NAME).text
                return ["match_value", ["attribute", ["name", t.text], member]]
            # class pattern C(p, ...) / C(k=p): positional captures
            # bind fields in declaration order, keywords by field name
            if self.cur().kind == TokKind.OP and self.cur().text == "(":
                self.nxt()
                pats = []
                kattrs = []
                kpats = []
                while not (self.cur().kind == TokKind.OP and self.cur().text == ")"):
                    if (
                        self.cur().kind == TokKind.NAME
                        and self.toks[self.pos + 1].kind == TokKind.OP
                        and self.toks[self.pos + 1].text == "="
                    ):
                        kn = self.nxt().text
                        self.nxt()
                        kattrs.append(kn)
                        kpats.append(self.parse_pattern())
                    else:
                        pats.append(self.parse_pattern())
                    if not self.accept(","):
                        break
                self.expect(")")
                return ["match_class", ["name", t.text], pats, kattrs, kpats]
            return ["match_as", None, t.text]
        self.error("unsupported pattern", t)

    def parse_return(self) -> object:
        self.expect("return")
        if self.cur().kind == TokKind.NL:
            self.expect_nl()
            return ["return", None]
        value = self.parse_expr()
        self.expect_nl()
        return ["return", value]

    def parse_raise(self) -> object:
        self.expect("raise")
        value = self.parse_expr()
        self.expect_nl()
        return ["raise", value]

    def parse_del(self) -> object:
        self.expect("del")
        target = self.parse_expr()
        self.expect_nl()
        # del obj[key] flattens to (obj, key) like the reference IR
        if hoist_is_node(target) and dyn_head(target) == "subscript":
            return ["delete", dyn_get(target, 1), dyn_get(target, 2)]
        return ["delete", target]

    def parse_assert(self) -> object:
        self.expect("assert")
        test = self.parse_expr_nt()
        msg = None
        if self.accept(","):
            msg = self.parse_expr_nt()
        self.expect_nl()
        return ["assert", test, msg]

    # ------------- simple statements / assignment / expr -------------
    def parse_simple_stmt(self) -> object:
        # annotated assignment: NAME ':' anno ['=' expr] - the annotation
        # grammar is unambiguous enough to detect from two tokens
        t = self.cur()
        if (
            t.kind == TokKind.NAME
            and self.toks[self.pos + 1].kind == TokKind.OP
            and self.toks[self.pos + 1].text == ":"
            and t.text not in ("match", "case")
        ):
            name = self.nxt().text
            self.nxt()  # ':'
            anno = self.parse_annotation()
            value = None
            if self.accept("="):
                value = self.parse_expr()
            self.expect_nl()
            return ["ann_assign", name, value, anno]
        expr = self.parse_expr()
        t = self.cur()
        if t.kind == TokKind.OP and t.text in ("=", "+=", "-=", "*=", "/=", "//=", "%="):
            self.nxt()
            value = self.parse_expr()
            chained: bool = False
            chain_targets = []
            while (
                self.cur().kind == TokKind.OP
                and self.cur().text == "="
                and hoist_is_node(value)
                and dyn_head(value) == "name"
            ):
                # a = b = ... = v rolls into one multi_assign like the
                # reference front end (one assign per target, same value)
                if not chained:
                    chained = True
                    chain_targets = [expr, value]
                else:
                    chain_targets.append(value)
                self.nxt()
                value = self.parse_expr()
                if not (hoist_is_node(value) and dyn_head(value) == "name"):
                    break
            if chained:
                stmts = []
                for ct in chain_targets:
                    stmts.append(["assign", dyn_get(ct, 1), value, None])
                self.expect_nl()
                return ["multi_assign", stmts]
            self.expect_nl()
            op_map = {"=": None, "+=": "+", "-=": "-", "*=": "*", "/=": "/", "//=": "//", "%=": "%"}
            op = op_map[t.text]
            target = expr
            if target[0] == "name":
                if op is None:
                    return ["assign", target[1], value, None]
                return ["aug_assign", target, t.text, value]
            if target[0] == "subscript":
                if op is None:
                    return ["subscript_assign", target[1], target[2], value]
                # reference front end folds this into aug_assign with a
                # subscript target (its subscript_aug_assign branch never
                # fires for source-level obj[key] += ...)
                return ["aug_assign", target, t.text, value]
            if target[0] == "attribute":
                if op is None:
                    return ["assign", target, value, None]
                return ["attribute_aug_assign", target[1], target[2], t.text, value]
            if target[0] == "tuple":
                names = [item[1] for item in target[1] if item[0] == "name"]
                return ["tuple_assign", names, value]
            self.error("unsupported assignment target", t)
        self.expect_nl()
        # expression statement: the expression node IS the statement
        return expr

    # ------------- expressions -------------
    def parse_expr(self) -> object:
        # bare tuple expression: lowest precedence; statement contexts
        # only - bracketed contexts (call args, subscripts, lambda
        # bodies) parse the no-tuple variant and own their commas
        value = self.parse_expr_nt()
        t = self.cur()
        if t.kind == TokKind.OP and t.text == ",":
            items = [value]
            while self.accept(","):
                t2 = self.cur()
                if t2.kind == TokKind.NL or t2.kind == TokKind.END:
                    break
                if t2.kind == TokKind.OP and t2.text == "=":
                    # single-target unpacking: obj_arg, = func.args
                    break
                items.append(self.parse_expr_nt())
            return ["tuple", items]
        return value

    def parse_expr_nt(self) -> object:
        # conditional expression: THEN if COND else ELSE (no tuple)
        value = self.parse_or()
        t = self.cur()
        if t.kind == TokKind.KW and t.text == "if":
            self.nxt()
            cond = self.parse_or()
            t2 = self.cur()
            if not (t2.kind == TokKind.KW and t2.text == "else"):
                self.error("expected 'else' in conditional expression", t2)
            self.nxt()
            else_val = self.parse_expr_nt()
            return ["if_expr", cond, value, else_val]
        return value

    def parse_or(self) -> object:
        # and/or fold into one n-ary node, like the reference IR
        left = self.parse_and()
        parts = [left]
        while self.accept("or"):
            parts.append(self.parse_and())
        if len(parts) == 1:
            return left
        return ["or"] + parts

    def parse_and(self) -> object:
        left = self.parse_not()
        parts = [left]
        while self.accept("and"):
            parts.append(self.parse_not())
        if len(parts) == 1:
            return left
        return ["and"] + parts

    def parse_not(self) -> object:
        if self.accept("not"):
            return ["not", self.parse_not()]
        return self.parse_compare()

    def parse_compare(self) -> object:
        left = self.parse_bitor()
        t = self.cur()
        if t.kind == TokKind.OP and t.text in ("==", "!=", "<", "<=", ">", ">="):
            self.nxt()
            right = self.parse_bitor()
            t2 = self.cur()
            if t2.kind == TokKind.OP and t2.text in ("==", "!=", "<", "<=", ">", ">="):
                # chained comparison: a <= b <= c rolls forward, the
                # shared operand repeated per pair like the reference IR
                pairs = [[t.text, left, right]]
                while True:
                    t3 = self.cur()
                    if t3.kind == TokKind.OP and t3.text in ("==", "!=", "<", "<=", ">", ">="):
                        self.nxt()
                        nxt2 = self.parse_bitor()
                        pairs.append([t3.text, right, nxt2])
                        right = nxt2
                    else:
                        break
                return ["chained_compare", pairs]
            return [t.text, left, right]
        if t.kind == TokKind.KW and t.text == "is":
            self.nxt()
            if self.accept("not"):
                return ["is not", left, self.parse_bitor()]
            return ["is", left, self.parse_bitor()]
        if t.kind == TokKind.KW and t.text == "in":
            self.nxt()
            right = self.parse_bitor()
            return ["in", left, right]
        if t.kind == TokKind.KW and t.text == "not":
            self.nxt()
            self.expect("in")
            return ["not in", left, self.parse_bitor()]
        return left

    def parse_bitor(self) -> object:
        left = self.parse_bitxor()
        while self.accept("|"):
            left = ["|", left, self.parse_bitxor()]
        return left

    def parse_bitxor(self) -> object:
        left = self.parse_bitand()
        while self.accept("^"):
            left = ["^", left, self.parse_bitand()]
        return left

    def parse_bitand(self) -> object:
        left = self.parse_shift()
        while self.accept("&"):
            left = ["&", left, self.parse_shift()]
        return left

    def parse_shift(self) -> object:
        left = self.parse_add()
        while self.cur().kind == TokKind.OP and (
            self.cur().text == "<<" or self.cur().text == ">>"
        ):
            op = self.nxt().text
            left = [op, left, self.parse_add()]
        return left

    def parse_add(self) -> object:
        left = self.parse_mul()
        while self.cur().kind == TokKind.OP and (
            self.cur().text == "+" or self.cur().text == "-"
        ):
            op = self.nxt().text
            left = [op, left, self.parse_mul()]
        return left

    def parse_mul(self) -> object:
        left = self.parse_pow()
        while self.cur().kind == TokKind.OP and self.cur().text in (
            "*", "/", "//", "%"
        ):
            op = self.nxt().text
            left = [op, left, self.parse_pow()]
        return left

    def parse_pow(self) -> object:
        base = self.parse_unary()
        if self.accept("**"):
            return ["**", base, self.parse_pow()]
        return base

    def parse_unary(self) -> object:
        t = self.cur()
        # kind check matters: a STR token's text may be "+" or "-"
        if t.kind == TokKind.OP and t.text == "-":
            if (
                self.toks[self.pos + 1].kind == TokKind.NUM
                and self.toks[self.pos + 1].text == "9223372036854775808"
            ):
                # fold ONLY the pathological literal (mirrors
                # ast_processor.visit_UnaryOp): +2^63 overflows i64,
                # every other -literal keeps the ["-", const] shape
                self.nxt()
                self.nxt()
                return ["const", to_int("-9223372036854775808")]
            self.nxt()
            return ["-", self.parse_unary()]
        if t.kind == TokKind.OP and t.text == "+":
            self.nxt()
            return ["+", self.parse_unary()]
        if t.kind == TokKind.OP and t.text == "~":
            self.nxt()
            return ["~", self.parse_unary()]
        return self.parse_postfix()

    def parse_postfix(self) -> object:
        node = self.parse_atom()
        while True:
            if self.accept("("):
                args = []
                kwargs = []
                while not (self.cur().kind == TokKind.OP and self.cur().text == ")"):
                    if self.cur().kind == TokKind.NAME and self.toks[self.pos + 1].text == "=":
                        k = self.nxt().text
                        self.expect("=")
                        kwargs.append((k, self.parse_expr_nt()))
                    else:
                        args.append(self.parse_expr_nt())
                    if not self.accept(","):
                        break
                self.expect(")")
                node = ["call", node, args, kwargs]
            elif self.accept("["):
                if self.accept(":"):
                    # no leading expression: [:hi], [:hi:step], [:]
                    lo = None
                    hi = None
                    step = None
                    if self.cur().text != ":" and self.cur().text != "]":
                        hi = self.parse_expr_nt()
                    if self.accept(":"):
                        if self.cur().text != "]":
                            step = self.parse_expr_nt()
                    self.expect("]")
                    node = ["subscript", node, ["slice", lo, hi, step]]
                else:
                    index = self.parse_expr_nt()
                    if self.cur().kind == TokKind.OP and self.cur().text == ",":
                        # tuple subscript key: d[a, b]
                        kitems = [index]
                        while self.accept(","):
                            if self.cur().text == "]":
                                break
                            kitems.append(self.parse_expr_nt())
                        index = ["tuple", kitems]
                    if self.accept(":"):
                        lo2 = index
                        hi2 = None
                        step2 = None
                        if self.cur().text != ":" and self.cur().text != "]":
                            hi2 = self.parse_expr_nt()
                        if self.accept(":"):
                            if self.cur().text != "]":
                                step2 = self.parse_expr_nt()
                        self.expect("]")
                        node = ["subscript", node, ["slice", lo2, hi2, step2]]
                    else:
                        self.expect("]")
                        node = ["subscript", node, index]
            elif self.accept("."):
                attr = self.expect_kind(TokKind.NAME).text
                node = ["attribute", node, attr]
            else:
                return node

    def parse_atom(self) -> object:
        t = self.cur()
        if t.kind == TokKind.NUM:
            self.nxt()
            return const_num(t)
        if t.kind == TokKind.STR:
            self.nxt()
            return fe_const_str(t)
        if t.kind == TokKind.BYTES:
            self.nxt()
            return const_bytes(t)
        if t.kind == TokKind.FSTR:
            self.nxt()
            return self.parse_fstring(t.text)
        if t.kind == TokKind.NAME:
            self.nxt()
            return ["name", t.text]
        if t.kind == TokKind.KW:
            if t.text == "lambda":
                self.nxt()
                lparams: list[str] = []
                self.reject_param_default()
                lparams.append(self.expect_kind(TokKind.NAME).text)
                while self.cur().kind == TokKind.OP and self.cur().text == ",":
                    self.nxt()
                    self.reject_param_default()
                    lparams.append(self.expect_kind(TokKind.NAME).text)
                self.reject_param_default()
                self.expect(":")
                lbody = self.parse_expr_nt()
                return ["lambda", lparams, lbody]
            if t.text == "None":
                self.nxt()
                return ["const", None]
            if t.text == "True":
                self.nxt()
                return ["const", True]
            if t.text == "False":
                self.nxt()
                return ["const", False]
        if self.accept("("):
            if self.accept(")"):
                return ["tuple", ()]
            first = self.parse_expr_nt()
            if self.accept(","):
                # trailing comma allowed anywhere: (a,), (a, b,), ...
                items = [first]
                while True:
                    if self.cur().text == ")":
                        break
                    items.append(self.parse_expr_nt())
                    if not self.accept(","):
                        break
                self.expect(")")
                return ["tuple", items]
            self.expect(")")
            return first
        if self.accept("["):
            items = []
            if self.cur().text != "]":
                items.append(self.parse_expr_nt())
                # list comprehension: [elt for target in iter (if cond)*]
                t = self.cur()
                if t.kind == TokKind.KW and t.text == "for":
                    self.nxt()
                    target = self.parse_comp_target()
                    self.expect("in")
                    # iter and filters stop below the conditional-expression
                    # layer: a bare `if` here belongs to the comprehension
                    iter_expr = self.parse_or()
                    conds = []
                    while True:
                        t2 = self.cur()
                        if t2.kind == TokKind.KW and t2.text == "if":
                            self.nxt()
                            conds.append(self.parse_or())
                        else:
                            break
                    self.expect("]")
                    return ["list_comp", items[0],
                            [[target, iter_expr, conds]]]
                while self.accept(","):
                    if self.cur().text == "]":
                        break
                    items.append(self.parse_expr_nt())
            self.expect("]")
            return ["list", items]
        if self.accept("{"):
            items = []
            if self.cur().text == "}":
                # {} is always the empty dict, never a set
                self.nxt()
                return ["dict", []]
            k = self.parse_expr_nt()
            if self.cur().kind == TokKind.OP and self.cur().text == ":":
                self.nxt()
                v = self.parse_expr_nt()
                # dict comprehension: {k: v for t in iter (if c)*}
                if self.cur().kind == TokKind.KW and self.cur().text == "for":
                    self.nxt()
                    target = self.parse_comp_target()
                    self.expect("in")
                    iter_expr = self.parse_or()
                    conds = []
                    while True:
                        t3 = self.cur()
                        if t3.kind == TokKind.KW and t3.text == "if":
                            self.nxt()
                            conds.append(self.parse_or())
                        else:
                            break
                    self.expect("}")
                    return ["dict_comp", [k, v],
                            [[target, iter_expr, conds]]]
                items.append((k, v))
                while self.accept(","):
                    if self.cur().text == "}":
                        break
                    k = self.parse_expr_nt()
                    self.expect(":")
                    v = self.parse_expr_nt()
                    items.append((k, v))
                self.expect("}")
                return ["dict", items]
            # set comprehension: {e for t in iter (if c)*}
            if self.cur().kind == TokKind.KW and self.cur().text == "for":
                self.nxt()
                target = self.parse_comp_target()
                self.expect("in")
                iter_expr = self.parse_or()
                conds = []
                while True:
                    t4 = self.cur()
                    if t4.kind == TokKind.KW and t4.text == "if":
                        self.nxt()
                        conds.append(self.parse_or())
                    else:
                        break
                self.expect("}")
                return ["set_comp", k,
                        [[target, iter_expr, conds]]]
            # set literal: {e, e, ...}
            items.append(k)
            while self.accept(","):
                if self.cur().text == "}":
                    break
                items.append(self.parse_expr_nt())
            self.expect("}")
            return ["set", items]
        self.error("unexpected token '" + t.text + "'", t)


# ---------- nested def / lambda hoisting (Rust nested-item) ----------
# Mirrors silu/nested_hoist.py: same mangling, same self-prepend rules,
# same funcref emission. Written only with the dynamic primitives the
# typed backend supports: isinstance / enumerate / append / == / is None.


class HG:
    prefix: str
    cls_name: str
    is_method: bool
    ren_src: list[str]
    ren_dst: list[str]
    counter: int
    globals: list[str]
    locals: object


# ---------- cross-file import expansion (Rust mod shape) ----------
# import foo: foo.si next to the source is parsed, its own imports
# expanded, and its top-level statements spliced in at the import
# position; foo.X references rewrite to the plain name X afterwards.
# Each file is inlined once; a cycle or a missing module that shadows
# no builtin aborts with a message. Unresolvable names (os, sys, ...)
# keep their import node untouched.


def fe_drop_tail(xs: object) -> object:
    out = []
    n: object = dyn_len(xs)
    for i, x in enumerate(xs):
        if i + 1 < n:
            out.append(x)
    return out


def fe_collect_exports(stmts: object) -> object:
    out = []
    for i, st in enumerate(stmts):
        if hoist_is_node(st):
            op: object = dyn_head(st)
            if op == "func_def" or op == "class_def":
                out.append(dyn_get(st, 1))
            elif op == "assign" or op == "ann_assign":
                if isinstance(dyn_get(st, 1), str):
                    out.append(dyn_get(st, 1))
    return out


def fe_expand_imports(mod: object, seen: list[str], stack: list[str], alias_names: list[str], alias_exports: object) -> object:
    stmts = dyn_get(mod, 1)
    out = []
    for i, st in enumerate(stmts):
        if hoist_is_node(st) and dyn_head(st) == "import":
            pairs = dyn_get(st, 1)
            kept = []
            dropped: bool = False
            for j, pr in enumerate(pairs):
                nm: object = dyn_get(pr, 0)
                path: str = nm + ".si"
                if file_exists(path):
                    if not dropped:
                        dropped = True
                        if dyn_len(out) > 0 and hoist_is_node(dyn_get(out, dyn_len(out) - 1)) and dyn_head(dyn_get(out, dyn_len(out) - 1)) == "line":
                            out = fe_drop_tail(out)
                    if hg_in_list(stack, path):
                        print("M4 import error: import cycle through '" + path + "'")
                        raise SystemExit(1)
                    if not hg_in_list(seen, path):
                        seen.append(path)
                        stack.append(path)
                        sub_src: str = read_file(path)
                        sub_parser: Parser = Parser(tokenize(sub_src), 0)
                        sub_mod = sub_parser.parse_module()
                        sub_mod = fe_expand_imports(sub_mod, seen, stack, alias_names, alias_exports)
                        stack = fe_drop_tail(stack)
                        for k, sst in enumerate(dyn_get(sub_mod, 1)):
                            out.append(sst)
                        sub_exports = fe_collect_exports(dyn_get(sub_mod, 1))
                        ai: int = fe_alias_index(alias_names, nm)
                        if ai < 0:
                            alias_names.append(nm)
                            alias_exports.append(sub_exports)
                        else:
                            for m, en in enumerate(sub_exports):
                                if not hg_in_list(dyn_get(alias_exports, ai), en):
                                    dyn_get(alias_exports, ai).append(en)
                    asn: object = dyn_get(pr, 1)
                    if asn is not None and asn != nm:
                        fe_register_alias(asn, nm, alias_names, alias_exports)
                else:
                    kept.append(pr)
            if dyn_len(kept) > 0:
                out.append(["import", kept])
        elif hoist_is_node(st) and dyn_head(st) == "from_import":
            fmod: object = dyn_get(st, 1)
            flevel: object = dyn_get(st, 3)
            if fmod is None or flevel != 0 or "." in str(fmod):
                out.append(st)
                continue
            fpath: str = fmod + ".si"
            if file_exists(fpath):
                if dyn_len(out) > 0 and hoist_is_node(dyn_get(out, dyn_len(out) - 1)) and dyn_head(dyn_get(out, dyn_len(out) - 1)) == "line":
                    out = fe_drop_tail(out)
                if hg_in_list(stack, fpath):
                    print("M4 import error: import cycle through '" + fpath + "'")
                    raise SystemExit(1)
                if not hg_in_list(seen, fpath):
                    seen.append(fpath)
                    stack.append(fpath)
                    fsrc: str = read_file(fpath)
                    fparser: Parser = Parser(tokenize(fsrc), 0)
                    fmod_ir = fparser.parse_module()
                    fmod_ir = fe_expand_imports(fmod_ir, seen, stack, alias_names, alias_exports)
                    stack = fe_drop_tail(stack)
                    for k2, fst in enumerate(dyn_get(fmod_ir, 1)):
                        out.append(fst)
                    fexports = fe_collect_exports(dyn_get(fmod_ir, 1))
                    fai: int = fe_alias_index(alias_names, fmod)
                    if fai < 0:
                        alias_names.append(fmod)
                        alias_exports.append(fexports)
                    else:
                        for m2, en2 in enumerate(fexports):
                            if not hg_in_list(dyn_get(alias_exports, fai), en2):
                                dyn_get(alias_exports, fai).append(en2)
            else:
                out.append(st)
        else:
            out.append(st)
    mod2 = ["module", out]
    mod2 = fe_hoist_nested(mod2, seen, stack, alias_names, alias_exports)
    return mod2


# ---------- nested (in-body) import hoisting ----------
# Imports inside function/class/branch bodies resolve at expansion
# time exactly like top-level ones: the module splices at module level
# before the enclosing top-level statement, and the in-body import
# node becomes a pass. Mirrors importer._hoist_nested_imports.


def fe_copy_str_list(xs: object) -> list[str]:
    out: list[str] = []
    for i, x in enumerate(xs):
        out.append(x)
    return out


def fe_load_splice(path: str, nm: str, seen: list[str], stack: list[str], alias_names: list[str], alias_exports: object) -> object:
    # load path's module once (seen is shared), expand it against a
    # COPY of the ancestor stack, and return its top-level statements
    stmts = []
    if hg_in_list(stack, path):
        print("M4 import error: import cycle through '" + path + "'")
        raise SystemExit(1)
    if not hg_in_list(seen, path):
        seen.append(path)
        nstack: list[str] = fe_copy_str_list(stack)
        nstack.append(path)
        src: str = read_file(path)
        parser: Parser = Parser(tokenize(src), 0)
        sub = parser.parse_module()
        sub = fe_expand_imports(sub, seen, nstack, alias_names, alias_exports)
        for k, s in enumerate(dyn_get(sub, 1)):
            stmts.append(s)
        exports = fe_collect_exports(dyn_get(sub, 1))
        ai: int = fe_alias_index(alias_names, nm)
        if ai < 0:
            alias_names.append(nm)
            alias_exports.append(exports)
        else:
            for m, en in enumerate(exports):
                if not hg_in_list(dyn_get(alias_exports, ai), en):
                    dyn_get(alias_exports, ai).append(en)
    return stmts


def fe_collect_imports_list(stmts: object, found: object) -> None:
    for i, st in enumerate(stmts):
        if hoist_is_node(st):
            op: object = dyn_head(st)
            if op == "import" or op == "from_import":
                found.append(st)
            else:
                fe_collect_imports_into(st, found)


def fe_collect_imports_into(st: object, found: object) -> None:
    if not hoist_is_node(st):
        return
    op: object = dyn_head(st)
    if op == "func_def" or op == "class_def":
        fe_collect_imports_list(dyn_get(st, 3), found)
    elif op == "if":
        fe_collect_imports_list(dyn_get(st, 2), found)
        fe_collect_imports_list(dyn_get(st, 3), found)
    elif op == "while":
        fe_collect_imports_list(dyn_get(st, 2), found)
    elif op == "for":
        fe_collect_imports_list(dyn_get(st, 3), found)
    elif op == "match":
        cases = dyn_get(st, 2)
        for k, cs in enumerate(cases):
            fe_collect_imports_list(dyn_get(cs, 3), found)


def fe_node_in_list(xs: object, node: object) -> bool:
    for i, x in enumerate(xs):
        if x == node:
            return True
    return False


def fe_subst_pass_list(stmts: object, consumed: object) -> object:
    out = []
    for i, st in enumerate(stmts):
        out.append(fe_subst_pass_stmt(st, consumed))
    return out


def fe_subst_pass_stmt(st: object, consumed: object) -> object:
    if not hoist_is_node(st):
        return st
    op: object = dyn_head(st)
    if op == "import" or op == "from_import":
        if fe_node_in_list(consumed, st):
            return ["pass"]
        return st
    if op == "func_def":
        if dyn_len(st) > 6:
            return ["func_def", dyn_get(st, 1), dyn_get(st, 2), fe_subst_pass_list(dyn_get(st, 3), consumed), dyn_get(st, 4), dyn_get(st, 5), dyn_get(st, 6)]
        return ["func_def", dyn_get(st, 1), dyn_get(st, 2), fe_subst_pass_list(dyn_get(st, 3), consumed), dyn_get(st, 4), dyn_get(st, 5)]
    if op == "class_def":
        return ["class_def", dyn_get(st, 1), dyn_get(st, 2), fe_subst_pass_list(dyn_get(st, 3), consumed)]
    if op == "if":
        return ["if", dyn_get(st, 1), fe_subst_pass_list(dyn_get(st, 2), consumed), fe_subst_pass_list(dyn_get(st, 3), consumed)]
    if op == "while":
        return ["while", dyn_get(st, 1), fe_subst_pass_list(dyn_get(st, 2), consumed)]
    if op == "for":
        return ["for", dyn_get(st, 1), dyn_get(st, 2), fe_subst_pass_list(dyn_get(st, 3), consumed), dyn_get(st, 4)]
    if op == "match":
        ncases = []
        cases = dyn_get(st, 2)
        for k, cs in enumerate(cases):
            ncases.append(["match_case", dyn_get(cs, 1), dyn_get(cs, 2), fe_subst_pass_list(dyn_get(cs, 3), consumed)])
        return ["match", dyn_get(st, 1), ncases]
    return st


def fe_hoist_nested(mod: object, seen: list[str], stack: list[str], alias_names: list[str], alias_exports: object) -> object:
    stmts = dyn_get(mod, 1)
    inserts = []
    consumed = []
    any_consumed: bool = False
    for i, st in enumerate(stmts):
        found = []
        fe_collect_imports_into(st, found)
        spliced = []
        for j, nd in enumerate(found):
            op: object = dyn_head(nd)
            if op == "from_import":
                fmod: object = dyn_get(nd, 1)
                fnlevel: object = dyn_get(nd, 3)
                if fmod is None or fnlevel != 0 or "." in str(fmod):
                    continue
                fpath: str = fmod + ".si"
                if file_exists(fpath):
                    more = fe_load_splice(fpath, fmod, seen, stack, alias_names, alias_exports)
                    for k, s in enumerate(more):
                        spliced.append(s)
                    consumed.append(nd)
                    any_consumed = True
            else:
                pairs = dyn_get(nd, 1)
                all_ok: bool = dyn_len(pairs) > 0
                for j2, pr in enumerate(pairs):
                    nm: object = dyn_get(pr, 0)
                    path: str = nm + ".si"
                    if file_exists(path):
                        more2 = fe_load_splice(path, nm, seen, stack, alias_names, alias_exports)
                        for k2, s2 in enumerate(more2):
                            spliced.append(s2)
                        asn2: object = dyn_get(pr, 1)
                        if asn2 is not None and asn2 != nm:
                            fe_register_alias(asn2, nm, alias_names, alias_exports)
                    else:
                        all_ok = False
                # partial (mixed .si + foreign) keeps the node as-is:
                # the foreign names stay inert and the resolved ones are
                # already inlined at module level
                if all_ok:
                    consumed.append(nd)
                    any_consumed = True
        inserts.append(spliced)
    out = []
    for i, st in enumerate(stmts):
        sp = inserts[i]
        if dyn_len(sp) > 0 and dyn_len(out) > 0 and hoist_is_node(out[dyn_len(out) - 1]) and dyn_head(out[dyn_len(out) - 1]) == "line":
            # keep the enclosing statement's line marker directly in
            # front of it: spliced content goes BEFORE the marker,
            # matching the reference front end's statement order
            marker = out[dyn_len(out) - 1]
            out = fe_drop_tail(out)
            for m, s3 in enumerate(sp):
                out.append(s3)
            out.append(marker)
        else:
            for m, s3 in enumerate(sp):
                out.append(s3)
        if any_consumed:
            out.append(fe_subst_pass_stmt(st, consumed))
        else:
            out.append(st)
    return ["module", out]


def fe_register_alias(aname: str, src_name: str, alias_names: list[str], alias_exports: object) -> None:
    # second name bound to src_name's exports (import x as y); safe to
    # call whether or not src_name just loaded or was already inlined
    si: int = fe_alias_index(alias_names, src_name)
    if si < 0:
        return
    ti: int = fe_alias_index(alias_names, aname)
    if ti < 0:
        alias_names.append(aname)
        alias_exports.append(dyn_get(alias_exports, si))
    else:
        for m, en in enumerate(dyn_get(alias_exports, si)):
            if not hg_in_list(dyn_get(alias_exports, ti), en):
                dyn_get(alias_exports, ti).append(en)


def fe_alias_index(names: list[str], name: str) -> int:
    i: int = 0
    while i < len(names):
        if names[i] == name:
            return i
        i += 1
    return 0 - 1


def fe_rewrite_aliases(node: object, alias_names: list[str], alias_exports: list) -> object:
    if hoist_is_scalar(node):
        return node
    if hoist_is_node(node):
        if dyn_head(node) == "attribute" and dyn_len(node) >= 3:
            base = dyn_get(node, 1)
            if hoist_is_node(base) and dyn_head(base) == "name":
                an: object = dyn_get(base, 1)
                ai: int = fe_alias_index(alias_names, an)
                if ai >= 0 and hg_in_list(dyn_get(alias_exports, ai), dyn_get(node, 2)):
                    return ["name", dyn_get(node, 2)]
        out = [dyn_head(node)]
        for i, c in enumerate(node):
            if i > 0:
                out.append(fe_rewrite_aliases(c, alias_names, alias_exports))
        return out
    out2 = []
    for i, c in enumerate(node):
        out2.append(fe_rewrite_aliases(c, alias_names, alias_exports))
    return out2


def hg_lookup(g: HG, name: str) -> str:
    i: int = 0
    while i < len(g.ren_src):
        if g.ren_src[i] == name:
            return g.ren_dst[i]
        i += 1
    return ""


def hg_empty_strs() -> list[str]:
    out: list[str] = []
    return out


def dyn_get(node: object, k: int) -> object:
    for i, e in enumerate(node):
        if i == k:
            return e
    return None


def dyn_len(node: object) -> int:
    n: int = 0
    for i, e in enumerate(node):
        n += 1
    return n


def dyn_head(node: object) -> object:
    for i, e in enumerate(node):
        return e
    return None


def hoist_is_node(node: object) -> bool:
    # a dynamic list whose head is a string = IR node
    if node is None or not isinstance(node, (list, tuple)):
        return False
    if dyn_len(node) == 0:
        return False
    return isinstance(dyn_head(node), str)


def hoist_is_scalar(node: object) -> bool:
    return isinstance(node, str) or isinstance(node, int) or isinstance(node, float) or isinstance(node, bool) or node is None


def hoist_mentions(node: object, name: str) -> bool:
    if hoist_is_scalar(node):
        return False
    if hoist_is_node(node):
        if dyn_head(node) == "name" and dyn_len(node) == 2 and dyn_get(node, 1) == name:
            return True
    for i, c in enumerate(node):
        if hoist_mentions(c, name):
            return True
    return False


def hg_in_list(names: object, name: str) -> bool:
    for i, n in enumerate(names):
        if n == name:
            return True
    return False


def hoist_calls_one_of(node: object, names: object) -> bool:
    if hoist_is_scalar(node):
        return False
    if hoist_is_node(node) and dyn_head(node) == "call":
        callee = dyn_get(node, 1)
        if hoist_is_node(callee) and dyn_head(callee) == "name":
            if hg_in_list(names, dyn_get(callee, 1)):
                return True
    for i, c in enumerate(node):
        if hoist_calls_one_of(c, names):
            return True
    return False


def hoist_collect_locals(node: object, out: object) -> None:
    # names assigned within a function body: assign/ann_assign/aug_assign
    # targets, tuple_assign targets, for-loop targets, nested def names -
    # the function's own locals, never captures (mirrors
    # nested_hoist._collect_locals)
    if not isinstance(node, (list, tuple)):
        return
    if dyn_len(node) >= 2 and isinstance(dyn_head(node), str):
        op: object = dyn_head(node)
        if (op == "assign" or op == "ann_assign" or op == "aug_assign") and isinstance(dyn_get(node, 1), str):
            out.append(dyn_get(node, 1))
        elif op == "tuple_assign":
            for target in dyn_get(node, 1):
                if isinstance(target, str):
                    out.append(target)
                elif (
                    isinstance(target, (list, tuple))
                    and dyn_len(target) >= 2
                    and dyn_head(target) == "name"
                    and isinstance(dyn_get(target, 1), str)
                ):
                    out.append(dyn_get(target, 1))
        elif op == "for" or op == "c_for":
            target2 = dyn_get(node, 1)
            if isinstance(target2, str):
                out.append(target2)
            elif (
                isinstance(target2, (list, tuple))
                and dyn_len(target2) >= 2
                and dyn_head(target2) == "name"
                and isinstance(dyn_get(target2, 1), str)
            ):
                out.append(dyn_get(target2, 1))
            elif (
                isinstance(target2, (list, tuple))
                and dyn_len(target2) >= 2
                and dyn_head(target2) == "tuple_unpack"
            ):
                for name in dyn_get(target2, 1):
                    out.append(name)
        elif op == "func_def":
            out.append(dyn_get(node, 1))
            return
    for c in node:
        if isinstance(c, (list, tuple)):
            hoist_collect_locals(c, out)


def hoist_collect_assigned(stmts: object, sink: object) -> None:
    # names the function body itself binds: assignments, for targets,
    # and anything assigned inside control-flow bodies (mirrors
    # nested_hoist._collect_assigned_names)
    if not isinstance(stmts, (list, tuple)):
        return
    for st in stmts:
        if not isinstance(st, (list, tuple)) or dyn_len(st) == 0:
            continue
        op: object = dyn_head(st)
        if op == "assign" or op == "ann_assign" or op == "aug_assign":
            tgt = dyn_get(st, 1)
            if isinstance(tgt, str):
                sink.append(tgt)
            elif (
                isinstance(tgt, (list, tuple))
                and dyn_len(tgt) >= 2
                and dyn_head(tgt) == "name"
            ):
                sink.append(dyn_get(tgt, 1))
        elif op == "for" and dyn_len(st) >= 2:
            t = dyn_get(st, 1)
            if isinstance(t, str):
                sink.append(t)
            elif (
                isinstance(t, (list, tuple))
                and dyn_len(t) >= 2
                and dyn_head(t) == "name"
            ):
                sink.append(dyn_get(t, 1))
            hoist_collect_locals(dyn_get(st, 3) if dyn_len(st) > 3 else [], sink)
        elif op == "if" and dyn_len(st) >= 4:
            hoist_collect_locals(dyn_get(st, 2), sink)
            hoist_collect_locals(dyn_get(st, 3), sink)
        elif op == "while" and dyn_len(st) >= 3:
            hoist_collect_locals(dyn_get(st, 2), sink)


def hoist_free_names(node: object, out: object) -> int:
    if hoist_is_scalar(node):
        return 0
    if hoist_is_node(node):
        if dyn_head(node) == "name" and dyn_len(node) == 2:
            nm: str = dyn_get(node, 1)
            if not hg_in_list(out, nm):
                out.append(nm)
            return 0
    for i, c in enumerate(node):
        hoist_free_names(c, out)
    return 0


def hoist_insert_self(body: object, needing: object) -> object:
    if hoist_is_scalar(body):
        return body
    if hoist_is_node(body) and dyn_head(body) == "call":
        callee = dyn_get(body, 1)
        if hoist_is_node(callee) and dyn_head(callee) == "name":
            if hg_in_list(needing, dyn_get(callee, 1)):
                args = dyn_get(body, 2)
                new_args = [["name", "self"]]
                for i, a in enumerate(args):
                    new_args.append(hoist_insert_self(a, needing))
                return ["call", callee, new_args, dyn_get(body, 3)]
    if hoist_is_node(body):
        out2 = [dyn_head(body)]
        for j, c in enumerate(body):
            if j > 0:
                out2.append(hoist_insert_self(c, needing))
        return out2
    out = []
    for i, c in enumerate(body):
        out.append(hoist_insert_self(c, needing))
    return out


def hoist_rec(node: object, g: HG, hoisted: object) -> object:
    if hoist_is_scalar(node):
        return node
    op: object = None
    if hoist_is_node(node):
        op = dyn_head(node)
    if op == "func_def":
        mangled: str = g.prefix + "__" + str(dyn_get(node, 1))
        g.ren_src.append(str(dyn_get(node, 1)))
        g.ren_dst.append(mangled)
        body = hoist_rec(dyn_get(node, 3), g, hoisted)
        exp_flag = None
        if dyn_len(node) > 6:
            exp_flag = dyn_get(node, 6)
        if exp_flag is not None:
            hoisted.append(["func_def", mangled, dyn_get(node, 2), body, dyn_get(node, 4), dyn_get(node, 5), exp_flag])
        else:
            hoisted.append(["func_def", mangled, dyn_get(node, 2), body, dyn_get(node, 4), dyn_get(node, 5)])
        return None
    if op == "lambda":
        g.counter += 1
        mangled2: str = g.prefix + "__L" + str(g.counter)
        if hoist_mentions(dyn_get(node, 2), "self"):
            print("M4 hoist error: lambda capturing 'self' is not supported; use a nested def")
            raise SystemExit(1)
        lbody = hoist_rec(dyn_get(node, 2), g, hoisted)
        annos = []
        p: int = 0
        while p < dyn_len(dyn_get(node, 1)):
            annos.append(None)
            p += 1
        hoisted.append(["func_def", mangled2, dyn_get(node, 1), [["return", lbody]], annos, None])
        return ["funcref", mangled2]
    if op == "call":
        callee = dyn_get(node, 1)
        if hoist_is_node(callee) and dyn_head(callee) == "name":
            m2: str = hg_lookup(g, str(dyn_get(callee, 1)))
            if m2 != "":
                new_args2 = []
                for i, a in enumerate(dyn_get(node, 2)):
                    new_args2.append(hoist_rec(a, g, hoisted))
                return ["call", ["name", m2], new_args2, dyn_get(node, 3)]
    if op == "name":
        nm3: str = str(dyn_get(node, 1))
        m4: str = hg_lookup(g, nm3)
        if m4 != "" and not hg_in_list(g.locals, nm3):
            # a hoisted function referenced as a VALUE (passed as an
            # argument): the mangled funcref node - a local of the same
            # name shadows it and reads the local slot instead
            return ["funcref", m4]
    if hoist_is_node(node):
        out3 = [op]
        for j, c in enumerate(node):
            if j > 0:
                out3.append(hoist_rec(c, g, hoisted))
        return out3
    out4 = []
    for i, c in enumerate(node):
        r2 = hoist_rec(c, g, hoisted)
        if r2 is not None:
            out4.append(r2)
    return out4


def hoist_def(func_def: object, cls_name: str, is_method: bool, global_names: list[str], extra: object) -> object:
    prefix: str = str(dyn_get(func_def, 1))
    if cls_name != "":
        prefix = cls_name + "__" + str(dyn_get(func_def, 1))
    # untyped on purpose: a list[str] local boxes by value when passed
    # to the collector's object param, so appends would mutate a copy
    g_locals = []
    hoist_collect_assigned(dyn_get(func_def, 3), g_locals)
    g: HG = HG(prefix, cls_name, is_method, hg_empty_strs(), hg_empty_strs(), 0, global_names, g_locals)
    hoisted = []
    new_body = hoist_rec(dyn_get(func_def, 3), g, hoisted)

    needing = []
    for i, h in enumerate(hoisted):
        if hoist_mentions(dyn_get(h, 3), "self"):
            needing.append(dyn_get(h, 1))
    changed: bool = True
    while changed:
        changed = False
        for j, h2 in enumerate(hoisted):
            mangled: str = str(dyn_get(h2, 1))
            if not hg_in_list(needing, mangled):
                if hoist_calls_one_of(dyn_get(h2, 3), needing):
                    needing.append(mangled)
                    changed = True

    final = []
    for m, h3 in enumerate(hoisted):
        mangled2: str = str(dyn_get(h3, 1))
        body2 = dyn_get(h3, 3)
        params = dyn_get(h3, 2)
        annos2 = dyn_get(h3, 4)
        if hg_in_list(needing, mangled2):
            body2 = hoist_insert_self(body2, needing)
            cls_anno = None
            if cls_name != "":
                cls_anno = ["name", cls_name]
            new_params = ["self"]
            for v, pv in enumerate(params):
                new_params.append(pv)
            new_annos = [cls_anno]
            for u, av in enumerate(annos2):
                new_annos.append(av)
            h3 = ["func_def", mangled2, new_params, body2, new_annos, dyn_get(h3, 5)]
        free = []
        hoist_free_names(dyn_get(h3, 3), free)
        allowed = []
        for gi, gn in enumerate(global_names):
            allowed.append(gn)
        for ni, nn in enumerate(needing):
            allowed.append(nn)
        for pi, pv2 in enumerate(dyn_get(h3, 2)):
            allowed.append(pv2)
        allowed.append("self")
        # the function's own locals are not captures, and any sibling
        # hoisted name is callable (calls carry mangled names) - both
        # per nested_hoist's bound set
        own_locals = []
        hoist_collect_locals(dyn_get(h3, 3), own_locals)
        for li, ln in enumerate(own_locals):
            allowed.append(ln)
        for hi, hn in enumerate(hoisted):
            allowed.append(dyn_get(hoisted[hi], 1))
        for fi, fname in enumerate(free):
            if not hg_in_list(allowed, fname):
                print("M4 hoist error: nested function '" + mangled2 + "' captures '" + str(fname) + "'; pass it as a parameter")
                raise SystemExit(1)
        final.append(h3)

    if is_method and dyn_len(needing) > 0:
        new_body = hoist_insert_self(new_body, needing)
    for q, f2 in enumerate(final):
        extra.append(f2)
    if dyn_len(func_def) > 6:
        return ["func_def", dyn_get(func_def, 1), dyn_get(func_def, 2), new_body, dyn_get(func_def, 4), dyn_get(func_def, 5), dyn_get(func_def, 6)]
    return ["func_def", dyn_get(func_def, 1), dyn_get(func_def, 2), new_body, dyn_get(func_def, 4), dyn_get(func_def, 5)]


def hoist_module(mod: object) -> object:
    stmts = dyn_get(mod, 1)
    global_names: list[str] = ["len", "range", "str", "int", "float", "bool", "print", "fmt", "min", "max", "abs", "input", "enumerate", "isinstance", "read_stdin", "read_file", "ord", "chr", "repr", "tuple", "list", "dict", "set", "type", "sorted", "zip", "map", "sum", "any", "all"]

    for i, st in enumerate(stmts):
        if hoist_is_node(st):
            if dyn_head(st) == "func_def" or dyn_head(st) == "class_def":
                global_names.append(dyn_get(st, 1))
            elif dyn_head(st) == "assign" or dyn_head(st) == "ann_assign":
                # only a NAME is a global (nested_hoist's isinstance
                # guard): `h.n = 5` assigns to an attribute NODE, and
                # the node in the list[str] crashed the front end with
                # "TypeError: expected str" on every module-level
                # attribute store
                tgt = dyn_get(st, 1)
                if isinstance(tgt, str):
                    global_names.append(tgt)

    out = []
    for j, st in enumerate(stmts):
        if hoist_is_node(st) and dyn_head(st) == "func_def":
            extra = []
            out.append(hoist_def(st, "", False, global_names, extra))
            for q, e in enumerate(extra):
                out.append(e)
        elif hoist_is_node(st) and dyn_head(st) == "class_def":
            cls_name: str = str(dyn_get(st, 1))
            new_members = []
            extra2 = []
            for k, mm in enumerate(dyn_get(st, 3)):
                if hoist_is_node(mm) and dyn_head(mm) == "func_def":
                    is_m: bool = False
                    mparams = dyn_get(mm, 2)
                    if dyn_len(mparams) > 0 and dyn_get(mparams, 0) == "self":
                        is_m = True
                    new_members.append(hoist_def(mm, cls_name, is_m, global_names, extra2))
                else:
                    new_members.append(mm)
            out.append(["class_def", dyn_get(st, 1), dyn_get(st, 2), new_members])
            for q2, e2 in enumerate(extra2):
                out.append(e2)
        else:
            out.append(st)
    return ["module", out]


# ---------- JSON emission for the IR tuples ----------

def json_emit(node, out: list[str]) -> None:
    if node is None:
        out.append("null")
    elif node is True:
        out.append("true")
    elif node is False:
        out.append("false")
    elif isinstance(node, int):
        out.append(str(node))
    elif isinstance(node, float):
        out.append(str(node))
    elif isinstance(node, str):
        out.append(json_quote(node))
    elif isinstance(node, (list, tuple)):
        out.append("[")
        for i, child in enumerate(node):
            if i:
                out.append(",")
            json_emit(child, out)
        out.append("]")


def json_quote(s: str) -> str:
    out = ['"']
    for ch in s:
        if ch == '"':
            out.append('\\"')
        elif ch == "\\":
            out.append("\\\\")
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\t":
            out.append("\\t")
        elif ch == "\r":
            out.append("\\r")
        elif ord(ch) < 0x20:
            # manual hex digits: the runtime mod has no str formatting
            digits: str = "0123456789abcdef"
            c4: int = ord(ch)
            out.append("\\u" + digits[c4 // 4096] + digits[(c4 // 256) % 16] + digits[(c4 // 16) % 16] + digits[c4 % 16])
        else:
            out.append(ch)
    out.append('"')
    return "".join(out)


def json_dumps(node) -> str:
    out: list[str] = []
    json_emit(node, out)
    return "".join(out)


def fe_compile(src: str) -> str:
    # source -> IR JSON; the standalone front end and the siluc
    # monolith both call this (import inlining puts every module
    # symbol in one namespace, so the workhorse cannot be 'main')
    parser: Parser = Parser(tokenize(src), 0)
    module = parser.parse_module()
    seen: list[str] = []
    stack: list[str] = []
    alias_names: list[str] = []
    alias_exports = []
    module = fe_expand_imports(module, seen, stack, alias_names, alias_exports)
    module = fe_rewrite_aliases(module, alias_names, alias_exports)
    return json_dumps(hoist_module(module))
