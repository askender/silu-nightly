# M4 self-hosting milestone (docs/m4_frontend.md): the front end of a
# Silu compiler, written in Silu itself. Reads Silu source on stdin,
# emits the Silu tuple-IR as JSON on stdout - byte-identical to what
# `silu ir --format json` produces for the same program.
# Pipeline: [this program] -> M2 (ir_interp) / M3 (ir2c) -> C -> clang.

import json


class TokKind(Enum):
    NAME = 0
    NUM = 1
    STR = 2
    OP = 3
    KW = 4
    NL = 5
    END = 6
    FSTR = 7


class Token:
    kind: TokKind
    text: str
    line: int
    col: int


class Lexer:
    src: str
    pos: int
    line: int
    col: int
    depth: int

    # The lexer hot loop works on code points (ord(src[i]) decodes a
    # borrowed char view with zero allocation); strings are only
    # materialized once per token as the text slice.
    def peek_cp(self) -> int:
        if self.pos >= len(self.src):
            return -1
        return ord(self.src[self.pos])

    def peek2_cp(self) -> int:
        if self.pos + 1 >= len(self.src):
            return -1
        return ord(self.src[self.pos + 1])

    def advance(self) -> int:
        c: int = self.peek_cp()
        self.pos += 1
        if c == 10:
            self.line += 1
            self.col = 0
        else:
            self.col += 1
        return c

    def skip_ws_and_comments(self) -> int:
        while self.pos < len(self.src):
            c: int = self.peek_cp()
            if c == 32 or c == 9:
                self.advance()
            elif c == 35:
                while self.pos < len(self.src) and self.peek_cp() != 10:
                    self.advance()
            else:
                return 0
        return 0

    def is_name_start_cp(self, c: int) -> bool:
        return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95

    def is_name_char_cp(self, c: int) -> bool:
        return self.is_name_start_cp(c) or (c >= 48 and c <= 57)

    def is_kw(self, text: str) -> bool:
        return (
            text == "def" or text == "class" or text == "if" or text == "elif"
            or text == "else" or text == "while" or text == "for" or text == "in"
            or text == "not" or text == "and" or text == "or" or text == "return"
            or text == "break" or text == "continue" or text == "pass"
            or text == "match" or text == "case" or text == "import" or text == "from"
            or text == "raise" or text == "is" or text == "None" or text == "True"
            or text == "False" or text == "lambda" or text == "del" or text == "assert"
            or text == "with" or text == "as" or text == "try" or text == "except"
            or text == "finally" or text == "global" or text == "nonlocal" or text == "yield"
            or text == "async" or text == "await" or text == "if"
        )

    def next_token(self) -> Token:
        self.skip_ws_and_comments()
        if self.pos >= len(self.src):
            return Token(TokKind.END, "", self.line, self.col)
        c: int = self.peek_cp()
        line = self.line
        col = self.col
        if c == 10:
            self.advance()
            if self.depth > 0:
                return self.next_token()
            return Token(TokKind.NL, "\n", line, col)
        if (c == 102 or c == 70) and (self.peek2_cp() == 34 or self.peek2_cp() == 39):
            # f-string: 'f' + quote ... quote, raw text (braces intact)
            q0: int = self.peek2_cp()
            self.advance()
            self.advance()
            startf: int = self.pos
            while self.pos < len(self.src) and self.peek_cp() != q0:
                if self.peek_cp() == 92:
                    self.advance()
                self.advance()
            rawf: str = self.src[startf:self.pos]
            self.advance()  # closing quote
            return Token(TokKind.FSTR, rawf, line, col)
        if self.is_name_start_cp(c):
            start: int = self.pos
            while self.pos < len(self.src) and self.is_name_char_cp(self.peek_cp()):
                self.advance()
            text: str = self.src[start:self.pos]
            if self.is_kw(text):
                return Token(TokKind.KW, text, line, col)
            return Token(TokKind.NAME, text, line, col)
        if c >= 48 and c <= 57:
            start: int = self.pos
            # 0x hex literal (and 0b/0o) - one token, no dot/exponent
            nxt: int = self.peek2_cp()
            if c == 48 and (nxt == 120 or nxt == 88):
                self.advance()
                self.advance()
                while self.pos < len(self.src):
                    d: int = self.peek_cp()
                    if (d >= 48 and d <= 57) or (d >= 97 and d <= 102) or (d >= 65 and d <= 70):
                        self.advance()
                    else:
                        break
                return Token(TokKind.NUM, self.src[start:self.pos], line, col)
            if c == 48 and (nxt == 98 or nxt == 66 or nxt == 111 or nxt == 79):
                self.advance()
                self.advance()
                while self.pos < len(self.src):
                    d: int = self.peek_cp()
                    if (d >= 48 and d <= 57) or d == 95:
                        self.advance()
                    else:
                        break
                return Token(TokKind.NUM, self.src[start:self.pos], line, col)
            seen_dot: bool = False
            seen_exp: bool = False
            while self.pos < len(self.src):
                d: int = self.peek_cp()
                if (d >= 48 and d <= 57) or d == 95:
                    self.advance()
                elif d == 46 and not seen_dot and not seen_exp and self.peek2_cp() != 46:
                    seen_dot = True
                    self.advance()
                elif (d == 101 or d == 69) and not seen_exp:
                    seen_exp = True
                    self.advance()
                    nxt2: int = self.peek_cp()
                    if nxt2 == 43 or nxt2 == 45:
                        self.advance()
                else:
                    return Token(TokKind.NUM, self.src[start:self.pos], line, col)
            return Token(TokKind.NUM, self.src[start:self.pos], line, col)
        if c == 34 or c == 39:
            q: int = self.advance()
            start: int = self.pos
            while self.pos < len(self.src) and self.peek_cp() != q:
                if self.peek_cp() == 92:
                    self.advance()
                self.advance()
            text: str = self.src[start:self.pos]
            self.advance()  # closing quote
            return Token(TokKind.STR, text, line, col)
        # operators: longest match first
        two: str = self.src[self.pos : self.pos + 2]
        three: str = two
        if self.pos + 2 < len(self.src):
            three = self.src[self.pos : self.pos + 3]
        if three == "//=" or three == "**=":
            self.advance()
            self.advance()
            self.advance()
            return Token(TokKind.OP, three, line, col)
        if (
            two == "//" or two == "**" or two == "<<" or two == ">>" or two == "<="
            or two == ">=" or two == "==" or two == "!=" or two == "+=" or two == "-="
            or two == "*=" or two == "/=" or two == "%=" or two == "->" or two == ":="
            or two == "|=" or two == "&=" or two == "^="
        ):
            self.advance()
            self.advance()
            return Token(TokKind.OP, two, line, col)
        self.advance()
        if c == 40 or c == 91 or c == 123:
            self.depth += 1
        elif c == 41 or c == 93 or c == 125:
            self.depth -= 1
        return Token(TokKind.OP, self.src[self.pos - 1 : self.pos], line, col)


def tokenize(src: str) -> list[Token]:
    lexer: Lexer = Lexer(src, 0, 1, 0, 0)
    toks: list[Token] = []
    while True:
        t: Token = lexer.next_token()
        toks.append(t)
        if t.kind == TokKind.END:
            return toks


def unescape(s: str) -> str:
    out: str = ""
    i: int = 0
    n: int = len(s)
    while i < n:
        ch = s[i]
        if ch == "\\" and i + 1 < n:
            nxt = s[i + 1]
            if nxt == "n":
                out = out + "\n"
                i += 2
            elif nxt == "t":
                out = out + "\t"
                i += 2
            elif nxt == "r":
                out = out + "\r"
                i += 2
            elif nxt == '"':
                out = out + '"'
                i += 2
            elif nxt == "'":
                out = out + "'"
                i += 2
            elif nxt == "\\":
                out = out + "\\"
                i += 2
            else:
                out = out + ch
                i += 1
        else:
            out = out + ch
            i += 1
    return out


# ---------- IR output via JValue-free list assembly ----------
# The front end builds Python-tuple IR directly and prints it with
# json.dumps-compatible formatting. A small pretty-printer walks it.


def is_num(text: str) -> bool:
    if len(text) == 0:
        return False
    for i in range(len(text)):
        ch = text[i]
        if not (ch.isdigit() or ch == "." or ch == "e" or ch == "E" or ch == "+" or ch == "-" or ch == "_"):
            return False
    return True


def to_float(text: str) -> float:
    return float(text)


def to_int(text: str) -> int:
    if "." in text or "e" in text or "E" in text:
        return int(float(text))
    if len(text) > 1 and text[0] == "0":
        c: str = text[1]
        if c == "x" or c == "X":
            return int(text, 16)
        if c == "b" or c == "B":
            return int(text, 2)
        if c == "o" or c == "O":
            return int(text, 8)
    return int(text)


def const_num(tok: Token) -> object:
    if "." in tok.text or "e" in tok.text or "E" in tok.text:
        return ["const", to_float(tok.text)]
    return ["const", to_int(tok.text)]


def const_str(tok: Token) -> object:
    return ["const", unescape(tok.text)]


class Parser:
    toks: list[Token]
    pos: int

    def cur(self) -> Token:
        return self.toks[self.pos]

    def nxt(self) -> Token:
        t: Token = self.toks[self.pos]
        self.pos += 1
        return t

    def accept(self, text: str) -> bool:
        t: Token = self.cur()
        if (t.kind == TokKind.OP or t.kind == TokKind.KW) and t.text == text:
            self.pos += 1
            return True
        return False

    def expect(self, text: str) -> Token:
        t: Token = self.cur()
        if (t.kind != TokKind.OP and t.kind != TokKind.KW) or t.text != text:
            self.error("expected '" + text + "', got '" + t.text + "'", t)
        return self.nxt()

    def expect_kind(self, kind: TokKind) -> Token:
        t: Token = self.cur()
        if t.kind != kind:
            self.error("expected token kind " + str(kind), t)
        return self.nxt()

    def error(self, msg: str, tok: Token) -> None:
        print("M4 error line", tok.line, ":", msg)
        raise SystemExit(1)

    def at_end(self) -> bool:
        return self.cur().kind == TokKind.END

    def parse_module(self) -> object:
        stmts = []
        while not self.at_end():
            t = self.cur()
            if t.kind == TokKind.NL:
                self.nxt()
                continue
            stmts.append(["line", t.line])
            stmts.append(self.parse_stmt())
        return ["module", stmts]

    # ------------- statements -------------
    def parse_stmt(self) -> object:
        t = self.cur()
        if t.kind == TokKind.KW:
            if t.text == "def":
                return self.parse_func_def()
            if t.text == "class":
                return self.parse_class_def()
            if t.text == "if":
                return self.parse_if()
            if t.text == "while":
                return self.parse_while()
            if t.text == "for":
                return self.parse_for()
            if t.text == "match":
                return self.parse_match()
            if t.text == "return":
                return self.parse_return()
            if t.text == "break":
                self.nxt()
                self.expect_nl()
                return ["break"]
            if t.text == "continue":
                self.nxt()
                self.expect_nl()
                return ["continue"]
            if t.text == "pass":
                self.nxt()
                self.expect_nl()
                return ["pass"]
            if t.text == "import" or t.text == "from":
                return self.parse_import()
            if t.text == "raise":
                return self.parse_raise()
            if t.text == "del":
                return self.parse_del()
            if t.text == "assert":
                return self.parse_assert()
        return self.parse_simple_stmt()

    def expect_nl(self) -> None:
        t = self.cur()
        if t.kind == TokKind.NL:
            self.nxt()
        elif t.kind != TokKind.END:
            self.error("expected end of line", t)

    def parse_import(self) -> object:
        # import x / from x import y[, z] - names are recorded, loading
        # is a no-op (M4 white-list has no importable surface)
        if self.cur().text == "from":
            self.nxt()
            module = self.expect_kind(TokKind.NAME).text
            self.expect("import")
            pairs = []
            while True:
                n = self.expect_kind(TokKind.NAME).text
                pairs.append([n, None])
                if not self.accept(","):
                    break
            self.expect_nl()
            return ["from_import", module, pairs, 0]
        self.expect("import")
        pairs = []
        while True:
            n = self.expect_kind(TokKind.NAME).text
            pairs.append([n, None])
            if not self.accept(","):
                break
        self.expect_nl()
        return ["import", pairs]

    def parse_func_def(self) -> object:
        self.expect("def")
        name = self.expect_kind(TokKind.NAME).text
        self.expect("(")
        params = []
        annos = []
        while not (self.cur().kind == TokKind.OP and self.cur().text == ")"):
            pname = self.expect_kind(TokKind.NAME).text
            params.append(pname)
            annos.append(None)
            if self.accept(":"):
                annos[-1] = self.parse_annotation()
            if not self.accept(","):
                break
        self.expect(")")
        ret_anno = None
        if self.accept("->"):
            ret_anno = self.parse_annotation()
        self.expect(":")
        body = self.parse_block()
        return ["func_def", name, params, body, annos, ret_anno]

    def parse_annotation(self) -> object:
        # simple annotations: Name / Name[Name] / None
        t = self.cur()
        if t.kind == TokKind.KW and t.text == "None":
            self.nxt()
            return ["const", None]
        name = self.expect_kind(TokKind.NAME).text
        if self.accept("["):
            inner = [self.parse_annotation()]
            while self.accept(","):
                inner.append(self.parse_annotation())
            self.expect("]")
            return ["subscript", ["name", name], inner[0] if len(inner) == 1 else ["tuple", inner]]
        return ["name", name]

    def parse_class_def(self) -> object:
        self.expect("class")
        name = self.expect_kind(TokKind.NAME).text
        bases = []
        if self.accept("("):
            while not (self.cur().kind == TokKind.OP and self.cur().text == ")"):
                bases.append(self.expect_kind(TokKind.NAME).text)
                if not self.accept(","):
                    break
            self.expect(")")
        self.expect(":")
        body = self.parse_block()
        # enum: exactly one base named Enum
        if len(bases) == 1 and bases[0] == "Enum":
            members = []
            for stmt in body:
                if stmt is None:
                    continue
                if stmt[0] == "line":
                    continue
                if stmt[0] == "assign" and isinstance(stmt[1], str):
                    members.append([stmt[1], stmt[2]])
                elif stmt[0] == "name":
                    members.append([stmt[1], None])
            return ["enum_def", name, members]
        if bases:
            self.error("inheritance not supported", self.cur())
        return ["class_def", name, (), body]

    def parse_block(self) -> object:
        # expect NL, INDENT, stmt+, DEDENT (DEDENT handled by caller via
        # matching indentation; we approximate by consuming statements
        # until dedent token - simplified: parse until a NL with lower
        # indentation is seen, but this lexer has no indentation tokens.
        # Simplified: rely on parse_stmt stopping at block end via the
        # fact that the caller checks indentation - here we just consume
        # until an END/DEDENT-like condition.
        self.expect_nl()
        stmts = []
        # Simplified block parsing: read until indentation decreases below
        # the block's opening level. We track the column of the block's
        # first statement; every statement at a smaller column ends it.
        base_col = None
        while not self.at_end():
            t = self.cur()
            if t.kind == TokKind.NL:
                self.nxt()
                continue
            if base_col is None:
                base_col = t.col
            if t.col < base_col:
                break
            stmts.append(["line", t.line])
            stmts.append(self.parse_stmt())
        return stmts

    def parse_if(self) -> object:
        # if/elif*/else? - elif chains nest as if-in-orelse. An arm only
        # claims an elif/else at its own indentation level; a deeper
        # else belongs to an inner chain this arm's block stopped at.
        if_col = self.cur().col
        self.expect("if")
        test = self.parse_expr()
        self.expect(":")
        body = self.parse_block()
        orelse = []
        t = self.cur()
        if t.kind == TokKind.KW and t.text == "elif" and t.col == if_col:
            arm_line = t.line
            self.nxt()
            inner = self.parse_if_tail(if_col)
            orelse = [["line", arm_line], inner]
        elif t.kind == TokKind.KW and t.text == "else" and t.col == if_col:
            self.nxt()
            self.expect(":")
            orelse = self.parse_block()
        return ["if", test, body, orelse]

    def parse_if_tail(self, if_col: int) -> object:
        # one elif arm: condition ':' block, then any further
        # elif/else continues the chain in its orelse
        test = self.parse_expr()
        self.expect(":")
        body = self.parse_block()
        orelse = []
        t = self.cur()
        if t.kind == TokKind.KW and t.text == "elif" and t.col == if_col:
            arm_line = t.line
            self.nxt()
            orelse = [["line", arm_line], self.parse_if_tail(if_col)]
        elif t.kind == TokKind.KW and t.text == "else" and t.col == if_col:
            self.nxt()
            self.expect(":")
            orelse = self.parse_block()
        return ["if", test, body, orelse]

    def parse_while(self) -> object:
        self.expect("while")
        test = self.parse_expr()
        self.expect(":")
        body = self.parse_block()
        return ["while", test, body]

    def parse_for(self) -> object:
        self.expect("for")
        first = self.expect_kind(TokKind.NAME).text
        target = ["name", first]
        if self.cur().kind == TokKind.OP and self.cur().text == ",":
            names = [first]
            while self.cur().kind == TokKind.OP and self.cur().text == ",":
                self.nxt()
                names.append(self.expect_kind(TokKind.NAME).text)
            target = ["tuple_unpack", names]
        self.expect("in")
        iter_expr = self.parse_expr()
        self.expect(":")
        body = self.parse_block()
        return ["for", target, iter_expr, body, []]

    def parse_match(self) -> object:
        self.expect("match")
        subject = self.parse_expr()
        self.expect(":")
        self.expect_nl()
        cases = []
        base_col = None
        while not self.at_end():
            t = self.cur()
            if t.kind == TokKind.NL:
                self.nxt()
                continue
            if t.kind != TokKind.KW or t.text != "case":
                break
            if base_col is None:
                base_col = t.col
            if t.col < base_col:
                break
            self.nxt()
            pattern = self.parse_pattern()
            guard = None
            if self.accept("if"):
                guard = self.parse_expr()
            self.expect(":")
            body = self.parse_block()
            cases.append(["match_case", pattern, guard, body])
        return ["match", subject, cases]

    def parse_fstring(self, raw: str) -> object:
        # desugar f".." exactly like the reference front end: one
        # fmt(...) call - literal parts ({{ }} unescaped) as const
        # strings, {expr} parts re-lexed and parsed as expressions
        parts = []
        lit = ""
        i: int = 0
        n: int = len(raw)
        while i < n:
            ch = raw[i]
            if ch == "{" and i + 1 < n and raw[i + 1] == "{":
                lit = lit + "{"
                i += 2
            elif ch == "}" and i + 1 < n and raw[i + 1] == "}":
                lit = lit + "}"
                i += 2
            elif ch == "{":
                if lit != "":
                    parts.append(["const", unescape(lit)])
                    lit = ""
                j: int = i + 1
                while j < n and raw[j] != "}":
                    j += 1
                expr_src: str = raw[i + 1 : j]
                sub_lexer: Lexer = Lexer(expr_src, 0, 1, 0, 0)
                sub_toks: list[Token] = []
                while True:
                    st: Token = sub_lexer.next_token()
                    sub_toks.append(st)
                    if st.kind == TokKind.END:
                        break
                sub_parser: Parser = Parser(sub_toks, 0)
                parts.append(sub_parser.parse_expr())
                i = j + 1
            else:
                lit = lit + ch
                i += 1
        if lit != "":
            parts.append(["const", unescape(lit)])
        if len(parts) == 0:
            return ["const", ""]
        return ["call", ["name", "fmt"], parts, []]

    def parse_pattern(self) -> object:
        t = self.cur()
        # "_" lexes as a NAME, not a keyword
        if t.kind == TokKind.NAME and t.text == "_":
            self.nxt()
            return ["match_as", None, None]
        if t.kind == TokKind.NUM:
            self.nxt()
            return ["match_value", const_num(t)]
        if t.kind == TokKind.STR:
            self.nxt()
            return ["match_value", const_str(t)]
        if t.kind == TokKind.NAME:
            self.nxt()
            # Enum.Member value pattern
            if self.cur().kind == TokKind.OP and self.cur().text == ".":
                self.nxt()
                member = self.expect_kind(TokKind.NAME).text
                return ["match_value", ["attribute", ["name", t.text], member]]
            return ["match_as", None, t.text]
        self.error("unsupported pattern", t)

    def parse_return(self) -> object:
        self.expect("return")
        if self.cur().kind == TokKind.NL:
            self.expect_nl()
            return ["return", None]
        value = self.parse_expr()
        self.expect_nl()
        return ["return", value]

    def parse_raise(self) -> object:
        self.expect("raise")
        value = self.parse_expr()
        self.expect_nl()
        return ["raise", value]

    def parse_del(self) -> object:
        self.expect("del")
        target = self.parse_expr()
        self.expect_nl()
        return ["delete", target]

    def parse_assert(self) -> object:
        self.expect("assert")
        test = self.parse_expr()
        self.expect_nl()
        return ["assert", test]

    # ------------- simple statements / assignment / expr -------------
    def parse_simple_stmt(self) -> object:
        # annotated assignment: NAME ':' anno ['=' expr] - the annotation
        # grammar is unambiguous enough to detect from two tokens
        t = self.cur()
        if (
            t.kind == TokKind.NAME
            and self.toks[self.pos + 1].kind == TokKind.OP
            and self.toks[self.pos + 1].text == ":"
            and t.text not in ("match", "case")
        ):
            name = self.nxt().text
            self.nxt()  # ':'
            anno = self.parse_annotation()
            value = None
            if self.accept("="):
                value = self.parse_expr()
            self.expect_nl()
            return ["ann_assign", name, value, anno]
        expr = self.parse_expr()
        t = self.cur()
        if t.kind == TokKind.OP and t.text in ("=", "+=", "-=", "*=", "/=", "//=", "%="):
            self.nxt()
            value = self.parse_expr()
            self.expect_nl()
            op_map = {"=": None, "+=": "+", "-=": "-", "*=": "*", "/=": "/", "//=": "//", "%=": "%"}
            op = op_map[t.text]
            target = expr
            if target[0] == "name":
                if op is None:
                    return ["assign", target[1], value, None]
                return ["aug_assign", target, t.text, value]
            if target[0] == "subscript":
                if op is None:
                    return ["subscript_assign", target[1], target[2], value]
                return ["subscript_aug_assign", target[1], target[2], t.text, value]
            if target[0] == "attribute":
                if op is None:
                    return ["assign", target, value, None]
                return ["attribute_aug_assign", target[1], target[2], t.text, value]
            if target[0] == "tuple":
                names = [item[1] for item in target[1] if item[0] == "name"]
                return ["tuple_assign", names, value]
            self.error("unsupported assignment target", t)
        self.expect_nl()
        # expression statement: the expression node IS the statement
        return expr

    # ------------- expressions -------------
    def parse_expr(self) -> object:
        # conditional expression: THEN if COND else ELSE
        value = self.parse_or()
        t = self.cur()
        if t.kind == TokKind.KW and t.text == "if":
            self.nxt()
            cond = self.parse_or()
            t2 = self.cur()
            if not (t2.kind == TokKind.KW and t2.text == "else"):
                self.error("expected 'else' in conditional expression", t2)
            self.nxt()
            else_val = self.parse_expr()
            return ["if_expr", cond, value, else_val]
        return value

    def parse_or(self) -> object:
        # and/or fold into one n-ary node, like the reference IR
        left = self.parse_and()
        parts = [left]
        while self.accept("or"):
            parts.append(self.parse_and())
        if len(parts) == 1:
            return left
        return ["or"] + parts

    def parse_and(self) -> object:
        left = self.parse_not()
        parts = [left]
        while self.accept("and"):
            parts.append(self.parse_not())
        if len(parts) == 1:
            return left
        return ["and"] + parts

    def parse_not(self) -> object:
        if self.accept("not"):
            return ["not", self.parse_not()]
        return self.parse_compare()

    def parse_compare(self) -> object:
        left = self.parse_bitor()
        t = self.cur()
        if t.kind == TokKind.OP and t.text in ("==", "!=", "<", "<=", ">", ">="):
            self.nxt()
            right = self.parse_bitor()
            return [t.text, left, right]
        if t.kind == TokKind.KW and t.text == "is":
            self.nxt()
            if self.accept("not"):
                return ["is not", left, self.parse_bitor()]
            return ["is", left, self.parse_bitor()]
        if t.kind == TokKind.KW and t.text == "in":
            self.nxt()
            right = self.parse_bitor()
            return ["in", left, right]
        if t.kind == TokKind.KW and t.text == "not":
            self.nxt()
            self.expect("in")
            return ["not in", left, self.parse_bitor()]
        return left

    def parse_bitor(self) -> object:
        left = self.parse_add()
        while self.accept("|"):
            left = ["|", left, self.parse_add()]
        return left

    def parse_add(self) -> object:
        left = self.parse_mul()
        while self.cur().kind == TokKind.OP and (
            self.cur().text == "+" or self.cur().text == "-"
        ):
            op = self.nxt().text
            left = [op, left, self.parse_mul()]
        return left

    def parse_mul(self) -> object:
        left = self.parse_pow()
        while self.cur().kind == TokKind.OP and self.cur().text in (
            "*", "/", "//", "%"
        ):
            op = self.nxt().text
            left = [op, left, self.parse_pow()]
        return left

    def parse_pow(self) -> object:
        base = self.parse_unary()
        if self.accept("**"):
            return ["**", base, self.parse_pow()]
        return base

    def parse_unary(self) -> object:
        t = self.cur()
        # kind check matters: a STR token's text may be "+" or "-"
        if t.kind == TokKind.OP and t.text == "-":
            self.nxt()
            return ["-", self.parse_unary()]
        if t.kind == TokKind.OP and t.text == "+":
            self.nxt()
            return ["+", self.parse_unary()]
        if t.kind == TokKind.OP and t.text == "~":
            self.nxt()
            return ["~", self.parse_unary()]
        return self.parse_postfix()

    def parse_postfix(self) -> object:
        node = self.parse_atom()
        while True:
            if self.accept("("):
                args = []
                kwargs = []
                while not (self.cur().kind == TokKind.OP and self.cur().text == ")"):
                    if self.cur().kind == TokKind.NAME and self.toks[self.pos + 1].text == "=":
                        k = self.nxt().text
                        self.expect("=")
                        kwargs.append((k, self.parse_expr()))
                    else:
                        args.append(self.parse_expr())
                    if not self.accept(","):
                        break
                self.expect(")")
                node = ["call", node, args, kwargs]
            elif self.accept("["):
                if self.accept(":"):
                    # no leading expression: [:hi], [:hi:step], [:]
                    lo = None
                    hi = None
                    step = None
                    if self.cur().text != ":" and self.cur().text != "]":
                        hi = self.parse_expr()
                    if self.accept(":"):
                        if self.cur().text != "]":
                            step = self.parse_expr()
                    self.expect("]")
                    node = ["subscript", node, ["slice", lo, hi, step]]
                else:
                    index = self.parse_expr()
                    if self.accept(":"):
                        lo2 = index
                        hi2 = None
                        step2 = None
                        if self.cur().text != ":" and self.cur().text != "]":
                            hi2 = self.parse_expr()
                        if self.accept(":"):
                            if self.cur().text != "]":
                                step2 = self.parse_expr()
                        self.expect("]")
                        node = ["subscript", node, ["slice", lo2, hi2, step2]]
                    else:
                        self.expect("]")
                        node = ["subscript", node, index]
            elif self.accept("."):
                attr = self.expect_kind(TokKind.NAME).text
                node = ["attribute", node, attr]
            else:
                return node

    def parse_atom(self) -> object:
        t = self.cur()
        if t.kind == TokKind.NUM:
            self.nxt()
            return const_num(t)
        if t.kind == TokKind.STR:
            self.nxt()
            return const_str(t)
        if t.kind == TokKind.FSTR:
            self.nxt()
            return self.parse_fstring(t.text)
        if t.kind == TokKind.NAME:
            self.nxt()
            return ["name", t.text]
        if t.kind == TokKind.KW:
            if t.text == "lambda":
                self.nxt()
                lparams: list[str] = []
                lparams.append(self.expect_kind(TokKind.NAME).text)
                while self.cur().kind == TokKind.OP and self.cur().text == ",":
                    self.nxt()
                    lparams.append(self.expect_kind(TokKind.NAME).text)
                self.expect(":")
                lbody = self.parse_expr()
                return ["lambda", lparams, lbody]
            if t.text == "None":
                self.nxt()
                return ["const", None]
            if t.text == "True":
                self.nxt()
                return ["const", True]
            if t.text == "False":
                self.nxt()
                return ["const", False]
        if self.accept("("):
            if self.accept(")"):
                return ["tuple", ()]
            first = self.parse_expr()
            if self.accept(","):
                items = [first, self.parse_expr()]
                while self.accept(","):
                    if self.cur().text == ")":
                        break
                    items.append(self.parse_expr())
                self.expect(")")
                return ["tuple", items]
            self.expect(")")
            return first
        if self.accept("["):
            items = []
            if self.cur().text != "]":
                items.append(self.parse_expr())
                # list comprehension: [elt for target in iter (if cond)*]
                t = self.cur()
                if t.kind == TokKind.KW and t.text == "for":
                    self.nxt()
                    target = self.expect_kind(TokKind.NAME).text
                    self.expect("in")
                    # iter and filters stop below the conditional-expression
                    # layer: a bare `if` here belongs to the comprehension
                    iter_expr = self.parse_or()
                    conds = []
                    while True:
                        t2 = self.cur()
                        if t2.kind == TokKind.KW and t2.text == "if":
                            self.nxt()
                            conds.append(self.parse_or())
                        else:
                            break
                    self.expect("]")
                    return ["list_comp", items[0],
                            [[["name", target], iter_expr, conds]]]
                while self.accept(","):
                    if self.cur().text == "]":
                        break
                    items.append(self.parse_expr())
            self.expect("]")
            return ["list", items]
        if self.accept("{"):
            items = []
            if self.cur().text != "}":
                k = self.parse_expr()
                self.expect(":")
                v = self.parse_expr()
                items.append((k, v))
                while self.accept(","):
                    if self.cur().text == "}":
                        break
                    k = self.parse_expr()
                    self.expect(":")
                    v = self.parse_expr()
                    items.append((k, v))
            self.expect("}")
            return ["dict", items]
        self.error("unexpected token '" + t.text + "'", t)


# ---------- nested def / lambda hoisting (Rust nested-item) ----------
# Mirrors silu/nested_hoist.py: same mangling, same self-prepend rules,
# same funcref emission. Written only with the dynamic primitives the
# typed backend supports: isinstance / enumerate / append / == / is None.


class HG:
    prefix: str
    cls_name: str
    is_method: bool
    ren_src: list[str]
    ren_dst: list[str]
    counter: int
    globals: list[str]


# ---------- cross-file import expansion (Rust mod shape) ----------
# import foo: foo.si next to the source is parsed, its own imports
# expanded, and its top-level statements spliced in at the import
# position; foo.X references rewrite to the plain name X afterwards.
# Each file is inlined once; a cycle or a missing module that shadows
# no builtin aborts with a message. Unresolvable names (os, sys, ...)
# keep their import node untouched.


def fe_drop_tail(xs: object) -> object:
    out = []
    n: object = dyn_len(xs)
    for i, x in enumerate(xs):
        if i + 1 < n:
            out.append(x)
    return out


def fe_collect_exports(stmts: object) -> object:
    out = []
    for i, st in enumerate(stmts):
        if hoist_is_node(st):
            op: object = dyn_head(st)
            if op == "func_def" or op == "class_def":
                out.append(dyn_get(st, 1))
            elif op == "assign" or op == "ann_assign":
                if isinstance(dyn_get(st, 1), str):
                    out.append(dyn_get(st, 1))
    return out


def fe_expand_imports(mod: object, seen: list[str], stack: list[str], alias_names: list[str], alias_exports: object) -> object:
    stmts = dyn_get(mod, 1)
    out = []
    for i, st in enumerate(stmts):
        if hoist_is_node(st) and dyn_head(st) == "import":
            pairs = dyn_get(st, 1)
            kept = []
            dropped: bool = False
            for j, pr in enumerate(pairs):
                nm: object = dyn_get(pr, 0)
                path: str = nm + ".si"
                if file_exists(path):
                    if not dropped:
                        dropped = True
                        if dyn_len(out) > 0 and hoist_is_node(dyn_get(out, dyn_len(out) - 1)) and dyn_head(dyn_get(out, dyn_len(out) - 1)) == "line":
                            out = fe_drop_tail(out)
                    if hg_in_list(stack, path):
                        print("M4 import error: import cycle through '" + path + "'")
                        raise SystemExit(1)
                    if not hg_in_list(seen, path):
                        seen.append(path)
                        stack.append(path)
                        sub_src: str = read_file(path)
                        sub_parser: Parser = Parser(tokenize(sub_src), 0)
                        sub_mod = sub_parser.parse_module()
                        sub_mod = fe_expand_imports(sub_mod, seen, stack, alias_names, alias_exports)
                        stack = fe_drop_tail(stack)
                        for k, sst in enumerate(dyn_get(sub_mod, 1)):
                            out.append(sst)
                        sub_exports = fe_collect_exports(dyn_get(sub_mod, 1))
                        ai: int = fe_alias_index(alias_names, nm)
                        if ai < 0:
                            alias_names.append(nm)
                            alias_exports.append(sub_exports)
                        else:
                            for m, en in enumerate(sub_exports):
                                if not hg_in_list(dyn_get(alias_exports, ai), en):
                                    dyn_get(alias_exports, ai).append(en)
                else:
                    kept.append(pr)
            if dyn_len(kept) > 0:
                out.append(["import", kept])
        elif hoist_is_node(st) and dyn_head(st) == "from_import":
            fmod: object = dyn_get(st, 1)
            fpath: str = fmod + ".si"
            if file_exists(fpath):
                if dyn_len(out) > 0 and hoist_is_node(dyn_get(out, dyn_len(out) - 1)) and dyn_head(dyn_get(out, dyn_len(out) - 1)) == "line":
                    out = fe_drop_tail(out)
                if hg_in_list(stack, fpath):
                    print("M4 import error: import cycle through '" + fpath + "'")
                    raise SystemExit(1)
                if not hg_in_list(seen, fpath):
                    seen.append(fpath)
                    stack.append(fpath)
                    fsrc: str = read_file(fpath)
                    fparser: Parser = Parser(tokenize(fsrc), 0)
                    fmod_ir = fparser.parse_module()
                    fmod_ir = fe_expand_imports(fmod_ir, seen, stack, alias_names, alias_exports)
                    stack = fe_drop_tail(stack)
                    for k2, fst in enumerate(dyn_get(fmod_ir, 1)):
                        out.append(fst)
                    fexports = fe_collect_exports(dyn_get(fmod_ir, 1))
                    fai: int = fe_alias_index(alias_names, fmod)
                    if fai < 0:
                        alias_names.append(fmod)
                        alias_exports.append(fexports)
                    else:
                        for m2, en2 in enumerate(fexports):
                            if not hg_in_list(dyn_get(alias_exports, fai), en2):
                                dyn_get(alias_exports, fai).append(en2)
            else:
                out.append(st)
        else:
            out.append(st)
    return ["module", out]


def fe_alias_index(names: list[str], name: str) -> int:
    i: int = 0
    while i < len(names):
        if names[i] == name:
            return i
        i += 1
    return 0 - 1


def fe_rewrite_aliases(node: object, alias_names: list[str], alias_exports: list) -> object:
    if hoist_is_scalar(node):
        return node
    if hoist_is_node(node):
        if dyn_head(node) == "attribute" and dyn_len(node) >= 3:
            base = dyn_get(node, 1)
            if hoist_is_node(base) and dyn_head(base) == "name":
                an: object = dyn_get(base, 1)
                ai: int = fe_alias_index(alias_names, an)
                if ai >= 0 and hg_in_list(dyn_get(alias_exports, ai), dyn_get(node, 2)):
                    return ["name", dyn_get(node, 2)]
        out = [dyn_head(node)]
        for i, c in enumerate(node):
            if i > 0:
                out.append(fe_rewrite_aliases(c, alias_names, alias_exports))
        return out
    out2 = []
    for i, c in enumerate(node):
        out2.append(fe_rewrite_aliases(c, alias_names, alias_exports))
    return out2


def hg_lookup(g: HG, name: str) -> str:
    i: int = 0
    while i < len(g.ren_src):
        if g.ren_src[i] == name:
            return g.ren_dst[i]
        i += 1
    return ""


def hg_empty_strs() -> list[str]:
    out: list[str] = []
    return out


def dyn_get(node: object, k: int) -> object:
    for i, e in enumerate(node):
        if i == k:
            return e
    return None


def dyn_len(node: object) -> int:
    n: int = 0
    for i, e in enumerate(node):
        n += 1
    return n


def dyn_head(node: object) -> object:
    for i, e in enumerate(node):
        return e
    return None


def hoist_is_node(node: object) -> bool:
    # a dynamic list whose head is a string = IR node
    if node is None or not isinstance(node, (list, tuple)):
        return False
    if dyn_len(node) == 0:
        return False
    return isinstance(dyn_head(node), str)


def hoist_is_scalar(node: object) -> bool:
    return isinstance(node, str) or isinstance(node, int) or isinstance(node, float) or isinstance(node, bool) or node is None


def hoist_mentions(node: object, name: str) -> bool:
    if hoist_is_scalar(node):
        return False
    if hoist_is_node(node):
        if dyn_head(node) == "name" and dyn_len(node) == 2 and dyn_get(node, 1) == name:
            return True
    for i, c in enumerate(node):
        if hoist_mentions(c, name):
            return True
    return False


def hg_in_list(names: object, name: str) -> bool:
    for i, n in enumerate(names):
        if n == name:
            return True
    return False


def hoist_calls_one_of(node: object, names: object) -> bool:
    if hoist_is_scalar(node):
        return False
    if hoist_is_node(node) and dyn_head(node) == "call":
        callee = dyn_get(node, 1)
        if hoist_is_node(callee) and dyn_head(callee) == "name":
            if hg_in_list(names, dyn_get(callee, 1)):
                return True
    for i, c in enumerate(node):
        if hoist_calls_one_of(c, names):
            return True
    return False


def hoist_free_names(node: object, out: object) -> int:
    if hoist_is_scalar(node):
        return 0
    if hoist_is_node(node):
        if dyn_head(node) == "name" and dyn_len(node) == 2:
            nm: str = dyn_get(node, 1)
            if not hg_in_list(out, nm):
                out.append(nm)
            return 0
    for i, c in enumerate(node):
        hoist_free_names(c, out)
    return 0


def hoist_insert_self(body: object, needing: object) -> object:
    if hoist_is_scalar(body):
        return body
    if hoist_is_node(body) and dyn_head(body) == "call":
        callee = dyn_get(body, 1)
        if hoist_is_node(callee) and dyn_head(callee) == "name":
            if hg_in_list(needing, dyn_get(callee, 1)):
                args = dyn_get(body, 2)
                new_args = [["name", "self"]]
                for i, a in enumerate(args):
                    new_args.append(hoist_insert_self(a, needing))
                return ["call", callee, new_args, dyn_get(body, 3)]
    if hoist_is_node(body):
        out2 = [dyn_head(body)]
        for j, c in enumerate(body):
            if j > 0:
                out2.append(hoist_insert_self(c, needing))
        return out2
    out = []
    for i, c in enumerate(body):
        out.append(hoist_insert_self(c, needing))
    return out


def hoist_rec(node: object, g: HG, hoisted: object) -> object:
    if hoist_is_scalar(node):
        return node
    op: object = None
    if hoist_is_node(node):
        op = dyn_head(node)
    if op == "func_def":
        mangled: str = g.prefix + "__" + str(dyn_get(node, 1))
        g.ren_src.append(str(dyn_get(node, 1)))
        g.ren_dst.append(mangled)
        body = hoist_rec(dyn_get(node, 3), g, hoisted)
        hoisted.append(["func_def", mangled, dyn_get(node, 2), body, dyn_get(node, 4), dyn_get(node, 5)])
        return None
    if op == "lambda":
        g.counter += 1
        mangled2: str = g.prefix + "__L" + str(g.counter)
        if hoist_mentions(dyn_get(node, 2), "self"):
            print("M4 hoist error: lambda capturing 'self' is not supported; use a nested def")
            raise SystemExit(1)
        lbody = hoist_rec(dyn_get(node, 2), g, hoisted)
        annos = []
        p: int = 0
        while p < dyn_len(dyn_get(node, 1)):
            annos.append(None)
            p += 1
        hoisted.append(["func_def", mangled2, dyn_get(node, 1), [["return", lbody]], annos, None])
        return ["funcref", mangled2]
    if op == "call":
        callee = dyn_get(node, 1)
        if hoist_is_node(callee) and dyn_head(callee) == "name":
            m2: str = hg_lookup(g, str(dyn_get(callee, 1)))
            if m2 != "":
                new_args2 = []
                for i, a in enumerate(dyn_get(node, 2)):
                    new_args2.append(hoist_rec(a, g, hoisted))
                return ["call", ["name", m2], new_args2, dyn_get(node, 3)]
    if hoist_is_node(node):
        out3 = [op]
        for j, c in enumerate(node):
            if j > 0:
                out3.append(hoist_rec(c, g, hoisted))
        return out3
    out4 = []
    for i, c in enumerate(node):
        r2 = hoist_rec(c, g, hoisted)
        if r2 is not None:
            out4.append(r2)
    return out4


def hoist_def(func_def: object, cls_name: str, is_method: bool, global_names: list[str], extra: object) -> object:
    prefix: str = str(dyn_get(func_def, 1))
    if cls_name != "":
        prefix = cls_name + "__" + str(dyn_get(func_def, 1))
    g: HG = HG(prefix, cls_name, is_method, hg_empty_strs(), hg_empty_strs(), 0, global_names)
    hoisted = []
    new_body = hoist_rec(dyn_get(func_def, 3), g, hoisted)

    needing = []
    for i, h in enumerate(hoisted):
        if hoist_mentions(dyn_get(h, 3), "self"):
            needing.append(dyn_get(h, 1))
    changed: bool = True
    while changed:
        changed = False
        for j, h2 in enumerate(hoisted):
            mangled: str = str(dyn_get(h2, 1))
            if not hg_in_list(needing, mangled):
                if hoist_calls_one_of(dyn_get(h2, 3), needing):
                    needing.append(mangled)
                    changed = True

    final = []
    for m, h3 in enumerate(hoisted):
        mangled2: str = str(dyn_get(h3, 1))
        body2 = dyn_get(h3, 3)
        params = dyn_get(h3, 2)
        annos2 = dyn_get(h3, 4)
        if hg_in_list(needing, mangled2):
            body2 = hoist_insert_self(body2, needing)
            cls_anno = None
            if cls_name != "":
                cls_anno = ["name", cls_name]
            new_params = ["self"]
            for v, pv in enumerate(params):
                new_params.append(pv)
            new_annos = [cls_anno]
            for u, av in enumerate(annos2):
                new_annos.append(av)
            h3 = ["func_def", mangled2, new_params, body2, new_annos, dyn_get(h3, 5)]
        free = []
        hoist_free_names(dyn_get(h3, 3), free)
        allowed = []
        for gi, gn in enumerate(global_names):
            allowed.append(gn)
        for ni, nn in enumerate(needing):
            allowed.append(nn)
        for pi, pv2 in enumerate(dyn_get(h3, 2)):
            allowed.append(pv2)
        allowed.append("self")
        for fi, fname in enumerate(free):
            if not hg_in_list(allowed, fname):
                print("M4 hoist error: nested function '" + mangled2 + "' captures '" + str(fname) + "'; pass it as a parameter")
                raise SystemExit(1)
        final.append(h3)

    if is_method and dyn_len(needing) > 0:
        new_body = hoist_insert_self(new_body, needing)
    for q, f2 in enumerate(final):
        extra.append(f2)
    return ["func_def", dyn_get(func_def, 1), dyn_get(func_def, 2), new_body, dyn_get(func_def, 4), dyn_get(func_def, 5)]


def hoist_module(mod: object) -> object:
    stmts = dyn_get(mod, 1)
    global_names: list[str] = ["len", "range", "str", "int", "float", "bool", "print", "fmt", "min", "max", "abs", "input", "enumerate", "isinstance", "read_stdin", "read_file", "ord", "chr", "repr", "tuple", "list", "dict", "set", "type", "sorted", "zip", "map", "sum", "any", "all"]

    for i, st in enumerate(stmts):
        if hoist_is_node(st):
            if dyn_head(st) == "func_def" or dyn_head(st) == "class_def":
                global_names.append(dyn_get(st, 1))
            elif dyn_head(st) == "assign" or dyn_head(st) == "ann_assign":
                global_names.append(dyn_get(st, 1))

    out = []
    for j, st in enumerate(stmts):
        if hoist_is_node(st) and dyn_head(st) == "func_def":
            extra = []
            out.append(hoist_def(st, "", False, global_names, extra))
            for q, e in enumerate(extra):
                out.append(e)
        elif hoist_is_node(st) and dyn_head(st) == "class_def":
            cls_name: str = str(dyn_get(st, 1))
            new_members = []
            extra2 = []
            for k, mm in enumerate(dyn_get(st, 3)):
                if hoist_is_node(mm) and dyn_head(mm) == "func_def":
                    is_m: bool = False
                    mparams = dyn_get(mm, 2)
                    if dyn_len(mparams) > 0 and dyn_get(mparams, 0) == "self":
                        is_m = True
                    new_members.append(hoist_def(mm, cls_name, is_m, global_names, extra2))
                else:
                    new_members.append(mm)
            out.append(["class_def", dyn_get(st, 1), dyn_get(st, 2), new_members])
            for q2, e2 in enumerate(extra2):
                out.append(e2)
        else:
            out.append(st)
    return ["module", out]


# ---------- JSON emission for the IR tuples ----------

def json_emit(node, out: list[str]) -> None:
    if node is None:
        out.append("null")
    elif node is True:
        out.append("true")
    elif node is False:
        out.append("false")
    elif isinstance(node, int):
        out.append(str(node))
    elif isinstance(node, float):
        out.append(str(node))
    elif isinstance(node, str):
        out.append(json_quote(node))
    elif isinstance(node, (list, tuple)):
        out.append("[")
        for i, child in enumerate(node):
            if i:
                out.append(",")
            json_emit(child, out)
        out.append("]")


def json_quote(s: str) -> str:
    out = ['"']
    for ch in s:
        if ch == '"':
            out.append('\\"')
        elif ch == "\\":
            out.append("\\\\")
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\t":
            out.append("\\t")
        elif ch == "\r":
            out.append("\\r")
        elif ord(ch) < 0x20:
            out.append("\\u%04x" % ord(ch))
        else:
            out.append(ch)
    out.append('"')
    return "".join(out)


def json_dumps(node) -> str:
    out: list[str] = []
    json_emit(node, out)
    return "".join(out)


def main() -> int:
    src: str = read_stdin()
    parser: Parser = Parser(tokenize(src), 0)
    module = parser.parse_module()
    seen: list[str] = []
    stack: list[str] = []
    alias_names: list[str] = []
    alias_exports = []
    module = fe_expand_imports(module, seen, stack, alias_names, alias_exports)
    module = fe_rewrite_aliases(module, alias_names, alias_exports)
    print(json_dumps(hoist_module(module)))
    return 0
