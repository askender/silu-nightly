# wat2wasm: a WAT -> wasm64 binary assembler for the exact subset the
# wasm backend emits (silu_host func imports, one memory, globals,
# data segments, named funcs with params/results/locals, folded and
# flat instruction forms, block/loop/if with labels). Input: WAT text
# on stdin. Output: the .wasm binary HEX-ENCODED on stdout (a binary
# stream cannot cross a Silu string - NUL bytes are unrepresentable -
# so the caller decodes 2 hex chars per byte).
#
# f64.const operands are parsed here into a digit accumulator + decimal
# exponent and converted to an IEEE bit pattern by the exact C helper
# shim_dec_bits (`from c import`; linked into every shim-built tool;
# the interpreter planes bind a pure-Python twin via ast_processor).
# Differential oracle: wabt's wat2wasm (byte-identical on the corpus).
#
# Layout note: module-level globals are declared BEFORE the functions
# that use them - the selfhost converter requires textual
# declare-before-use for globals (the Python plane is looser).
from c import shim_dec_bits

# ---------------- tokenizer ----------------
TK_LP = 0
TK_RP = 1
TK_ATOM = 2
TK_STR = 3
T_KIND: list[int] = []
T_TXT: list[str] = []

# ---------------- module model ----------------
IMP_MOD: list[str] = []
IMP_NM: list[str] = []
IMP_SIG: list[str] = []
FN_NAME: list[str] = []
FN_SIG: list[str] = []
FN_B0: list[int] = []
FN_B1: list[int] = []
FN_PN: list[str] = []
FN_LT: list[str] = []
FN_LN: list[str] = []
GN_NAME: list[str] = []
GN_MUT: list[int] = []
GN_TY: list[str] = []
GN_INITK: list[int] = []
GN_INITV: list[int] = []
GN_INITF: list[str] = []
# list cell: structure() runs inside a function, and a bare assignment
# would shadow the module global as a local (Silu CPython-style scoping)
# - emit_all would then read the stale default 1 (latent: the backend
# hardcodes (memory i64 1), so the corpus never exercised it)
MEMC: list[int] = [1]
MEM_HAS: list[int] = [0]
EXP_NM: list[str] = []
EXP_KIND: list[int] = []
EXP_IDX: list[int] = []
DAT_OFF: list[int] = []
DAT_SP: list[int] = []
DAT_SL: list[int] = []
TYPES: list[str] = []
NAME_I: list[str] = []
NAME_V: list[int] = []
LSTK: list[str] = []
NI: list[int] = [0]

# ---------------- output buffer (hex text) ----------------
OH: list[str] = [""]
OS: list[str] = [""]
HEX: list[str] = ["0123456789abcdef"]

# ---------------- op table ----------------
OPN: list[str] = []
OPC: list[int] = []
OPE: list[int] = []


SEMI: str = chr(59)
QT: str = chr(34)
BS: str = chr(92)


def is_space(c: str) -> int:
    if c == " " or c == "\n" or c == "\t" or c == "\r":
        return 1
    return 0


def tokenize(s: str) -> int:
    # line-based: reading a list[str] element copies the WHOLE string
    # (str value semantics), so per-char reads of the full source leak
    # O(n^2) bytes across a tokenize; splitting once and walking each
    # LINE (small) bounds the leak at O(n * line_len)
    lines: list[str] = s.split("\n")
    nl: str = chr(10)
    li: int = 0
    while li < len(lines):
        ln: str = lines[li]
        n: int = len(ln)
        i: int = 0
        while i < n:
            c: str = ln[i]
            if is_space(c):
                i += 1
                continue
            if c == SEMI and i + 1 < n and ln[i + 1] == SEMI:
                i = n
                continue
            if c == "(":
                T_KIND.append(TK_LP)
                T_TXT.append("(")
                i += 1
                continue
            if c == ")":
                T_KIND.append(TK_RP)
                T_TXT.append(")")
                i += 1
                continue
            if c == QT:
                j: int = i + 1
                while j < n:
                    cj: str = ln[j]
                    if cj == BS:
                        j += 2
                        continue
                    if cj == QT:
                        break
                    j += 1
                T_KIND.append(TK_STR)
                T_TXT.append(ln[i + 1:j])
                i = j + 1
                continue
            j = i
            while j < n:
                cj = ln[j]
                if is_space(cj) or cj == "(" or cj == ")" or cj == QT:
                    break
                j += 1
            T_KIND.append(TK_ATOM)
            T_TXT.append(ln[i:j])
            i = j
        li += 1
    return 0


def tkind(i: int) -> int:
    return T_KIND[i]


def ttext(i: int) -> str:
    return T_TXT[i]


def match_close(i: int) -> int:
    d2: int = 0
    j: int = i
    while True:
        if tkind(j) == TK_LP:
            d2 += 1
        if tkind(j) == TK_RP:
            d2 -= 1
            if d2 == 0:
                return j + 1
        j += 1


def atom_int(t: str) -> int:
    if len(t) == 0:
        return 0
    if t[0:1] == "-":
        return -atom_int(t[1:])
    if t[0:1] == "+":
        return atom_int(t[1:])
    v: int = 0
    i: int = 0
    while i < len(t):
        v = v * 10 + (ord(t[i]) - 48)
        i += 1
    return v


def str_hex(s: str) -> str:
    out: str = ""
    k: int = 0
    while k < len(s):
        out = out + hex2(ord(s[k]))
        k += 1
    return out


def hex2(v: int) -> str:
    h: str = HEX[0]
    c1: str = h[v // 16]
    c2: str = h[v % 256 % 16]
    return c1 + c2


def uleb_hex(v: int) -> str:
    # negative indices must never reach here (invalid wasm); emit one
    # zero byte so the module fails VALIDATION loudly downstream
    if v < 0:
        return "00"
    out: str = ""
    h: str = HEX[0]
    while True:
        b: int = v % 128
        v = v // 128
        if v != 0:
            b = b + 128
        c1: str = h[b // 16]
        c2: str = h[b % 256 % 16]
        out = out + c1 + c2
        if v == 0:
            return out


def sleb_hex(v: int) -> str:
    # canonical signed LEB128: Python floor-mod gives the 7-bit payload
    # directly and floor-div is the arithmetic shift; terminal when the
    # remainder is the sign extension of the emitted payload
    out: str = ""
    h: str = HEX[0]
    while True:
        b: int = v % 128
        v = v // 128
        more: int = not ((v == 0 and b < 64) or (v == -1 and b >= 64))
        byte: int = b
        if more:
            byte = byte + 128
        c1: str = h[byte // 16]
        c2: str = h[byte % 256 % 16]
        out = out + c1 + c2
        if not more:
            return out


def f64_hex(text: str) -> str:
    t: str = text
    neg: int = 0
    if len(t) > 0 and t[0:1] == "-":
        neg = 1
        t = t[1:]
    elif len(t) > 0 and t[0:1] == "+":
        t = t[1:]
    ip: str = ""
    fp: str = ""
    ex: int = 0
    i: int = 0
    nd: int = len(t)
    while i < nd:
        c: str = t[i]
        if c == ".":
            j: int = i + 1
            while j < nd and t[j] != "e":
                fp = fp + t[j]
                j += 1
            i = j
            continue
        if c == "e":
            ex = atom_int(t[i + 1:nd])
            i = nd
            continue
        ip = ip + c
        i += 1
    if ip == "":
        ip = "0"
    D: int = atom_int(ip + fp)
    etot: int = ex - len(fp)
    bits: int = shim_dec_bits(D, etot, neg)
    out: str = ""
    h: str = HEX[0]
    k: int = 0
    while k < 8:
        byte: int = bits % 256
        c1: str = h[byte // 16]
        c2: str = h[byte % 256 % 16]
        out = out + c1 + c2
        bits = bits // 256
        k += 1
    return out


def name_lookup(nm: str) -> int:
    i: int = 0
    while i < len(NAME_I):
        if NAME_I[i] == nm:
            return NAME_V[i]
        i += 1
    return -1


def name_add(nm: str, v: int) -> int:
    NAME_I.append(nm)
    NAME_V.append(v)
    return 0


def type_index(sig: str) -> int:
    i: int = 0
    while i < len(TYPES):
        if TYPES[i] == sig:
            return i
        i += 1
    TYPES.append(sig)
    return len(TYPES) - 1


def ty_byte(ty: str) -> int:
    if ty == "i32":
        return 127
    if ty == "f64":
        return 124
    return 126


def sig_add_p(sig: str, ty: str) -> str:
    # sig format: "p(<t1,t2>)]r(<r>)" - insert before the ")]" close
    i: int = sig.find(")]")
    sep: str = ""
    if i > 2:
        sep = ","
    return sig[:i] + sep + ty + sig[i:]


# ---------------- pass A: structure ----------------
def structure() -> int:
    depth: int = 0
    i: int = 0
    ntok: int = len(T_KIND)
    nfun: int = 0
    while i < ntok:
        k: int = tkind(i)
        if k == TK_LP:
            if depth == 0:
                # the module form itself: step inside
                depth += 1
                i += 1
                continue
            if depth == 1:
                head: str = ttext(i + 1)
                j: int = match_close(i)
                if head == "import":
                    imod: str = ttext(i + 2)
                    inm: str = ttext(i + 3)
                    sig: str = "p()]r()"
                    nm2: str = ""
                    k2: int = i + 4
                    while k2 < j:
                        if tkind(k2) == TK_LP and ttext(k2 + 1) == "func":
                            m2: int = k2 + 2
                            if tkind(m2) == TK_ATOM and ttext(m2)[0:1] == "$":
                                nm2 = ttext(m2)
                                m2 += 1
                            while m2 < j:
                                h2: str = ttext(m2)
                                if h2 == "param":
                                    m2 += 1
                                    while m2 < j and tkind(m2) == TK_ATOM:
                                        w: str = ttext(m2)
                                        if w == "i64" or w == "i32" or w == "f64":
                                            sig = sig_add_p(sig, w)
                                        m2 += 1
                                    continue
                                if h2 == "result":
                                    m2 += 1
                                    sig = sig[:sig.find(")]") + 2] + "r(" + ttext(m2) + ")"
                                    m2 += 1
                                    continue
                                m2 += 1
                            break
                        k2 += 1
                    IMP_MOD.append(imod)
                    IMP_NM.append(inm)
                    IMP_SIG.append(sig)
                    name_add(nm2, len(IMP_MOD) - 1)
                elif head == "memory":
                    MEM_HAS[0] = 1
                    MEMC[0] = atom_int(ttext(i + 3))
                elif head == "global":
                    gnm: str = ttext(i + 2)
                    mut: int = 0
                    # (global $n TYPE ...) or (global $n (mut TYPE) ...)
                    ty: str = ""
                    if ttext(i + 4) == "mut":
                        mut = 1
                        ty = ttext(i + 5)
                    else:
                        ty = ttext(i + 3)
                    initk: int = 0
                    initv: int = 0
                    initf: str = ""
                    # init is the last inner form: opcode j-4, value j-3
                    # (j is one past the global form's RP; the const form
                    # has its own closing RP between VALUE and the end)
                    h3: str = ttext(j - 4)
                    if h3 == "f64.const":
                        initk = 2
                        initf = ttext(j - 3)
                    else:
                        initk = 1
                        initv = atom_int(ttext(j - 3))
                    GN_NAME.append(gnm)
                    GN_MUT.append(mut)
                    GN_TY.append(ty)
                    GN_INITK.append(initk)
                    GN_INITV.append(initv)
                    GN_INITF.append(initf)
                    name_add(gnm, len(GN_NAME) - 1)
                elif head == "export":
                    enm: str = ttext(i + 2)
                    kindt: str = ttext(i + 4)
                    ek: int = 0
                    idx: int = 0
                    if kindt == "memory":
                        ek = 2
                    elif kindt == "func":
                        ek = 0
                    idx = atom_int(ttext(i + 5))
                    EXP_NM.append(enm)
                    EXP_KIND.append(ek)
                    EXP_IDX.append(idx)
                elif head == "data":
                    off: int = atom_int(ttext(i + 4))
                    DAT_OFF.append(off)
                    DAT_SP.append(i + 6)
                    DAT_SL.append(len(T_TXT[i + 6]))
                elif head == "func":
                    fnm: str = ""
                    fe: str = ""
                    sig: str = "p()]r()"
                    pn: list[str] = []
                    ln: list[str] = []
                    lt: list[str] = []
                    k2: int = i + 2
                    if tkind(k2) == TK_ATOM and ttext(k2)[0:1] == "$":
                        fnm = ttext(k2)
                        k2 += 1
                    while tkind(k2) == TK_LP:
                        h2: str = ttext(k2 + 1)
                        if h2 == "export":
                            fe = ttext(k2 + 2)
                            k2 = match_close(k2)
                            continue
                        if h2 == "param":
                            m2: int = k2 + 2
                            while m2 < j and tkind(m2) == TK_ATOM:
                                w: str = ttext(m2)
                                if w == "i64" or w == "i32" or w == "f64":
                                    sig = sig_add_p(sig, w)
                                    if m2 > k2 + 2 and tkind(m2 - 1) == TK_ATOM and ttext(m2 - 1)[0:1] == "$":
                                        pn.append(ttext(m2 - 1))
                                m2 += 1
                            k2 = match_close(k2)
                            continue
                        if h2 == "result":
                            m3: int = k2 + 2
                            sig = sig[:sig.find(")]") + 2] + "r(" + ttext(m3) + ")"
                            k2 += 4
                            continue
                        if h2 == "local":
                            if tkind(k2 + 2) == TK_ATOM and ttext(k2 + 2)[0:1] == "$":
                                lt.append(ttext(k2 + 3))
                                ln.append(ttext(k2 + 2))
                            k2 = match_close(k2)
                            continue
                        break
                    FN_NAME.append(fnm)
                    FN_SIG.append(sig)
                    FN_B0.append(k2)
                    FN_B1.append(j)
                    FN_PN.append(",".join(pn))
                    FN_LT.append(",".join(lt))
                    FN_LN.append(",".join(ln))
                    fidx: int = len(IMP_MOD) + nfun
                    name_add(fnm, fidx)
                    if fe != "":
                        EXP_NM.append(fe)
                        EXP_KIND.append(0)
                        EXP_IDX.append(fidx)
                    nfun += 1
            # top-level forms are skipped whole: their contents are
            # never walked at depth 2 (the arms above may return early)
            i = match_close(i)
            continue
        if k == TK_RP:
            depth -= 1
        i += 1
    return 0


# ---------------- op table ----------------
OPN: list[str] = []
OPC: list[int] = []
OPE: list[int] = []


