    return 0


def op_code(name: str) -> int:
    i: int = 0
    while i < len(OPN):
        if OPN[i] == name:
            return i
        i += 1
    return -1


# ---------------- body emission (hex string, post-order) ----------------
LSTK: list[str] = []
NI: list[int] = [0]


def local_scan_idx(csv: str, nm: str) -> int:
    idx: int = -1
    pos: int = 0
    c: int = 0
    start: int = 0
    while c <= len(csv):
        if c == len(csv) or csv[c] == ",":
            if csv[start:c] == nm:
                idx = pos
            pos += 1
            start = c + 1
        c += 1
    return idx


def csv_count(csv: str) -> int:
    if len(csv) == 0:
        return 0
    n: int = 1
    c: int = 0
    while c < len(csv):
        if csv[c] == ",":
            n += 1
        c += 1
    return n


def emit_form(i: int, fi: int) -> str:
    # folded WAT is POST-ORDER: operands push first, the opcode (with
    # its immediates) last - block/loop/if are the only pre-order
    # forms; the if's condition comes before the 0x04 header
    if tkind(i) == TK_ATOM:
        # bare atom instruction (zero-operand opcode written unfolded,
        # e.g. `unreachable` directly inside a folded then): emit just
        # its opcode; operand-bearing opcodes get the default immediate
        a: str = ttext(i)
        oi2: int = op_code(a)
        NI[0] = i + 1
        if oi2 < 0:
            return "00"
        if OPE[oi2] >= 0:
            return hex2(OPC[oi2]) + "00"
        return hex2(OPC[oi2])
    op: str = ttext(i + 1)
    if op == "block" or op == "loop":
        j: int = i + 2
        lbl: str = ""
        if tkind(j) == TK_ATOM and ttext(j)[0:1] == "$":
            lbl = ttext(j)
            j += 1
        s: str = ""
        if op == "block":
            s = s + "02"
        else:
            s = s + "03"
        # optional (result T) form sets the blocktype byte
        bt: str = "40"
        if tkind(j) == TK_LP and ttext(j + 1) == "result":
            bt = hex2(ty_byte(ttext(j + 2)))
            j = match_close(j)
        s = s + bt
        LSTK.append(lbl)
        parts: list[str] = []
        while tkind(j) != TK_RP:
            parts.append(emit_form(j, fi))
            j = NI[0]
        LSTK.pop()
        NI[0] = j + 1
        return s + "".join(parts) + "0B"
    if op == "if":
        j: int = i + 2
        lbl: str = ""
        if tkind(j) == TK_ATOM and ttext(j)[0:1] == "$":
            lbl = ttext(j)
            j += 1
        cond_parts: list[str] = []
        # optional (result T) form sets the if blocktype byte
        bt: str = "40"
        if tkind(j) == TK_LP and ttext(j + 1) == "result":
            bt = hex2(ty_byte(ttext(j + 2)))
            j = match_close(j)
        while not (tkind(j) == TK_LP and ttext(j + 1) == "then"):
            cond_parts.append(emit_form(j, fi))
            j = NI[0]
        LSTK.append(lbl)
        then_parts: list[str] = []
        else_parts: list[str] = []
        in_else: int = 0
        # pd counts wrapper markers we skipped manually ((then)/(else)):
        # their closing RP must not be mistaken for the if's own RP -
        # folded forms are consumed whole by emit_form and never touch pd
        pd: int = 0
        while True:
            if tkind(j) == TK_RP:
                if pd == 0:
                    break
                pd -= 1
                j += 1
                continue
            if pd == 0 and tkind(j) == TK_LP and ttext(j + 1) == "then":
                pd += 1
                j += 2
                continue
            if pd == 0 and tkind(j) == TK_LP and ttext(j + 1) == "else":
                pd += 1
                in_else = 1
                j += 2
                continue
            if tkind(j) == TK_LP:
                seg: str = emit_form(j, fi)
                j = NI[0]
            else:
                # bare atom instruction (e.g. `unreachable`): emit it too
                seg = emit_form(j, fi)
                j = NI[0]
            if in_else:
                else_parts.append(seg)
            else:
                then_parts.append(seg)
            continue
        LSTK.pop()
        NI[0] = j + 1
        out: str = "".join(cond_parts) + "04" + bt + "".join(then_parts)
        # an EMPTY else normalizes away: wabt emits no 05..end pair
        if in_else and len(else_parts) > 0:
            out = out + "05" + "".join(else_parts)
        return out + "0B"
    if op == "then" or op == "else":
        j: int = i + 2
        while tkind(j) != TK_RP:
            emit_form(j, fi)
            j = NI[0]
        NI[0] = j + 1
        return ""
    if op == "call":
        arg_parts: list[str] = []
        j: int = i + 3
        while tkind(j) != TK_RP:
            arg_parts.append(emit_form(j, fi))
            j = NI[0]
        nm: str = ttext(i + 2)
        cidx: int = 0
        if nm[0:1] == "$":
            cidx = name_lookup(nm)
        else:
            cidx = atom_int(nm)
        NI[0] = j + 1
        return "".join(arg_parts) + "10" + uleb_hex(cidx)
    if op == "br":
        lbl: str = ttext(i + 2)
        dep: int = 0
        if lbl[0:1] == "$":
            top: int = len(LSTK) - 1
            d: int = top
            while d >= 0:
                if LSTK[d] == lbl:
                    break
                d -= 1
            dep = top - d
        else:
            dep = atom_int(lbl)
        NI[0] = match_close(i)
        return "0C" + uleb_hex(dep)
    if op == "br_if":
        cond_parts: list[str] = []
        j: int = i + 3
        while tkind(j) != TK_RP:
            cond_parts.append(emit_form(j, fi))
            j = NI[0]
        lbl: str = ttext(i + 2)
        dep: int = 0
        if lbl[0:1] == "$":
            top: int = len(LSTK) - 1
            d: int = top
            while d >= 0:
                if LSTK[d] == lbl:
                    break
                d -= 1
            dep = top - d
        else:
            dep = atom_int(lbl)
        NI[0] = j + 1
        return "".join(cond_parts) + "0D" + uleb_hex(dep)
    if op == "br_table":
        # (br_table $l0 $l1 ... $lN EXPR): label tokens first (the last
        # one is the default), then the index value expression. Binary:
        # 0x0E, vec of the N table labels, the default, then the value.
        lbl_parts: list[str] = []
        j: int = i + 2
        while tkind(j) != TK_RP and ttext(j)[0:1] == "$":
            nm3: str = ttext(j)
            top3: int = len(LSTK) - 1
            d3: int = top3
            while d3 >= 0:
                if LSTK[d3] == nm3:
                    break
                d3 -= 1
            lbl_parts.append(uleb_hex(top3 - d3))
            j += 1
        val_parts: list[str] = []
        while tkind(j) != TK_RP:
            val_parts.append(emit_form(j, fi))
            j = NI[0]
        NI[0] = j + 1
        ntab: int = len(lbl_parts) - 1
        out3: str = "0E" + uleb_hex(ntab)
        p3: int = 0
        while p3 < ntab:
            out3 += lbl_parts[p3]
            p3 += 1
        out3 += lbl_parts[ntab]
        # the index value must hit the stack BEFORE the br_table opcode
        # (same order as br_if: operand bytes first)
        return "".join(val_parts) + out3
    if op == "i64.const":
        NI[0] = match_close(i)
        return "42" + sleb_hex(atom_int(ttext(i + 2)))
    if op == "i32.const":
        NI[0] = match_close(i)
        return "41" + sleb_hex(atom_int(ttext(i + 2)))
    if op == "f64.const":
        NI[0] = match_close(i)
        return "44" + f64_hex(ttext(i + 2))
    if op == "local.get":
        nm: str = ttext(i + 2)
        idx: int = 0
        if nm[0:1] == "$":
            idx = local_scan_idx(FN_PN[fi], nm)
            if idx == -1:
                idx = csv_count(FN_PN[fi]) + local_scan_idx(FN_LN[fi], nm)
        else:
            idx = atom_int(nm)
        NI[0] = match_close(i)
        return "20" + uleb_hex(idx)
    if op == "local.set" or op == "local.tee":
        val_parts: list[str] = []
        j: int = i + 3
        while tkind(j) != TK_RP:
            val_parts.append(emit_form(j, fi))
            j = NI[0]
        nm: str = ttext(i + 2)
        idx: int = 0
        if nm[0:1] == "$":
            idx = local_scan_idx(FN_PN[fi], nm)
            if idx == -1:
                idx = csv_count(FN_PN[fi]) + local_scan_idx(FN_LN[fi], nm)
        else:
            idx = atom_int(nm)
        NI[0] = j + 1
        joined: str = "".join(val_parts)
        if op == "local.set":
            return joined + "21" + uleb_hex(idx)
        return joined + "22" + uleb_hex(idx)
    if op == "global.get":
        nm: str = ttext(i + 2)
        gidx: int = 0
        if nm[0:1] == "$":
            gidx = name_lookup(nm)
        else:
            gidx = atom_int(nm)
        NI[0] = match_close(i)
        return "23" + uleb_hex(gidx)
    if op == "global.set":
        val_parts: list[str] = []
        j: int = i + 3
        while tkind(j) != TK_RP:
            val_parts.append(emit_form(j, fi))
            j = NI[0]
        nm: str = ttext(i + 2)
        gidx: int = 0
        if nm[0:1] == "$":
            gidx = name_lookup(nm)
        else:
            gidx = atom_int(nm)
        NI[0] = j + 1
        return "".join(val_parts) + "24" + uleb_hex(gidx)
    if op == "memory.size":
        NI[0] = match_close(i)
        return "3F00"
    if op == "memory.grow":
        val_parts: list[str] = []
        j: int = i + 2
        while tkind(j) != TK_RP:
            val_parts.append(emit_form(j, fi))
            j = NI[0]
        NI[0] = j + 1
        return "".join(val_parts) + "4000"
    if op == "memory.copy":
        ops_parts: list[str] = []
        j: int = i + 2
        while tkind(j) != TK_RP:
            ops_parts.append(emit_form(j, fi))
            j = NI[0]
        NI[0] = j + 1
        return "".join(ops_parts) + "FC0A0000"
    oi: int = op_code(op)
    if oi < 0:
        NI[0] = match_close(i)
        return "00"
    ops_parts: list[str] = []
    j: int = i + 2
    while tkind(j) != TK_RP:
        ops_parts.append(emit_form(j, fi))
        j = NI[0]
    NI[0] = j + 1
    im: str = ""
    if OPE[oi] >= 0:
        im = hex2(OPE[oi]) + "00"
    return "".join(ops_parts) + hex2(OPC[oi]) + im


# ---------------- section emission ----------------
def emit_section(secid: int) -> int:
    OH[0] = OH[0] + hex2(secid) + uleb_hex(len(OS[0]) // 2) + OS[0]
    OS[0] = ""
    return 0


def emit_all() -> int:
    OH[0] = "0061736D01000000"
    # types first-use order: imports, then functions
    ii: int = 0
    while ii < len(IMP_SIG):
        type_index(IMP_SIG[ii])
        ii += 1
    fi: int = 0
    while fi < len(FN_SIG):
        type_index(FN_SIG[fi])
        fi += 1
    # type section (1)
    OS[0] = ""
    OS[0] = OS[0] + uleb_hex(len(TYPES))
    ti: int = 0
    while ti < len(TYPES):
        OS[0] = OS[0] + "60"
        sig: str = TYPES[ti]
        pint: int = sig.find(")]r(")
        plist: str = sig[2:pint]
        rlist: str = sig[pint + 4:len(sig) - 1]
        cnt: int = 0
        c: int = 0
        while c < len(plist):
            if plist[c] == ",":
                cnt += 1
            c += 1
        if len(plist) > 0:
            cnt += 1
        OS[0] = OS[0] + uleb_hex(cnt)
        c = 0
        while c < len(plist):
            if plist[c] != ",":
                OS[0] = OS[0] + hex2(ty_byte(plist[c:c + 3]))
                c += 3
            else:
                c += 1
        if len(rlist) > 0:
            OS[0] = OS[0] + uleb_hex(1) + hex2(ty_byte(rlist))
        else:
            OS[0] = OS[0] + uleb_hex(0)
        ti += 1
    emit_section(1)
    # import section (2)
    if len(IMP_SIG) > 0:
        OS[0] = ""
        OS[0] = OS[0] + uleb_hex(len(IMP_SIG))
        ii = 0
        while ii < len(IMP_SIG):
            OS[0] = OS[0] + uleb_hex(len(IMP_MOD[ii])) + str_hex(IMP_MOD[ii])
            OS[0] = OS[0] + uleb_hex(len(IMP_NM[ii])) + str_hex(IMP_NM[ii])
            OS[0] = OS[0] + "00" + uleb_hex(type_index(IMP_SIG[ii]))
            ii += 1
        emit_section(2)
    # function section (3)
    if len(FN_NAME) > 0:
        OS[0] = ""
        OS[0] = OS[0] + uleb_hex(len(FN_NAME))
        fi = 0
        while fi < len(FN_NAME):
            OS[0] = OS[0] + uleb_hex(type_index(FN_SIG[fi]))
            fi += 1
        emit_section(3)
    # memory section (5): only when the WAT declares a memory
    # payload = mem-count (1) + limits (flags 0x04 = i64 index, min)
    if MEM_HAS[0] == 1:
        OS[0] = "01" + "04" + uleb_hex(MEMC[0])
        emit_section(5)
    # global section (6)
    if len(GN_NAME) > 0:
        OS[0] = ""
        OS[0] = OS[0] + uleb_hex(len(GN_NAME))
        gi: int = 0
        while gi < len(GN_NAME):
            OS[0] = OS[0] + hex2(ty_byte(GN_TY[gi])) + hex2(GN_MUT[gi])
            if GN_INITK[gi] == 1:
                # integer init: opcode follows the declared type
                if GN_TY[gi] == "i32":
                    OS[0] = OS[0] + "41" + sleb_hex(GN_INITV[gi])
                else:
                    OS[0] = OS[0] + "42" + sleb_hex(GN_INITV[gi])
            else:
                OS[0] = OS[0] + "44" + f64_hex(GN_INITF[gi])
            OS[0] = OS[0] + "0B"
            gi += 1
        emit_section(6)
    # export section (7)
    if len(EXP_NM) > 0:
        OS[0] = ""
        OS[0] = OS[0] + uleb_hex(len(EXP_NM))
        xi: int = 0
        while xi < len(EXP_NM):
            OS[0] = OS[0] + uleb_hex(len(EXP_NM[xi])) + str_hex(EXP_NM[xi])
            OS[0] = OS[0] + hex2(EXP_KIND[xi]) + uleb_hex(EXP_IDX[xi])
            xi += 1
        emit_section(7)
    # code section (10)
    if len(FN_NAME) > 0:
        OS[0] = ""
        OS[0] = OS[0] + uleb_hex(len(FN_NAME))
        fi = 0
        while fi < len(FN_NAME):
            emit_body(fi)
            fi += 1
        emit_section(10)
    # data section (11)
    if len(DAT_OFF) > 0:
        OS[0] = ""
        OS[0] = OS[0] + uleb_hex(len(DAT_OFF))
        di: int = 0
        while di < len(DAT_OFF):
            OS[0] = OS[0] + "0042" + sleb_hex(DAT_OFF[di]) + "0B"
            # the data token text is stored verbatim in T_TXT: walks hit
            # the (small) token, not the whole source
            dat: str = T_TXT[DAT_SP[di]]
            sl: int = DAT_SL[di]
            k: int = 0
            nb: int = 0
            while k < sl:
                if dat[k:k + 1] == BS:
                    # escape = backslash + 2 hex chars = 3 source chars
                    nb += 1
                    k += 3
                else:
                    nb += 1
                    k += 1
            OS[0] = OS[0] + uleb_hex(nb)
            k = 0
            while k < sl:
                if dat[k:k + 1] == BS:
                    OS[0] = OS[0] + dat[k + 1:k + 3]
                    k += 3
                else:
                    ch: str = dat[k:k + 1]
                    OS[0] = OS[0] + hex2(ord(ch))
                    k += 1
            di += 1
        emit_section(11)
    return 0


def emit_body(fi: int) -> int:
    keep: str = OS[0]
    OS[0] = ""
    # locals: (local $nm ty)* head forms, coalesced into runs
    runs: list[str] = []
    cnt: list[int] = []
    lts: str = FN_LT[fi]
    if lts != "":
        c: int = 0
        start: int = 0
        while c <= len(lts):
            if c == len(lts) or lts[c] == ",":
                ty: str = lts[start:c]
                k: int = len(runs)
                if k > 0 and runs[k - 1] == ty:
                    cnt[k - 1] += 1
                else:
                    runs.append(ty)
                    cnt.append(1)
                start = c + 1
            c += 1
    OS[0] = OS[0] + uleb_hex(len(runs))
    k = 0
    while k < len(runs):
        OS[0] = OS[0] + uleb_hex(cnt[k]) + hex2(ty_byte(runs[k]))
        k += 1
    acc_parts: list[str] = []
    j: int = FN_B0[fi]
    while tkind(j) != TK_RP:
        acc_parts.append(emit_form(j, fi))
        j = NI[0]
    acc_parts.append("0B")
    bodyhex: str = OS[0] + "".join(acc_parts)
    OS[0] = keep
    OS[0] = OS[0] + uleb_hex(len(bodyhex) // 2) + bodyhex
    return 0


def main() -> int:
    src: str = read_stdin()
    tokenize(src)
    structure()
    op_init()
    emit_all()
    print(OH[0])
    return 0
