# L2 milestone: a WASM backend for the Silu IR (int/float/str/list[int]
# subset). Pipeline: read IR JSON from stdin -> emit WAT to stdout ->
# wat2wasm (memory64 is default-on in wabt >= 1.0.38) -> the program
# runs under any wasm64 host (the playground's silu_host shim; print
# goes through the write import, floats through fmt_double repr).
# Differential targets: wasm/examples/*.si vs CPython.
# Semantics mirrored from CPython:
# - ints are i64 locals, floats f64, strs i64 pointers to NUL-terminated
#   UTF-8 in linear memory, list[int] a (ptr,len,cap) struct
# - // and % are FLOOR semantics (sign-correction over the truncating
#   i64 ops); ** squaring skips the dead final square; / always float
# - str len() counts CODE POINTS (byte scan skipping continuations);
#   comparisons are byte order (== codepoint order for UTF-8)
# Unsupported nodes evaluate to 0 (documented gap model, like
# ir_interp). Supported: const (int/float/bool/str), name, assign/
# ann_assign/aug_assign, binops, compare, if, while, for(list),
# call (print/str/len/float/user functions), func_def, return,
# subscript read/write on lists, attribute append.

from __future__ import annotations


class JKind(Enum):
    NIL = 0
    BOOL = 1
    NUM = 2
    STR = 3
    ARR = 4
    OBJ = 5
    FLOAT = 6


class JValue:
    kind: JKind
    b: bool
    n: int
    d: float
    s: str
    arr: list[JValue]
    key: str
    nxt: JValue


class Json:
    src: str
    pos: int

    def ws(self) -> int:
        while self.pos < len(self.src):
            ch = self.src[self.pos]
            if ch == " " or ch == "\n" or ch == "\t" or ch == "\r":
                self.pos += 1
            else:
                return 0

    def value(self) -> JValue:
        self.ws()
        ch = self.src[self.pos]
        if ch == "[":
            return self.array()
        if ch == '"':
            return jstr(self.string())
        if ch == "t":
            self.pos += 4
            return jbool(True)
        if ch == "f":
            self.pos += 5
            return jbool(False)
        if ch == "n":
            self.pos += 4
            return jnull()
        return self.number()

    def array(self) -> JValue:
        items: list[JValue] = []
        self.pos += 1
        while True:
            self.ws()
            if self.src[self.pos] == "]":
                self.pos += 1
                return jarr(items)
            items.append(self.value())
            self.ws()
            if self.src[self.pos] == ",":
                self.pos += 1

    def string(self) -> str:
        self.pos += 1
        out: str = ""
        while self.src[self.pos] != '"':
            ch = self.src[self.pos]
            if ch == "\\":
                self.pos += 1
                e = self.src[self.pos]
                if e == "n":
                    out = out + "\n"
                elif e == "t":
                    out = out + "\t"
                elif e == "u":
                    self.pos += 1
                    code: int = 0
                    k: int = 0
                    while k < 4:
                        h = self.src[self.pos]
                        self.pos += 1
                        code = code * 16
                        if h >= "0" and h <= "9":
                            code += ord(h) - ord("0")
                        elif h >= "a" and h <= "f":
                            code += ord(h) - ord("a") + 10
                        else:
                            code += ord(h) - ord("A") + 10
                        k += 1
                    self.pos -= 1
                    out = out + chr(code)
                else:
                    out = out + e
                self.pos += 1
            else:
                out = out + ch
                self.pos += 1
        self.pos += 1
        return out

    def number(self) -> JValue:
        start: int = self.pos
        neg: bool = False
        if self.src[self.pos] == "-":
            neg = True
            self.pos += 1
        isf: bool = False
        while self.pos < len(self.src):
            ch = self.src[self.pos]
            if ch >= "0" and ch <= "9":
                self.pos += 1
            elif ch == "." or ch == "e" or ch == "E" or ch == "+" or ch == "-":
                if ch == "+" or ch == "-":
                    prev = self.src[self.pos - 1]
                    if prev != "e" and prev != "E":
                        break
                isf = isf or ch == "." or ch == "e" or ch == "E"
                self.pos += 1
            else:
                break
        text: str = self.src[start:self.pos]
        if neg:
            text = "-" + text
        if isf:
            f: float = float(text)
            return JValue(JKind.FLOAT, False, 0, f, text, None, "", None)
        n: int = 0
        k: int = 0
        while k < len(text):
            n = n * 10 + (ord(text[k]) - 48)
            k += 1
        return jnum(n)


def jbool(v: bool) -> JValue:
    return JValue(JKind.BOOL, v, 0, 0.0, "", None, "", None)


def jnum(v: int) -> JValue:
    return JValue(JKind.NUM, False, v, 0.0, "", None, "", None)


def jfnum(v: float) -> JValue:
    return JValue(JKind.FLOAT, False, 0, v, "", None, "", None)


def jstr(v: str) -> JValue:
    return JValue(JKind.STR, False, 0, 0.0, v, None, "", None)


def jnull() -> JValue:
    return JValue(JKind.NIL, False, 0, 0.0, "", None, "", None)


def jarr(items: list[JValue]) -> JValue:
    return JValue(JKind.ARR, False, 0, 0.0, "", items, "", None)


def tag(node: JValue) -> str:
    return node.arr[0].s


def elem(node: JValue, i: int) -> JValue:
    return node.arr[i]


def elem_str(node: JValue, i: int) -> str:
    return node.arr[i].s


def p2(e: int) -> int:
    r: int = 1
    while e > 0:
        r *= 2
        e -= 1
    return r


def utf8_blen(s: str) -> int:
    n: int = 0
    i: int = 0
    while i < len(s):
        cp = ord(s[i])
        if cp < 0x80:
            n += 1
        elif cp < 0x800:
            n += 2
        elif cp < 0x10000:
            n += 3
        else:
            n += 4
        i += 1
    return n


def str_utf8_escape(s: str) -> str:
    # UTF-8 bytes of s, WAT-escaped: printable ASCII as-is, " and \\
    # backslash-escaped, everything else as \\XX hex
    out: str = ""
    i: int = 0
    while i < len(s):
        cp = ord(s[i])
        n: int = 1
        if cp >= 0x80:
            n = 2
        if cp >= 0x800:
            n = 3
        if cp >= 0x10000:
            n = 4
        k: int = 0
        while k < n:
            sh: int = 6 * (n - 1 - k)
            part: int = cp // p2(sh)
            bv: int = part
            if k == 0:
                if n == 2:
                    bv = 192 + part
                elif n == 3:
                    bv = 224 + part
                elif n == 4:
                    bv = 240 + part
            else:
                bv = 128 + part % 64
            if bv >= 32 and bv < 127 and bv != 34 and bv != 92:
                out = out + chr(bv)
            else:
                h: str = "0123456789abcdef"
                out = out + "\\" + h[bv // 16] + h[bv % 16]
            k += 1
        i += 1
    return out


class Arena:
    off: int
    segs: list[str]

    def intern(self, s: str) -> int:
        # place s (UTF-8 + NUL) in the data arena; return its offset
        off: int = self.off
        esc: str = str_utf8_escape(s)
        blen: int = utf8_blen(s)
        self.segs.append("(data (i64.const " + str(off) + ") \"" + esc + "\\00\")")
        self.off = off + blen + 1
        return off


class Fn:
    name: str
    params: JValue
    ptypes: JValue
    body: JValue
    rtype: str


FUNCS: list[Fn] = []


def fn_lookup(name: str) -> int:
    i: int = 0
    while i < len(FUNCS):
        if FUNCS[i].name == name:
            return i
        i += 1
    return -1


def ann_type(node: JValue) -> str:
    # ["name", "float"] -> "f"; ["name", "str"] -> "s";
    # ["subscript", list, X] -> "li"; anything else -> "i"
    if node.kind == JKind.ARR and len(node.arr) > 1:
        if node.arr[1].s == "float":
            return "f"
        if node.arr[1].s == "str":
            return "s"
        if tag(node) == "subscript":
            return "li"
    return "i"


def collect_locals(stmts: JValue, names: list[str], types: list[str]) -> int:
    i: int = 0
    while i < len(stmts.arr):
        s = elem(stmts, i)
        t: str = tag(s)
        if t == "assign" or t == "ann_assign":
            # target is the bare name string; aug wraps it as a name node.
            # no recursion into the value expr - expr nodes are not stmt
            # lists and tag() would subscript None on bare names
            nm: str = elem_str(s, 1)
            if nm not in names:
                names.append(nm)
            if t == "ann_assign":
                types.append(ann_type(elem(s, 3)))
            else:
                types.append("")
        elif t == "aug_assign":
            nm: str = elem(elem(s, 1), 1).s
            if nm not in names:
                names.append(nm)
                types.append("")
        elif t == "if":
            collect_locals(elem(s, 2), names, types)
            collect_locals(elem(s, 3), names, types)
        elif t == "while":
            collect_locals(elem(s, 2), names, types)
        elif t == "for":
            vn: str = elem_str(elem(s, 1), 1)
            if vn not in names:
                names.append(vn)
                types.append("i")
            collect_locals(elem(s, 3), names, types)
        i += 1
    return 0


class Gen:
    out: str
    tmp: int
    names: list[str]
    tnames: list[str]
    ttypes: list[str]
    ar: Arena

    def emit(self, line: str) -> int:
        self.out = self.out + line + "\n"
        return 0

    def fresh(self) -> str:
        self.tmp += 1
        nm: str = "$t" + self.show_int(self.tmp)
        self.names.append(nm)
        self.tnames.append(nm)
        self.ttypes.append("i")
        return nm

    def set_type(self, name: str, ty: str) -> int:
        i: int = 0
        while i < len(self.tnames):
            if self.tnames[i] == name:
                self.ttypes[i] = ty
                return 0
            i += 1
        self.tnames.append(name)
        self.ttypes.append(ty)
        return 0

    def get_type(self, name: str) -> str:
        i: int = 0
        while i < len(self.tnames):
            if self.tnames[i] == name:
                return self.ttypes[i]
            i += 1
        return "i"

    def decls(self) -> str:
        # names/tnames/ttypes grow in lockstep (fresh and the ctor append
        # to all three); params live only in tnames/ttypes
        d: str = ""
        i: int = 0
        while i < len(self.names):
            ty: str = "i64"
            j: int = 0
            while j < len(self.tnames):
                if self.tnames[j] == self.names[i]:
                    if self.ttypes[j] == "f":
                        ty = "f64"
                j += 1
            d = d + " (local " + self.names[i] + " " + ty + ")"
            i += 1
        return d

    def show_int(self, v: int) -> str:
        if v < 0:
            return "-" + self.show_int(0 - v)
        digits: str = ""
        table: str = "0123456789"
        n: int = v
        while True:
            digits = table[n % 10] + digits
            n = n // 10
            if n == 0:
                return digits


def expr_type(g: Gen, node: JValue) -> str:
    t: str = tag(node)
    if t == "list":
        return "li"
    if t == "subscript":
        bt: str = expr_type(g, elem(node, 1))
        if bt == "s":
            return "s"
        return "i"
    if t == "len":
        return "i"
    if t == "const":
        if elem(node, 1).kind == JKind.FLOAT:
            return "f"
        if elem(node, 1).kind == JKind.STR:
            return "s"
        return "i"
    if t == "name":
        return g.get_type("$" + elem(node, 1).s)
    if t == "/":
        return "f"
    if t == "+":
        if expr_type(g, elem(node, 1)) == "s":
            return "s"
        if expr_type(g, elem(node, 2)) == "s":
            return "s"
    if t == "call":
        name: str = elem(elem(node, 1), 1).s
        if name == "float":
            return "f"
        if name == "str":
            return "s"
        fi: int = fn_lookup(name)
        if fi >= 0:
            return FUNCS[fi].rtype
        return "i"
    if t == "+" or t == "-" or t == "*" or t == "**":
        a: str = expr_type(g, elem(node, 1))
        if a == "f":
            return "f"
        if len(node.arr) == 3:
            if expr_type(g, elem(node, 2)) == "f":
                return "f"
        return "i"
    if t == "//" or t == "%":
        return "i"
    return "i"


def to_s(g: Gen, node: JValue) -> str:
    if expr_type(g, node) == "s":
        return emit_expr(g, node)
    if expr_type(g, node) == "i":
        return "(call $str_from_int " + emit_expr(g, node) + ")"
    return "(i64.const 0)"


def to_f(g: Gen, node: JValue) -> str:
    if expr_type(g, node) == "f":
        return emit_expr(g, node)
    return "(f64.convert_i64_s " + emit_expr(g, node) + ")"


def emit_expr(g: Gen, node: JValue) -> str:
    t: str = tag(node)
    if t == "const":
        if elem(node, 1).kind == JKind.FLOAT:
            # the original decimal text is a valid WAT f64 constant and
            # wat2wasm parses it correctly-rounded, same as CPython
            return "(f64.const " + elem(node, 1).s + ")"
        if elem(node, 1).kind == JKind.STR:
            return "(i64.const " + str(g.ar.intern(elem(node, 1).s)) + ")"
        if elem(node, 1).kind == JKind.BOOL:
            if elem(node, 1).b:
                return "(i64.const 1)"
            return "(i64.const 0)"
        return "(i64.const " + str(elem(node, 1).n) + ")"
    if t == "name":
        return "(local.get $" + elem(node, 1).s + ")"
    if t == "list":
        # empty list literal; element initializers are not in this subset
        return "(call $li_new)"
    if t == "subscript":
        bt: str = expr_type(g, elem(node, 1))
        idx: JValue = elem(node, 2)
        if bt == "s":
            if tag(idx) == "slice":
                sa: JValue = elem(idx, 1)
                sb: JValue = elem(idx, 2)
                sc: JValue = elem(idx, 3)
                base: str = emit_expr(g, elem(node, 1))
                if sa.kind == JKind.NIL:
                    a2: str = "(i64.const 0)"
                else:
                    a2 = emit_expr(g, sa)
                if sb.kind == JKind.NIL:
                    b2: str = "(i64.const 0)"
                else:
                    b2 = emit_expr(g, sb)
                if sc.kind == JKind.NIL:
                    s2: str = "(i64.const 1)"
                else:
                    s2 = emit_expr(g, sc)
                ha: str = "0"
                if sa.kind != JKind.NIL:
                    ha = "1"
                hb: str = "0"
                if sb.kind != JKind.NIL:
                    hb = "1"
                return "(call $str_slice4 " + base + " " + a2 + " " + b2 + " " + s2 + " (i64.const " + ha + ") (i64.const " + hb + "))"
            return "(call $str_get " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, idx) + ")"
        return "(call $li_get " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, idx) + ")"
    if t == "line":
        return "(i64.const 0)"
    if t == "call":
        name: str = elem(elem(node, 1), 1).s
        args: JValue = elem(node, 2)
        if name == "float":
            return "(f64.convert_i64_s " + emit_expr(g, elem(args, 0)) + ")"
        if name == "str":
            return to_s(g, elem(args, 0))
        if name == "len":
            at2: str = expr_type(g, elem(args, 0))
            if at2 == "s":
                return "(call $str_clen " + emit_expr(g, elem(args, 0)) + ")"
            return "(call $li_len " + emit_expr(g, elem(args, 0)) + ")"
        folded: str = ""
        fi: int = fn_lookup(name)
        i: int = 0
        while i < len(args.arr):
            pt: str = "i"
            if fi >= 0:
                pt = ann_type(elem(FUNCS[fi].ptypes, i))
            if pt == "f":
                folded = folded + " " + to_f(g, elem(args, i))
            else:
                folded = folded + " " + emit_expr(g, elem(args, i))
            i += 1
        return "(call $" + name + folded + ")"
    if t == "+":
        ty: str = expr_type(g, node)
        if ty == "f":
            return "(f64.add " + to_f(g, elem(node, 1)) + " " + to_f(g, elem(node, 2)) + ")"
        if ty == "s":
            return "(call $str_concat " + to_s(g, elem(node, 1)) + " " + to_s(g, elem(node, 2)) + ")"
        return "(i64.add " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + ")"
    if t == "*":
        if expr_type(g, node) == "f":
            return "(f64.mul " + to_f(g, elem(node, 1)) + " " + to_f(g, elem(node, 2)) + ")"
        return "(i64.mul " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + ")"
    if t == "-":
        if expr_type(g, node) == "f":
            if len(node.arr) == 2:
                return "(f64.neg " + emit_expr(g, elem(node, 1)) + ")"
            return "(f64.sub " + to_f(g, elem(node, 1)) + " " + to_f(g, elem(node, 2)) + ")"
        if len(node.arr) == 2:
            return "(i64.sub (i64.const 0) " + emit_expr(g, elem(node, 1)) + ")"
        return "(i64.sub " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + ")"
    if t == "/":
        return "(f64.div " + to_f(g, elem(node, 1)) + " " + to_f(g, elem(node, 2)) + ")"
    if t == "//":
        return emit_floordiv(g, elem(node, 1), elem(node, 2))
    if t == "%":
        return emit_floormod(g, elem(node, 1), elem(node, 2))
    if t == "**":
        if expr_type(g, node) == "f":
            return "(f64.const 0)"
        return emit_ipow(g, elem(node, 1), elem(node, 2))
    if t == "<":
        if expr_type(g, elem(node, 1)) == "s" or expr_type(g, elem(node, 2)) == "s":
            return "(i64.extend_i32_u (i32.wrap_i64 (call $str_lt " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + ")))"
        return "(i64.extend_i32_u (i64.lt_s " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + "))"
    if t == "<=":
        if expr_type(g, elem(node, 1)) == "s" or expr_type(g, elem(node, 2)) == "s":
            return "(i64.extend_i32_u (i32.wrap_i64 (i64.xor (call $str_lt " + emit_expr(g, elem(node, 2)) + " " + emit_expr(g, elem(node, 1)) + ") (i64.const 1))))"
        return "(i64.extend_i32_u (i64.le_s " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + "))"
    if t == ">":
        if expr_type(g, elem(node, 1)) == "s" or expr_type(g, elem(node, 2)) == "s":
            return "(i64.extend_i32_u (i32.wrap_i64 (call $str_lt " + emit_expr(g, elem(node, 2)) + " " + emit_expr(g, elem(node, 1)) + ")))"
        return "(i64.extend_i32_u (i64.gt_s " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + "))"
    if t == ">=":
        if expr_type(g, elem(node, 1)) == "s" or expr_type(g, elem(node, 2)) == "s":
            return "(i64.extend_i32_u (i32.wrap_i64 (i64.xor (call $str_lt " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + ") (i64.const 1))))"
        return "(i64.extend_i32_u (i64.ge_s " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + "))"
    if t == "==":
        if expr_type(g, elem(node, 1)) == "s" or expr_type(g, elem(node, 2)) == "s":
            return "(i64.extend_i32_u (i32.wrap_i64 (call $str_eq " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + ")))"
        return "(i64.extend_i32_u (i64.eq " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + "))"
    if t == "!=":
        if expr_type(g, elem(node, 1)) == "s" or expr_type(g, elem(node, 2)) == "s":
            return "(i64.extend_i32_u (i32.wrap_i64 (i64.xor (call $str_eq " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + ") (i64.const 1))))"
        return "(i64.extend_i32_u (i64.ne " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + "))"
    return "(i64.const 0)"


def emit_floordiv(g: Gen, a: JValue, b: JValue) -> str:
    # q = a/b (trunc); correct down when remainder and divisor disagree
    q: str = g.fresh()
    r: str = g.fresh()
    ae: str = emit_expr(g, a)
    be: str = emit_expr(g, b)
    g.emit("(local.set " + q + " (i64.div_s " + ae + " " + be + "))")
    g.emit("(local.set " + r + " (i64.rem_s " + ae + " " + be + "))")
    cond: str = "(i32.and (i64.ne (local.get " + r + ") (i64.const 0)) (i64.ne (i64.xor (i64.shr_s (local.get " + r + ") (i64.const 63)) (i64.shr_s " + be + " (i64.const 63))) (i64.const 0)))"
    return "(if (result i64) " + cond + " (then (i64.sub (local.get " + q + ") (i64.const 1))) (else (local.get " + q + ")))"


def emit_floormod(g: Gen, a: JValue, b: JValue) -> str:
    # r = a%b (trunc); if r != 0 and sign(r) != sign(b): r += b
    q: str = g.fresh()
    r: str = g.fresh()
    ae: str = emit_expr(g, a)
    be: str = emit_expr(g, b)
    g.emit("(local.set " + q + " (i64.div_s " + ae + " " + be + "))")
    g.emit("(local.set " + r + " (i64.rem_s " + ae + " " + be + "))")
    cond: str = "(i32.and (i64.ne (local.get " + r + ") (i64.const 0)) (i64.ne (i64.xor (i64.shr_s (local.get " + r + ") (i64.const 63)) (i64.shr_s " + be + " (i64.const 63))) (i64.const 0)))"
    return "(if (result i64) " + cond + " (then (i64.add (local.get " + r + ") " + be + ")) (else (local.get " + r + ")))"


def emit_ipow(g: Gen, a: JValue, b: JValue) -> str:
    # exponentiation by squaring into a temp; skip the dead final square
    base: str = g.fresh()
    e: str = g.fresh()
    r: str = g.fresh()
    g.emit("(local.set " + base + " " + emit_expr(g, a) + ")")
    g.emit("(local.set " + e + " " + emit_expr(g, b) + ")")
    g.emit("(local.set " + r + " (i64.const 1))")
    g.emit("(block (loop (br_if 1 (i64.le_s (local.get " + e + ") (i64.const 0))) (if (i32.wrap_i64 (i64.rem_s (local.get " + e + ") (i64.const 2))) (then (local.set " + r + " (i64.mul (local.get " + r + ") (local.get " + base + "))))) (local.set " + e + " (i64.div_s (local.get " + e + ") (i64.const 2))) (br_if 1 (i64.le_s (local.get " + e + ") (i64.const 0))) (local.set " + base + " (i64.mul (local.get " + base + ") (local.get " + base + "))) (br 0)))")
    return "(local.get " + r + ")"


def emit_stmts(g: Gen, stmts: JValue) -> int:
    i: int = 0
    while i < len(stmts.arr):
        emit_stmt(g, elem(stmts, i))
        i += 1
    return 0


def emit_stmt(g: Gen, stmt: JValue) -> int:
    t: str = tag(stmt)
    if t == "line":
        return 0
    if t == "assign" and elem(stmt, 1).kind == JKind.ARR and tag(elem(stmt, 1)) == "subscript":
        g.emit("(call $li_set " + emit_expr(g, elem(elem(stmt, 1), 1)) + " " + emit_expr(g, elem(elem(stmt, 1), 2)) + " " + emit_expr(g, elem(stmt, 2)) + ")")
        return 0
    if t == "assign" or t == "ann_assign":
        nm: str = "$" + elem_str(stmt, 1)
        if t == "ann_assign":
            g.set_type(nm, ann_type(elem(stmt, 3)))
        vt: str = expr_type(g, elem(stmt, 2))
        if vt == "f":
            g.set_type(nm, "f")
        if g.get_type(nm) == "f":
            g.emit("(local.set " + nm + " " + to_f(g, elem(stmt, 2)) + ")")
        elif g.get_type(nm) == "s":
            g.emit("(local.set " + nm + " " + to_s(g, elem(stmt, 2)) + ")")
        else:
            g.emit("(local.set " + nm + " " + emit_expr(g, elem(stmt, 2)) + ")")
        return 0
    if t == "aug_assign":
        tgt: str = "$" + elem(elem(stmt, 1), 1).s
        op: str = elem_str(stmt, 2)
        ftarget: str = g.get_type(tgt)
        if ftarget == "f":
            rhs_f: str = to_f(g, elem(stmt, 3))
            if op == "+=":
                g.emit("(local.set " + tgt + " (f64.add (local.get " + tgt + ") " + rhs_f + "))")
            elif op == "-=":
                g.emit("(local.set " + tgt + " (f64.sub (local.get " + tgt + ") " + rhs_f + "))")
            elif op == "*=":
                g.emit("(local.set " + tgt + " (f64.mul (local.get " + tgt + ") " + rhs_f + "))")
            elif op == "/=":
                g.emit("(local.set " + tgt + " (f64.div (local.get " + tgt + ") " + rhs_f + "))")
            return 0
        rhs: str = emit_expr(g, elem(stmt, 3))
        if op == "+=":
            g.emit("(local.set " + tgt + " (i64.add (local.get " + tgt + ") " + rhs + "))")
        elif op == "-=":
            g.emit("(local.set " + tgt + " (i64.sub (local.get " + tgt + ") " + rhs + "))")
        elif op == "*=":
            g.emit("(local.set " + tgt + " (i64.mul (local.get " + tgt + ") " + rhs + "))")
        elif op == "//=":
            g.emit("(local.set " + tgt + " " + emit_floordiv(g, elem(stmt, 1), elem(stmt, 3)) + ")")
        elif op == "%=":
            g.emit("(local.set " + tgt + " " + emit_floormod(g, elem(stmt, 1), elem(stmt, 3)) + ")")
        elif op == "**=":
            g.emit("(local.set " + tgt + " " + emit_ipow(g, elem(stmt, 1), elem(stmt, 3)) + ")")
        return 0
    if t == "call":
        head: JValue = elem(stmt, 1)
        if tag(head) == "attribute":
            mname: str = elem_str(head, 2)
            if mname == "append":
                g.emit("(call $li_append " + emit_expr(g, elem(head, 1)) + " " + emit_expr(g, elem(elem(stmt, 2), 0)) + ")")
                return 0
        name: str = elem(elem(stmt, 1), 1).s
        args: JValue = elem(stmt, 2)
        if name == "print":
            i: int = 0
            while i < len(args.arr):
                if i > 0:
                    g.emit("(call $print_sp)")
                at: str = expr_type(g, elem(args, i))
                if at == "f":
                    g.emit("(call $print_f64 " + emit_expr(g, elem(args, i)) + ")")
                elif at == "li":
                    g.emit("(call $print_li " + emit_expr(g, elem(args, i)) + ")")
                elif at == "s":
                    # single evaluation: the slice result goes to a fresh
                    # local; write reads it twice (ptr + blen)
                    se: str = g.fresh()
                    g.emit("(local.set " + se + " " + emit_expr(g, elem(args, i)) + ")")
                    g.emit("(call $write (i32.const 1) (local.get " + se + ") (call $str_blen (local.get " + se + ")))")
                else:
                    g.emit("(call $print_i64 " + emit_expr(g, elem(args, i)) + ")")
                i += 1
            g.emit("(call $print_nl)")
            return 0
        folded: str = ""
        i: int = 0
        while i < len(args.arr):
            folded = folded + " " + emit_expr(g, elem(args, i))
            i += 1
        g.emit("(drop (call $" + name + folded + "))")
        return 0
    if t == "func_def":
        return 0
    if t == "return":
        g.emit("(local.set $rv " + emit_expr(g, elem(stmt, 1)) + ")")
        g.emit("(br $fn_exit)")
        return 0
    if t == "if":
        cond: str = emit_expr(g, elem(stmt, 1))
        g.emit("(if (i32.wrap_i64 " + cond + ") (then")
        emit_stmts(g, elem(stmt, 2))
        g.emit(") (else")
        emit_stmts(g, elem(stmt, 3))
        g.emit("))")
        return 0
    if t == "for":
        # for x in l: body  ->  index temp; while idx < len(l): x = l[idx]
        var: str = "$" + elem(elem(stmt, 1), 1).s
        lst: str = emit_expr(g, elem(stmt, 2))
        li: str = g.fresh()
        idx: str = g.fresh()
        g.emit("(local.set " + li + " " + lst + ")")
        g.emit("(local.set " + idx + " (i64.const 0))")
        g.emit("(block $fexit (loop $ftop")
        g.emit("(br_if $fexit (i64.ge_u (local.get " + idx + ") (call $li_len (local.get " + li + "))))")
        g.emit("(local.set " + var + " (call $li_get (local.get " + li + ") (local.get " + idx + ")))")
        emit_stmts(g, elem(stmt, 3))
        g.emit("(local.set " + idx + " (i64.add (local.get " + idx + ") (i64.const 1)))")
        g.emit("(br $ftop)))")
        return 0
    if t == "while":
        cond: str = emit_expr(g, elem(stmt, 1))
        g.emit("(block $wexit (loop $wtop")
        g.emit("(br_if $wexit (i32.eqz (i32.wrap_i64 " + cond + ")))")
        emit_stmts(g, elem(stmt, 2))
        g.emit("(br $wtop)))")
        return 0
    return 0


def emit_fn(g: Gen, fn: Fn) -> int:
    names: list[str] = []
    types: list[str] = []
    params: list[str] = []
    ptypes: list[str] = []
    i: int = 0
    sig: str = ""
    while i < len(fn.params.arr):
        pn: str = fn.params.arr[i].s
        pty: str = ann_type(elem(fn.ptypes, i))
        ptypes.append(pty)
        pyt: str = "i64"
        if pty == "f":
            pyt = "f64"
        sig = sig + " (param $" + pn + " " + pyt + ")"
        names.append(pn)
        params.append(pn)
        types.append(pty)
        i += 1
    collect_locals(fn.body, names, types)
    i = 0
    while i < len(fn.params.arr):
        if ptypes[i] == "f":
            types[i] = "f"
        i += 1
    # non-param source names + fresh temps all become wasm locals; the
    # body goes through a scratch Gen so its fresh temps are known
    # before the header closes
    local_names: list[str] = []
    local_types: list[str] = []
    i = len(params)
    while i < len(names):
        local_names.append("$" + names[i])
        local_types.append(types[i])
        i += 1
    tcopy: list[str] = []
    i = 0
    while i < len(local_names):
        tcopy.append(local_names[i])
        i += 1
    sub: Gen = Gen("", 0, local_names, tcopy, local_types, g.ar)
    i = 0
    while i < len(params):
        sub.set_type("$" + params[i], ptypes[i])
        i += 1
    emit_stmts(sub, fn.body)
    rvt: str = "i64"
    if fn.rtype == "f":
        rvt = "f64"
    head: str = "(func $" + fn.name + sig + " (result " + rvt + ")" + sub.decls() + " (local $rv " + rvt + ")"
    g.emit(head)
    g.emit("(block $fn_exit")
    g.out = g.out + sub.out
    g.emit(")")
    g.emit("(local.get $rv))")
    return 0


RUNTIME = '''(module
(import "silu_host" "write" (func $write (param i32 i64 i64)))
(import "silu_host" "fmt_double" (func $fmt_double (param i64 i64 f64 i32 i32) (result i64)))
(memory i64 1)
(export "memory" (memory 0))
(func $alloc (param $n i64) (result i64)
(local $old i64) (local $want i64) (local $pages i64) (local $cur i64)
(local.set $old (global.get $heap))
(local.set $want (i64.add (local.get $old) (local.get $n)))
(local.set $cur (i64.mul (memory.size) (i64.const 65536)))
(if (i64.gt_u (local.get $want) (local.get $cur))
  (then
    (local.set $pages (i64.div_u (i64.sub (i64.add (local.get $want) (i64.const 65535)) (local.get $cur)) (i64.const 65536)))
    (drop (memory.grow (local.get $pages)))))
(global.set $heap (local.get $want))
(local.get $old))
(func $li_new (result i64)
(local $p i64)
(local.set $p (call $alloc (i64.const 24)))
(i64.store (local.get $p) (i64.const 0))
(i64.store (i64.add (local.get $p) (i64.const 8)) (i64.const 0))
(i64.store (i64.add (local.get $p) (i64.const 16)) (i64.const 0))
(local.get $p))
(func $li_append (param $l i64) (param $v i64)
(local $len i64) (local $cap i64) (local $data i64) (local $ndata i64) (local $ncap i64)
(local.set $len (i64.load (local.get $l)))
(local.set $cap (i64.load (i64.add (local.get $l) (i64.const 8))))
(local.set $data (i64.load (i64.add (local.get $l) (i64.const 16))))
(if (i64.ge_u (local.get $len) (local.get $cap))
  (then
    (local.set $ncap (i64.mul (i64.add (local.get $cap) (i64.const 1)) (i64.const 2)))
    (local.set $ndata (call $alloc (i64.mul (local.get $ncap) (i64.const 8))))
    (memory.copy (local.get $ndata) (local.get $data) (i64.mul (local.get $len) (i64.const 8)))
    (i64.store (i64.add (local.get $l) (i64.const 16)) (local.get $ndata))
    (i64.store (i64.add (local.get $l) (i64.const 8)) (local.get $ncap))
    (local.set $data (local.get $ndata))))
(i64.store (i64.add (local.get $data) (i64.mul (local.get $len) (i64.const 8))) (local.get $v))
(i64.store (local.get $l) (i64.add (local.get $len) (i64.const 1))))
(func $li_get (param $l i64) (param $i i64) (result i64)
(local $data i64)
(if (i64.ge_u (local.get $i) (i64.load (local.get $l)))
  (then unreachable))
(local.set $data (i64.load (i64.add (local.get $l) (i64.const 16))))
(i64.load (i64.add (local.get $data) (i64.mul (local.get $i) (i64.const 8)))))
(func $li_set (param $l i64) (param $i i64) (param $v i64)
(local $data i64)
(if (i64.ge_u (local.get $i) (i64.load (local.get $l)))
  (then unreachable))
(local.set $data (i64.load (i64.add (local.get $l) (i64.const 16))))
(i64.store (i64.add (local.get $data) (i64.mul (local.get $i) (i64.const 8))) (local.get $v)))
(func $li_len (param $l i64) (result i64)
(i64.load (local.get $l)))
(func $str_blen (param $p i64) (result i64)
(local $n i64)
(block $done (loop $again
(br_if $done (i64.eqz (i64.load8_u (local.get $p))))
(local.set $n (i64.add (local.get $n) (i64.const 1)))
(local.set $p (i64.add (local.get $p) (i64.const 1)))
(br $again)))
(local.get $n))
(func $str_clen (param $p i64) (result i64)
(local $n i64) (local $b i64)
(block $done (loop $again
(local.set $b (i64.load8_u (local.get $p)))
(br_if $done (i64.eqz (local.get $b)))
(if (i64.ne (i64.and (local.get $b) (i64.const 192)) (i64.const 128))
  (then (local.set $n (i64.add (local.get $n) (i64.const 1)))))
(local.set $p (i64.add (local.get $p) (i64.const 1)))
(br $again)))
(local.get $n))
(func $str_concat (param $a i64) (param $b i64) (result i64)
(local $la i64) (local $lb i64) (local $p i64)
(local.set $la (call $str_blen (local.get $a)))
(local.set $lb (call $str_blen (local.get $b)))
(local.set $p (call $alloc (i64.add (i64.add (local.get $la) (local.get $lb)) (i64.const 1))))
(memory.copy (local.get $p) (local.get $a) (local.get $la))
(memory.copy (i64.add (local.get $p) (local.get $la)) (local.get $b) (local.get $lb))
(i64.store8 (i64.add (local.get $p) (i64.add (local.get $la) (local.get $lb))) (i64.const 0))
(local.get $p))
(func $str_eq (param $a i64) (param $b i64) (result i64)
(local $ca i64) (local $cb i64) (local $r i64)
(local.set $r (i64.const 1))
(block $done (loop $again
(local.set $ca (i64.load8_u (local.get $a)))
(local.set $cb (i64.load8_u (local.get $b)))
(if (i64.ne (local.get $ca) (local.get $cb))
  (then (local.set $r (i64.const 0)) (br $done)))
(br_if $done (i64.eqz (local.get $ca)))
(local.set $a (i64.add (local.get $a) (i64.const 1)))
(local.set $b (i64.add (local.get $b) (i64.const 1)))
(br $again)))
(local.get $r))
(func $str_lt (param $a i64) (param $b i64) (result i64)
(local $ca i64) (local $cb i64) (local $r i64)
(local.set $r (i64.const 0))
(block $done (loop $again
(local.set $ca (i64.load8_u (local.get $a)))
(local.set $cb (i64.load8_u (local.get $b)))
(if (i64.ne (local.get $ca) (local.get $cb))
  (then
    (if (i64.lt_u (local.get $ca) (local.get $cb))
      (then (local.set $r (i64.const 1))))
    (br $done)))
(br_if $done (i64.eqz (local.get $ca)))
(local.set $a (i64.add (local.get $a) (i64.const 1)))
(local.set $b (i64.add (local.get $b) (i64.const 1)))
(br $again)))
(local.get $r))
(func $str_from_int (param $v i64) (result i64)
(local $p i64) (local $q i64) (local $neg i64)
(local.set $p (call $alloc (i64.const 21)))
(local.set $q (i64.add (local.get $p) (i64.const 19)))
(if (i64.lt_s (local.get $v) (i64.const 0))
  (then (local.set $neg (i64.const 1)) (local.set $v (i64.sub (i64.const 0) (local.get $v)))))
(block $done (loop $again
(local.set $q (i64.sub (local.get $q) (i64.const 1)))
(i64.store8 (local.get $q) (i64.add (i64.const 48) (i64.rem_u (local.get $v) (i64.const 10))))
(local.set $v (i64.div_u (local.get $v) (i64.const 10)))
(br_if $again (i64.gt_u (local.get $v) (i64.const 0)))))
(if (i64.eq (local.get $neg) (i64.const 1))
  (then
    (local.set $q (i64.sub (local.get $q) (i64.const 1)))
    (i64.store8 (local.get $q) (i64.const 45))))
(i64.store8 (i64.add (local.get $p) (i64.const 20)) (i64.const 0))
(local.get $q))
(func $cp_len_at (param $p i64) (result i64)
(local $b i64)
(local.set $b (i64.load8_u (local.get $p)))
(if (result i64) (i64.lt_u (local.get $b) (i64.const 128))
  (then (i64.const 1))
  (else (if (result i64) (i64.lt_u (local.get $b) (i64.const 224))
    (then (i64.const 2))
    (else (if (result i64) (i64.lt_u (local.get $b) (i64.const 240))
      (then (i64.const 3))
      (else (i64.const 4))))))))
(func $str_get (param $s i64) (param $i i64) (result i64)
(local $clen i64) (local $off i64) (local $k i64) (local $n i64) (local $p i64)
(local.set $clen (call $str_clen (local.get $s)))
(if (i64.lt_s (local.get $i) (i64.const 0))
  (then (local.set $i (i64.add (local.get $i) (local.get $clen)))))
(if (i64.ge_u (local.get $i) (local.get $clen))
  (then unreachable))
(local.set $off (i64.const 0))
(local.set $k (i64.const 0))
(block $skipdone (loop $skip
(br_if $skipdone (i64.ge_u (local.get $k) (local.get $i)))
(local.set $off (i64.add (local.get $off) (call $cp_len_at (i64.add (local.get $s) (local.get $off)))))
(local.set $k (i64.add (local.get $k) (i64.const 1)))
(br $skip)))
(local.set $n (call $cp_len_at (i64.add (local.get $s) (local.get $off))))
(local.set $p (call $alloc (i64.add (local.get $n) (i64.const 1))))
(memory.copy (local.get $p) (i64.add (local.get $s) (local.get $off)) (local.get $n))
(i64.store8 (i64.add (local.get $p) (local.get $n)) (i64.const 0))
(local.get $p))
(func $str_slice4 (param $s i64) (param $a i64) (param $b i64) (param $step i64) (param $ha i64) (param $hb i64) (result i64)
(local $clen i64) (local $off i64) (local $k i64) (local $n i64) (local $p i64) (local $w i64) (local $idx i64) (local $nxt i64)
(local.set $clen (call $str_clen (local.get $s)))
;; a: defaults skip the negative-adjust (they are already in-range)
(if (i64.eqz (local.get $ha))
  (then (if (i64.lt_s (local.get $step) (i64.const 0))
    (then (local.set $a (i64.sub (local.get $clen) (i64.const 1))))
    (else (local.set $a (i64.const 0))))))
(if (i32.and (i32.wrap_i64 (local.get $ha)) (i64.lt_s (local.get $a) (i64.const 0)))
  (then (local.set $a (i64.add (local.get $a) (local.get $clen)))))
(if (i64.lt_s (local.get $step) (i64.const 0))
  (then (if (i64.gt_s (local.get $a) (i64.sub (local.get $clen) (i64.const 1)))
    (then (local.set $a (i64.sub (local.get $clen) (i64.const 1))))))
  (else (if (i64.gt_u (local.get $a) (local.get $clen))
    (then (local.set $a (local.get $clen))))))
;; b: defaults skip the negative-adjust
(if (i64.eqz (local.get $hb))
  (then (if (i64.lt_s (local.get $step) (i64.const 0))
    (then (local.set $b (i64.const -1)))
    (else (local.set $b (local.get $clen))))))
(if (i32.and (i32.wrap_i64 (local.get $hb)) (i64.lt_s (local.get $b) (i64.const 0)))
  (then (local.set $b (i64.add (local.get $b) (local.get $clen)))))
(if (i64.lt_s (local.get $step) (i64.const 0))
  (then (if (i64.lt_s (local.get $b) (i64.const -1))
    (then (local.set $b (i64.const -1)))))
  (else (if (i64.gt_u (local.get $b) (local.get $clen))
    (then (local.set $b (local.get $clen))))))
;; byte offset of a
(local.set $off (i64.const 0))
(local.set $k (i64.const 0))
(block $skipdone (loop $skip
(br_if $skipdone (i64.ge_u (local.get $k) (local.get $a)))
(local.set $off (i64.add (local.get $off) (call $cp_len_at (i64.add (local.get $s) (local.get $off)))))
(local.set $k (i64.add (local.get $k) (i64.const 1)))
(br $skip)))
;; copy selected codepoints
(local.set $p (call $alloc (i64.add (local.get $clen) (i64.const 1))))
(local.set $w (i64.const 0))
(local.set $idx (local.get $a))
(block $done (loop $again
(if (i64.gt_s (local.get $step) (i64.const 0))
  (then (br_if $done (i64.ge_s (local.get $idx) (local.get $b)))))
(if (i64.lt_s (local.get $step) (i64.const 0))
  (then (br_if $done (i64.le_s (local.get $idx) (local.get $b)))))
(local.set $n (call $cp_len_at (i64.add (local.get $s) (local.get $off))))
(memory.copy (i64.add (local.get $p) (local.get $w)) (i64.add (local.get $s) (local.get $off)) (local.get $n))
(local.set $w (i64.add (local.get $w) (local.get $n)))
(local.set $nxt (i64.add (local.get $idx) (local.get $step)))
(local.set $idx (i64.add (local.get $idx) (local.get $step)))
(if (i64.gt_s (local.get $step) (i64.const 0))
  (then
    (if (i64.lt_s (local.get $nxt) (local.get $b))
      (then
        (local.set $off (i64.add (local.get $off) (call $cp_len_at (i64.add (local.get $s) (local.get $off)))))))))
(if (i64.lt_s (local.get $step) (i64.const 0))
  (then
    (if (i64.gt_s (local.get $nxt) (local.get $b))
      (then
        (local.set $off (i64.sub (local.get $off) (i64.const 1)))
        (block $bwend (loop $bw
(br_if $bwend (i64.ne (i64.and (i64.load8_u (local.get $off)) (i64.const 192)) (i64.const 128)))
(local.set $off (i64.sub (local.get $off) (i64.const 1)))
(br $bw)))))))
(br $again)))
(i64.store8 (i64.add (local.get $p) (local.get $w)) (i64.const 0))
(local.get $p))
(func $print_i64 (param $v i64)
(local $p i64) (local $len i64)
(if (i64.lt_s (local.get $v) (i64.const 0))
  (then
    (i64.store8 (i64.const 64) (i64.const 45))
    (call $write (i32.const 1) (i64.const 64) (i64.const 1))
    (local.set $v (i64.sub (i64.const 0) (local.get $v)))))
(local.set $p (i64.const 87))
(loop $digits
  (local.set $p (i64.sub (local.get $p) (i64.const 1)))
  (i64.store8 (local.get $p) (i64.add (i64.const 48) (i64.rem_u (local.get $v) (i64.const 10))))
  (local.set $v (i64.div_u (local.get $v) (i64.const 10)))
  (br_if $digits (i64.gt_u (local.get $v) (i64.const 0))))
(call $write (i32.const 1) (local.get $p) (i64.sub (i64.const 87) (local.get $p))))
(func $print_f64 (param $v f64)
(local $n i64)
(local.set $n (call $fmt_double (i64.const 64) (i64.const 400) (local.get $v) (i32.const 114) (i32.const 17)))
(call $write (i32.const 1) (i64.const 64) (local.get $n)))
(func $print_li (param $l i64)
(local $i i64) (local $n i64)
(i64.store8 (i64.const 96) (i64.const 91))
(call $write (i32.const 1) (i64.const 96) (i64.const 1))
(local.set $n (i64.load (local.get $l)))
(local.set $i (i64.const 0))
(block $done
(loop $again
(br_if $done (i64.ge_u (local.get $i) (local.get $n)))
(if (i64.gt_u (local.get $i) (i64.const 0))
  (then
    (i64.store8 (i64.const 96) (i64.const 44))
    (i64.store8 (i64.const 97) (i64.const 32))
    (call $write (i32.const 1) (i64.const 96) (i64.const 2))))
(call $print_i64 (call $li_get (local.get $l) (local.get $i)))
(local.set $i (i64.add (local.get $i) (i64.const 1)))
(br $again)))
(i64.store8 (i64.const 96) (i64.const 93))
(call $write (i32.const 1) (i64.const 96) (i64.const 1)))
(func $print_sp
(i64.store8 (i64.const 90) (i64.const 32))
(call $write (i32.const 1) (i64.const 90) (i64.const 1)))
(func $print_nl
(i64.store8 (i64.const 90) (i64.const 10))
(call $write (i32.const 1) (i64.const 90) (i64.const 1)))'''


def main() -> int:
    src: str = read_stdin()
    parser: Json = Json(src, 0)
    root: JValue = parser.value()
    stmts: JValue = elem(root, 1)
    # pass 1: register functions (hoisted to the top by the front end)
    i: int = 0
    while i < len(stmts.arr):
        s = elem(stmts, i)
        if tag(s) == "func_def":
            fn: Fn = Fn("", None, None, None, "")
            fn.name = elem_str(s, 1)
            fn.params = elem(s, 2)
            fn.ptypes = elem(s, 4)
            fn.body = elem(s, 3)
            rt = elem(s, 5)
            if rt.kind == JKind.NIL:
                fn.rtype = "i"
            else:
                fn.rtype = ann_type(rt)
            FUNCS.append(fn)
        i += 1
    ar: Arena = Arena(1024, [])
    g: Gen = Gen("", 0, [], [], [], ar)
    g.out = RUNTIME + "\n"
    # pass 2: each function, then the top-level statements as $silu_main
    i = 0
    while i < len(FUNCS):
        emit_fn(g, FUNCS[i])
        i += 1
    names: list[str] = []
    types: list[str] = []
    collect_locals(stmts, names, types)
    local_names: list[str] = []
    local_types: list[str] = []
    i = 0
    while i < len(names):
        local_names.append("$" + names[i])
        local_types.append(types[i])
        i += 1
    tcopy2: list[str] = []
    i = 0
    while i < len(local_names):
        tcopy2.append(local_names[i])
        i += 1
    sub: Gen = Gen("", 0, local_names, tcopy2, local_types, ar)
    emit_stmts(sub, stmts)
    g.emit("(func $silu_main (export \"silu_main\")" + sub.decls())
    g.out = g.out + sub.out
    g.emit(")")
    si: int = 0
    while si < len(ar.segs):
        g.emit(ar.segs[si])
        si += 1
    g.emit("(global $heap (mut i64) (i64.const " + str(ar.off) + "))")
    g.emit(")")
    print(g.out, end="")
    return 0
