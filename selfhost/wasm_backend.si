# L2 milestone: a WASM backend for the Silu IR (int/float/str/list[int]
# subset). Pipeline: read IR JSON from stdin -> emit WAT to stdout ->
# wat2wasm (memory64 is default-on in wabt >= 1.0.38) -> the program
# runs under any wasm64 host (the playground's silu_host shim; print
# goes through the write import, floats through fmt_double repr).
# Differential targets: wasm/examples/*.si vs CPython.
# Semantics mirrored from CPython:
# - ints are i64 locals, floats f64, list[int] a (ptr,len,cap) struct
# - strs: every str value is a 16-byte little-endian prefix [blen]
#   [clen] followed by NUL-terminated UTF-8; pointers aim at the bytes
#   (byte-level consumers never change). blen/clen loads are O(1);
#   len() counts code points. Every str BINDING takes an owned copy
#   ($s_copy: assign/global.set/call args/dict keys+values/for-var),
#   which licenses the narrow-window x = x + e (and x += e) in-place
#   extend ($str_extend): amortized O(1) when the buffer is the newest
#   heap allocation (heap-top + heap-base guards, never a literal),
#   plain concat otherwise. x = x + x falls back to concat (overlap).
#   This is what makes dna = dna + "A" loops linear (knucleotide).
# - // and % are FLOOR semantics (sign-correction over the truncating
#   i64 ops); ** squaring skips the dead final square; / always float
# - comparisons are byte order (== codepoint order for UTF-8)
# Unsupported nodes evaluate to 0 (documented gap model, like
# ir_interp). Supported: const (int/float/bool/str), name, assign/
# ann_assign/aug_assign (+= -= *= //= %= **=), binops, compare,
# and/or/not (truthiness, short-circuit), break/continue, if, while,
# for (list + dict), call (print/str/len/float/user functions),
# func_def, return, subscript read/write on lists/dicts/strs,
# attribute append/upper/lower, in (list + dict).
# dict[K,V] value types: int (ds), float (dsf - bit-packed in the i64
# slot via reinterpret), str (dss - pointer); print repr matches
# CPython per value type. Subscript aug on dsf/dss is a loud trap.
# Comparisons/and/or/not/bool consts carry type tag "b"; print renders
# True/False (CPython repr). str(bool) is a loud trap. Negative list
# subscripts adjust like CPython (str already did).
# Module-level variables become wasm globals (global.get/set): functions
# read them, and same-name assignments inside a function stay local
# (CPython scoping). A bare top-level assign infers its type from the
# first initializer; ann_assign fixes it. Top-level for-loop targets are
# $silu_main locals (not visible to functions) - a documented gap.
# list[float] = "lf" (same bit-packing as dsf); dict.get(k[, default]);
# input() builtin (one line via getchar, 4096-byte line cap). Unknown
# callees (class constructors etc.) are loud unreachable traps.
# LOUD traps (unreachable), not silent zeros: /= on ints, non-empty
# list literals, str(list)/str(dict), float(str), str*int, step=0
# slices, str aug ops other than +=.

from __future__ import annotations


class JKind(Enum):
    NIL = 0
    BOOL = 1
    NUM = 2
    STR = 3
    ARR = 4
    OBJ = 5
    FLOAT = 6


class JValue:
    kind: JKind
    b: bool
    n: int
    d: float
    s: str
    arr: list[JValue]
    key: str
    nxt: JValue


class Json:
    src: str
    pos: int

    def ws(self) -> int:
        while self.pos < len(self.src):
            ch = self.src[self.pos]
            if ch == " " or ch == "\n" or ch == "\t" or ch == "\r":
                self.pos += 1
            else:
                return 0

    def value(self) -> JValue:
        self.ws()
        ch = self.src[self.pos]
        if ch == "[":
            return self.array()
        if ch == '"':
            return jstr(self.string())
        if ch == "t":
            self.pos += 4
            return jbool(True)
        if ch == "f":
            self.pos += 5
            return jbool(False)
        if ch == "n":
            self.pos += 4
            return jnull()
        return self.number()

    def array(self) -> JValue:
        items: list[JValue] = []
        self.pos += 1
        while True:
            self.ws()
            if self.src[self.pos] == "]":
                self.pos += 1
                return jarr(items)
            items.append(self.value())
            self.ws()
            if self.src[self.pos] == ",":
                self.pos += 1

    def string(self) -> str:
        self.pos += 1
        out: str = ""
        while self.src[self.pos] != '"':
            ch = self.src[self.pos]
            if ch == "\\":
                self.pos += 1
                e = self.src[self.pos]
                if e == "n":
                    out = out + "\n"
                elif e == "t":
                    out = out + "\t"
                elif e == "r":
                    out = out + chr(13)
                elif e == "b":
                    out = out + chr(8)
                elif e == "f":
                    out = out + chr(12)
                elif e == "u":
                    self.pos += 1
                    code: int = 0
                    k: int = 0
                    while k < 4:
                        h = self.src[self.pos]
                        self.pos += 1
                        code = code * 16
                        if h >= "0" and h <= "9":
                            code += ord(h) - ord("0")
                        elif h >= "a" and h <= "f":
                            code += ord(h) - ord("a") + 10
                        else:
                            code += ord(h) - ord("A") + 10
                        k += 1
                    self.pos -= 1
                    out = out + chr(code)
                else:
                    out = out + e
                self.pos += 1
            else:
                out = out + ch
                self.pos += 1
        self.pos += 1
        return out

    def number(self) -> JValue:
        neg: bool = False
        if self.src[self.pos] == "-":
            neg = True
            self.pos += 1
        start: int = self.pos
        isf: bool = False
        while self.pos < len(self.src):
            ch = self.src[self.pos]
            if ch >= "0" and ch <= "9":
                self.pos += 1
            elif ch == "." or ch == "e" or ch == "E" or ch == "+" or ch == "-":
                if ch == "+" or ch == "-":
                    prev = self.src[self.pos - 1]
                    if prev != "e" and prev != "E":
                        break
                isf = isf or ch == "." or ch == "e" or ch == "E"
                self.pos += 1
            else:
                break
        text: str = self.src[start:self.pos]
        if neg:
            text = "-" + text
        if isf:
            f: float = float(text)
            return JValue(JKind.FLOAT, False, 0, f, text, None, "", None)
        n: int = 0
        k: int = 0
        while k < len(text):
            n = n * 10 + (ord(text[k]) - 48)
            k += 1
        return jnum(n)


def jbool(v: bool) -> JValue:
    return JValue(JKind.BOOL, v, 0, 0.0, "", None, "", None)


def jnum(v: int) -> JValue:
    return JValue(JKind.NUM, False, v, 0.0, "", None, "", None)


def jfnum(v: float) -> JValue:
    return JValue(JKind.FLOAT, False, 0, v, "", None, "", None)


def jstr(v: str) -> JValue:
    return JValue(JKind.STR, False, 0, 0.0, v, None, "", None)


def jnull() -> JValue:
    return JValue(JKind.NIL, False, 0, 0.0, "", None, "", None)


def jarr(items: list[JValue]) -> JValue:
    return JValue(JKind.ARR, False, 0, 0.0, "", items, "", None)


def tag(node: JValue) -> str:
    return node.arr[0].s


def elem(node: JValue, i: int) -> JValue:
    return node.arr[i]


def elem_str(node: JValue, i: int) -> str:
    return node.arr[i].s


def p2(e: int) -> int:
    r: int = 1
    while e > 0:
        r *= 2
        e -= 1
    return r


def utf8_blen(s: str) -> int:
    n: int = 0
    i: int = 0
    while i < len(s):
        cp = ord(s[i])
        if cp < 0x80:
            n += 1
        elif cp < 0x800:
            n += 2
        elif cp < 0x10000:
            n += 3
        else:
            n += 4
        i += 1
    return n


def str_utf8_escape(s: str) -> str:
    # UTF-8 bytes of s, WAT-escaped: printable ASCII as-is, " and \\
    # backslash-escaped, everything else as \\XX hex
    out: str = ""
    i: int = 0
    while i < len(s):
        cp = ord(s[i])
        n: int = 1
        if cp >= 0x80:
            n = 2
        if cp >= 0x800:
            n = 3
        if cp >= 0x10000:
            n = 4
        k: int = 0
        while k < n:
            sh: int = 6 * (n - 1 - k)
            part: int = cp // p2(sh)
            bv: int = part
            if k == 0:
                if n == 2:
                    bv = 192 + part
                elif n == 3:
                    bv = 224 + part
                elif n == 4:
                    bv = 240 + part
            else:
                bv = 128 + part % 64
            if bv >= 32 and bv < 127 and bv != 34 and bv != 92:
                out = out + chr(bv)
            else:
                h: str = "0123456789abcdef"
                out = out + "\\" + h[bv // 16] + h[bv % 16]
            k += 1
        i += 1
    return out


def i64_le_wat(v: int) -> str:
    # 8 little-endian bytes of v, WAT-escaped (literal lens are small:
    # the high bytes always come out zero)
    out: str = ""
    h: str = "0123456789abcdef"
    k: int = 0
    while k < 8:
        b: int = v % 256
        v = v // 256
        out = out + "\\" + h[b // 16] + h[b % 16]
        k += 1
    return out


class Arena:
    off: int
    segs: list[str]

    def intern(self, s: str) -> int:
        # str ABI: every str object carries a 16-byte little-endian
        # prefix [blen][clen] before its NUL-terminated bytes; the
        # interned pointer aims AT THE BYTES so all byte-level
        # consumers (str_eq / hash / write) stay unchanged
        off: int = self.off
        esc: str = str_utf8_escape(s)
        blen: int = utf8_blen(s)
        self.segs.append("(data (i64.const " + str(off) + ") \"" + i64_le_wat(blen) + i64_le_wat(len(s)) + esc + "\\00\")")
        self.off = off + blen + 17
        return off + 16


class Fn:
    name: str
    params: JValue
    ptypes: JValue
    body: JValue
    rtype: str


FUNCS: list[Fn] = []

# module-level variables become wasm globals: functions read/write them
# via global.get/global.set (CPython module scope semantics). Types are
# fixed by the top-level annotation, or inferred for bare assigns.
GNAMES: list[str] = []
GTYPES: list[str] = []
# annotated module names, collected before inference so top_type can
# see through name operands (u = s + s with s: str annotates "s")
ANNTYPES: list[str] = []
ANNTYPES_T: list[str] = []
# emitting context: CTX[0] == 1 while $silu_main's top-level statements
# are emitted (a module-level bool flag would be shadowed by a local
# inside main() - this program obeys its own global-write rules)
CTX: list[int] = [0]


def ann_lookup(name: str) -> str:
    i: int = 0
    while i < len(ANNTYPES):
        if ANNTYPES[i] == name:
            return ANNTYPES_T[i]
        i += 1
    return "i"


def top_type(node: JValue) -> str:
    # infer a module variable's type from its first initializer
    if node.kind == JKind.STR:
        return "s"
    if node.kind == JKind.FLOAT:
        return "f"
    if node.kind == JKind.BOOL:
        return "b"
    t: str = tag(node)
    if t == "name":
        return ann_lookup(elem(node, 1).s)
    if t == "const":
        if elem(node, 1).kind == JKind.FLOAT:
            return "f"
        if elem(node, 1).kind == JKind.STR:
            return "s"
        if elem(node, 1).kind == JKind.BOOL:
            return "b"
        return "i"
    if t == "list":
        return "li"
    if t == "dict":
        return "ds"
    if t == "/":
        return "f"
    if t == "+" or t == "-" or t == "*" or t == "**":
        a: str = top_type(elem(node, 1))
        if a == "s" or a == "f":
            return a
        if len(node.arr) == 3:
            b: str = top_type(elem(node, 2))
            if b == "s" or b == "f":
                return b
        return "i"
    if t == "call":
        name: str = elem(elem(node, 1), 1).s
        fi: int = fn_lookup(name)
        if fi >= 0:
            return FUNCS[fi].rtype
    return "i"


def fn_lookup(name: str) -> int:
    i: int = 0
    while i < len(FUNCS):
        if FUNCS[i].name == name:
            return i
        i += 1
    return -1


def is_str_window(g: Gen, stmt: JValue) -> int:
    # x = x + e: the narrow window - the target re-binds its own buffer
    # through $str_extend (amortized O(1) when the buffer is the newest
    # heap allocation). Excluded when the right operand is the target
    # itself: x = x + x would memory.copy overlapping ranges.
    nm: str = elem_str(stmt, 1)
    r: JValue = elem(stmt, 2)
    if tag(r) != "+" or expr_type(g, r) != "s":
        return 0
    if tag(elem(r, 1)) != "name" or elem(elem(r, 1), 1).s != nm:
        return 0
    if tag(elem(r, 2)) == "name" and elem(elem(r, 2), 1).s == nm:
        return 0
    return 1


def ann_type(node: JValue) -> str:
    # ["name", "float"] -> "f"; ["name", "str"] -> "s";
    # ["subscript", list, X] -> "li"; anything else -> "i"
    if node.kind == JKind.ARR and len(node.arr) > 1:
        if node.arr[1].s == "float":
            return "f"
        if node.arr[1].s == "str":
            return "s"
        if node.arr[1].s == "bool":
            return "b"
        if tag(node) == "subscript":
            # ["subscript", ["name","dict"], ...] -> ds; else list
            if elem_str(elem(node, 1), 1) == "list":
                # element type rides at elem(node,2)'s name slot
                et: str = elem_str(elem(node, 2), 1)
                if et == "float":
                    return "lf"
                return "li"
            if elem_str(elem(node, 1), 1) == "dict":
                # dict[K, V]: ["tuple", [[K],[V]]], each T a ["name","x"]
                # node - the name sits at arr[1].s (three hops per side)
                kt: str = elem_str(elem(elem(elem(node, 2), 1), 0), 1)
                vt: str = elem_str(elem(elem(elem(node, 2), 1), 1), 1)
                if kt == "int":
                    if vt == "float":
                        return "dsif"
                    if vt == "str":
                        return "dsis"
                    return "dsi"
                if vt == "float":
                    return "dsf"
                if vt == "str":
                    return "dss"
                return "ds"
            return "li"
    return "i"


def collect_locals(stmts: JValue, names: list[str], types: list[str]) -> int:
    i: int = 0
    while i < len(stmts.arr):
        s = elem(stmts, i)
        t: str = tag(s)
        if t == "assign" or t == "ann_assign":
            # target is the bare name string; aug wraps it as a name node.
            # no recursion into the value expr - expr nodes are not stmt
            # lists and tag() would subscript None on bare names
            nm: str = elem_str(s, 1)
            if nm not in names:
                names.append(nm)
                if t == "ann_assign":
                    types.append(ann_type(elem(s, 3)))
                else:
                    types.append("")
            elif t == "ann_assign":
                j2: int = 0
                while j2 < len(names):
                    if names[j2] == nm:
                        types[j2] = ann_type(elem(s, 3))
                    j2 += 1
        elif t == "aug_assign":
            # only bare-name targets need a local; subscript targets
            # (l[0] += 1) read-modify-write through their container
            if tag(elem(s, 1)) == "name":
                nm: str = elem_str(elem(s, 1), 1)
                if nm not in names:
                    names.append(nm)
                    types.append("")
        elif t == "if":
            collect_locals(elem(s, 2), names, types)
            collect_locals(elem(s, 3), names, types)
        elif t == "while":
            collect_locals(elem(s, 2), names, types)
        elif t == "for":
            vn: str = elem_str(elem(s, 1), 1)
            if vn not in names:
                names.append(vn)
                types.append("i")
            collect_locals(elem(s, 3), names, types)
        i += 1
    return 0


class Gen:
    out: str
    tmp: int
    names: list[str]
    tnames: list[str]
    ttypes: list[str]
    ar: Arena
    loop_exit: str
    loop_top: str
    rtype: str
    pars: list[str]

    def emit(self, line: str) -> int:
        self.out = self.out + line + "\n"
        return 0

    def fresh(self) -> str:
        self.tmp += 1
        nm: str = "$t" + self.show_int(self.tmp)
        self.names.append(nm)
        self.tnames.append(nm)
        self.ttypes.append("i")
        return nm

    def set_type(self, name: str, ty: str) -> int:
        i: int = 0
        while i < len(self.tnames):
            if self.tnames[i] == name:
                self.ttypes[i] = ty
                return 0
            i += 1
        self.tnames.append(name)
        self.ttypes.append(ty)
        return 0

    def get_type(self, name: str) -> str:
        i: int = 0
        while i < len(self.tnames):
            if self.tnames[i] == name:
                return self.ttypes[i]
            i += 1
        return "i"

    def decls(self) -> str:
        # names/tnames/ttypes grow in lockstep (fresh and the ctor append
        # to all three); params live only in tnames/ttypes
        d: str = ""
        i: int = 0
        while i < len(self.names):
            ty: str = "i64"
            j: int = 0
            while j < len(self.tnames):
                if self.tnames[j] == self.names[i]:
                    if self.ttypes[j] == "f":
                        ty = "f64"
                j += 1
            d = d + " (local " + self.names[i] + " " + ty + ")"
            i += 1
        return d

    def show_int(self, v: int) -> str:
        if v < 0:
            return "-" + self.show_int(0 - v)
        digits: str = ""
        table: str = "0123456789"
        n: int = v
        while True:
            digits = table[n % 10] + digits
            n = n // 10
            if n == 0:
                return digits


def expr_type(g: Gen, node: JValue) -> str:
    t: str = tag(node)
    if t == "list":
        return "li"
    if t == "dict":
        return "ds"
    if t == "subscript":
        bt: str = expr_type(g, elem(node, 1))
        if bt == "s" or bt == "dss" or bt == "dsis":
            return "s"
        if bt == "dsf" or bt == "dsif" or bt == "lf":
            return "f"
        return "i"
    if t == "in":
        # ds_has/li_has return 0/1: bool-tagged so print renders
        # True/False like CPython
        return "b"
    if t == "len":
        return "i"
    if t == "const":
        if elem(node, 1).kind == JKind.FLOAT:
            return "f"
        if elem(node, 1).kind == JKind.STR:
            return "s"
        return "i"
    if t == "name":
        return g.get_type("$" + elem(node, 1).s)
    if t == "/":
        return "f"
    if t == "+":
        if expr_type(g, elem(node, 1)) == "s":
            return "s"
        if expr_type(g, elem(node, 2)) == "s":
            return "s"
    if t == "call":
        if tag(elem(node, 1)) == "attribute":
            recv: JValue = elem(elem(node, 1), 1)
            mname: str = elem_str(elem(node, 1), 2)
            if expr_type(g, recv) == "s" and (mname == "upper" or mname == "lower"):
                return "s"
        name: str = elem(elem(node, 1), 1).s
        if name == "input":
            return "s"
        if name == "float":
            return "f"
        if name == "str":
            return "s"
        fi: int = fn_lookup(name)
        if fi >= 0:
            return FUNCS[fi].rtype
        return "i"
    if t == "+" or t == "-" or t == "*" or t == "**":
        a: str = expr_type(g, elem(node, 1))
        if a == "f":
            return "f"
        if a == "li" and t == "*":
            return "li"
        if len(node.arr) == 3:
            b: str = expr_type(g, elem(node, 2))
            if b == "f":
                return "f"
            if b == "li" and t == "*":
                return "li"
        return "i"
    if t == "//" or t == "%":
        if expr_type(g, elem(node, 1)) == "f" or expr_type(g, elem(node, 2)) == "f":
            return "f"
        return "i"
    if t == "and" or t == "or" or t == "not":
        return "b"
    if t == "<" or t == "<=" or t == ">" or t == ">=" or t == "==" or t == "!=":
        return "b"
    if t == "const":
        if elem(node, 1).kind == JKind.BOOL:
            return "b"
    return "i"


def to_s(g: Gen, node: JValue) -> str:
    et: str = expr_type(g, node)
    if et == "s":
        return emit_expr(g, node)
    if et == "i":
        return "(call $str_from_int " + emit_expr(g, node) + ")"
    if et == "f":
        # a real str object (the old single-use scratch pointer had no
        # length prefix - and two operands in one expression shared it)
        return "(call $str_from_f64 " + to_f(g, node) + ")"
    # li/ds have no string form in this subset: loud trap, not silent 0
    return "(unreachable)"


def to_f(g: Gen, node: JValue) -> str:
    if expr_type(g, node) == "f":
        return emit_expr(g, node)
    return "(f64.convert_i64_s " + emit_expr(g, node) + ")"


def emit_expr(g: Gen, node: JValue) -> str:
    t: str = tag(node)
    if t == "const":
        if elem(node, 1).kind == JKind.FLOAT:
            # the original decimal text is a valid WAT f64 constant and
            # wat2wasm parses it correctly-rounded, same as CPython
            return "(f64.const " + elem(node, 1).s + ")"
        if elem(node, 1).kind == JKind.STR:
            return "(i64.const " + str(g.ar.intern(elem(node, 1).s)) + ")"
        if elem(node, 1).kind == JKind.BOOL:
            if elem(node, 1).b:
                return "(i64.const 1)"
            return "(i64.const 0)"
        return "(i64.const " + str(elem(node, 1).n) + ")"
    if t == "name":
        nm: str = elem(node, 1).s
        if nm in GNAMES and ("$" + nm) not in g.names and ("$" + nm) not in g.pars:
            return "(global.get $" + nm + ")"
        return "(local.get $" + nm + ")"
    if t == "list":
        # element container is node.arr[1]; build via appends, each
        # element evaluated exactly once, float elements bit-packed
        lv: str = g.fresh()
        g.emit("(local.set " + lv + " (call $li_new))")
        ei: int = 0
        while ei < len(elem(node, 1).arr):
            it: str = emit_expr(g, elem(elem(node, 1), ei))
            if expr_type(g, elem(elem(node, 1), ei)) == "f":
                it = "(i64.reinterpret_f64 " + it + ")"
            g.emit("(call $li_append (local.get " + lv + ") " + it + ")")
            ei += 1
        return "(local.get " + lv + ")"
    if t == "dict":
        if len(elem(node, 1).arr) > 0:
            return "(unreachable)"
        return "(call $ds_new)"
    if t == "in":
        ct: str = expr_type(g, elem(node, 2))
        if ct == "li":
            return "(call $li_has " + emit_expr(g, elem(node, 2)) + " " + emit_expr(g, elem(node, 1)) + ")"
        if ct == "dsi":
            return "(call $dsi_has " + emit_expr(g, elem(node, 2)) + " " + emit_expr(g, elem(node, 1)) + ")"
        return "(call $ds_has " + emit_expr(g, elem(node, 2)) + " " + emit_expr(g, elem(node, 1)) + ")"
    if t == "subscript":
        bt: str = expr_type(g, elem(node, 1))
        idx: JValue = elem(node, 2)
        if bt == "ds" or bt == "dsf" or bt == "dss":
            base: str = "(call $ds_get " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, idx) + ")"
            if bt == "dsf":
                # float values are stored bit-packed in the i64 slot
                return "(f64.reinterpret_i64 " + base + ")"
            return base
        if bt == "dsi" or bt == "dsif" or bt == "dsis":
            base = "(call $dsi_get " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, idx) + ")"
            if bt == "dsif":
                return "(f64.reinterpret_i64 " + base + ")"
            return base
        if bt == "lf":
            return "(f64.reinterpret_i64 (call $li_get " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, idx) + "))"
        if bt == "s":
            if tag(idx) == "slice":
                sa: JValue = elem(idx, 1)
                sb: JValue = elem(idx, 2)
                sc: JValue = elem(idx, 3)
                base: str = emit_expr(g, elem(node, 1))
                if sa.kind == JKind.NIL:
                    a2: str = "(i64.const 0)"
                else:
                    a2 = emit_expr(g, sa)
                if sb.kind == JKind.NIL:
                    b2: str = "(i64.const 0)"
                else:
                    b2 = emit_expr(g, sb)
                if sc.kind == JKind.NIL:
                    s2: str = "(i64.const 1)"
                else:
                    s2 = emit_expr(g, sc)
                ha: str = "0"
                if sa.kind != JKind.NIL:
                    ha = "1"
                hb: str = "0"
                if sb.kind != JKind.NIL:
                    hb = "1"
                return "(call $str_slice4 " + base + " " + a2 + " " + b2 + " " + s2 + " (i64.const " + ha + ") (i64.const " + hb + "))"
            return "(call $str_get " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, idx) + ")"
        return "(call $li_get " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, idx) + ")"
    if t == "line":
        return "(i64.const 0)"
    if t == "call":
        name: str = elem(elem(node, 1), 1).s
        args: JValue = elem(node, 2)
        if tag(elem(node, 1)) == "attribute":
            recv: JValue = elem(elem(node, 1), 1)
            mname: str = elem_str(elem(node, 1), 2)
            if expr_type(g, recv) == "s" and mname == "upper":
                return "(call $str_upper " + emit_expr(g, recv) + ")"
            if expr_type(g, recv) == "s" and mname == "lower":
                return "(call $str_lower " + emit_expr(g, recv) + ")"
            if mname == "get":
                ct2: str = expr_type(g, recv)
                gargs: JValue = elem(node, 2)
                # get(k[, default]): single evaluation into fresh locals
                kl: str = g.fresh()
                dl: str = g.fresh()
                g.emit("(local.set " + kl + " " + emit_expr(g, elem(gargs, 0)) + ")")
                if len(gargs.arr) > 1:
                    g.emit("(local.set " + dl + " " + emit_expr(g, elem(gargs, 1)) + ")")
                else:
                    g.emit("(local.set " + dl + " (i64.const 0))")
                finder: str = "$ds_get_or"
                if ct2 == "dsi" or ct2 == "dsif" or ct2 == "dsis":
                    finder = "$dsi_get_or"
                base2: str = "(call " + finder + " " + emit_expr(g, recv) + " (local.get " + kl + ") (local.get " + dl + "))"
                if ct2 == "dsf" or ct2 == "dsif" or ct2 == "lf":
                    return "(f64.reinterpret_i64 " + base2 + ")"
                return base2
        if name == "input":
            return "(call $read_line)"
        if name == "float":
            if expr_type(g, elem(args, 0)) == "s":
                return "(unreachable)"
            return "(f64.convert_i64_s " + emit_expr(g, elem(args, 0)) + ")"
        if name == "str":
            return to_s(g, elem(args, 0))
        if name == "len":
            at2: str = expr_type(g, elem(args, 0))
            if at2 == "s":
                return "(call $str_clen " + emit_expr(g, elem(args, 0)) + ")"
            if at2 == "ds" or at2 == "dsf" or at2 == "dss" or at2 == "dsi" or at2 == "dsif" or at2 == "dsis":
                return "(call $ds_len " + emit_expr(g, elem(args, 0)) + ")"
            return "(call $li_len " + emit_expr(g, elem(args, 0)) + ")"
        fi = fn_lookup(name)
        if fi < 0:
            # unknown callee (class constructor, missing builtin): loud
            return "(unreachable)"
        folded: str = ""
        i = 0
        while i < len(args.arr):
            pt: str = "i"
            pt = ann_type(elem(FUNCS[fi].ptypes, i))
            if pt == "f":
                folded = folded + " " + to_f(g, elem(args, i))
            elif pt == "s":
                # str params take owned copies: the callee may append to
                # them through the narrow-window extend path
                folded = folded + " (call $s_copy " + to_s(g, elem(args, i)) + ")"
            else:
                folded = folded + " " + emit_expr(g, elem(args, i))
            i += 1
        return "(call $" + name + folded + ")"
    if t == "+":
        ty: str = expr_type(g, node)
        if ty == "f":
            return "(f64.add " + to_f(g, elem(node, 1)) + " " + to_f(g, elem(node, 2)) + ")"
        if ty == "s":
            return "(call $str_concat " + to_s(g, elem(node, 1)) + " " + to_s(g, elem(node, 2)) + ")"
        return "(i64.add " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + ")"
    if t == "*":
        if expr_type(g, node) == "f":
            return "(f64.mul " + to_f(g, elem(node, 1)) + " " + to_f(g, elem(node, 2)) + ")"
        if expr_type(g, elem(node, 1)) == "li" or expr_type(g, elem(node, 2)) == "li":
            # [x] * n: element-wise repeat into a fresh list
            lp: str = g.fresh()
            kp: str = g.fresh()
            if expr_type(g, elem(node, 1)) == "li":
                g.emit("(local.set " + lp + " " + emit_expr(g, elem(node, 1)) + ")")
                g.emit("(local.set " + kp + " " + emit_expr(g, elem(node, 2)) + ")")
            else:
                g.emit("(local.set " + lp + " " + emit_expr(g, elem(node, 2)) + ")")
                g.emit("(local.set " + kp + " " + emit_expr(g, elem(node, 1)) + ")")
            return "(call $li_repeat (local.get " + lp + ") (local.get " + kp + "))"
        if expr_type(g, elem(node, 1)) == "s" or expr_type(g, elem(node, 2)) == "s":
            return "(unreachable)"
        return "(i64.mul " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + ")"
    if t == "-":
        if expr_type(g, node) == "f":
            if len(node.arr) == 2:
                return "(f64.neg " + emit_expr(g, elem(node, 1)) + ")"
            return "(f64.sub " + to_f(g, elem(node, 1)) + " " + to_f(g, elem(node, 2)) + ")"
        if len(node.arr) == 2:
            return "(i64.sub (i64.const 0) " + emit_expr(g, elem(node, 1)) + ")"
        return "(i64.sub " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + ")"
    if t == "/":
        return "(f64.div " + to_f(g, elem(node, 1)) + " " + to_f(g, elem(node, 2)) + ")"
    if t == "//":
        return emit_floordiv(g, elem(node, 1), elem(node, 2))
    if t == "%":
        return emit_floormod(g, elem(node, 1), elem(node, 2))
    if t == "**":
        if expr_type(g, node) == "f":
            return "(call $f64_pow " + to_f(g, elem(node, 1)) + " " + to_f(g, elem(node, 2)) + ")"
        return emit_ipow(g, elem(node, 1), elem(node, 2))
    if t == "not":
        return "(i64.extend_i32_u (i32.eqz (i32.wrap_i64 " + emit_expr(g, elem(node, 1)) + ")))"
    if t == "and" or t == "or":
        # truthiness semantics with short-circuit; value semantics for
        # int operands (x and y returning an operand) is a subset gap
        tv: str = g.fresh()
        ae: str = emit_expr(g, elem(node, 1))
        if t == "and":
            g.emit("(local.set " + tv + " (i64.const 0))")
            g.emit("(if (i32.wrap_i64 " + ae + ") (then (if (i32.wrap_i64 " + emit_expr(g, elem(node, 2)) + ") (then (local.set " + tv + " (i64.const 1))))))")
        else:
            g.emit("(local.set " + tv + " (i64.const 1))")
            g.emit("(if (i32.wrap_i64 " + ae + ") (then) (else (if (i32.wrap_i64 " + emit_expr(g, elem(node, 2)) + ") (then (local.set " + tv + " (i64.const 1))))))")
        return "(local.get " + tv + ")"
    if t == "<":
        if expr_type(g, elem(node, 1)) == "s" or expr_type(g, elem(node, 2)) == "s":
            return "(i64.extend_i32_u (i32.wrap_i64 (call $str_lt " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + ")))"
        if expr_type(g, elem(node, 1)) == "f" or expr_type(g, elem(node, 2)) == "f":
            return "(i64.extend_i32_u (f64.lt " + to_f(g, elem(node, 1)) + " " + to_f(g, elem(node, 2)) + "))"
        return "(i64.extend_i32_u (i64.lt_s " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + "))"
    if t == "<=":
        if expr_type(g, elem(node, 1)) == "s" or expr_type(g, elem(node, 2)) == "s":
            return "(i64.extend_i32_u (i32.wrap_i64 (i64.xor (call $str_lt " + emit_expr(g, elem(node, 2)) + " " + emit_expr(g, elem(node, 1)) + ") (i64.const 1))))"
        if expr_type(g, elem(node, 1)) == "f" or expr_type(g, elem(node, 2)) == "f":
            return "(i64.extend_i32_u (f64.le " + to_f(g, elem(node, 1)) + " " + to_f(g, elem(node, 2)) + "))"
        return "(i64.extend_i32_u (i64.le_s " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + "))"
    if t == ">":
        if expr_type(g, elem(node, 1)) == "s" or expr_type(g, elem(node, 2)) == "s":
            return "(i64.extend_i32_u (i32.wrap_i64 (call $str_lt " + emit_expr(g, elem(node, 2)) + " " + emit_expr(g, elem(node, 1)) + ")))"
        if expr_type(g, elem(node, 1)) == "f" or expr_type(g, elem(node, 2)) == "f":
            return "(i64.extend_i32_u (f64.gt " + to_f(g, elem(node, 1)) + " " + to_f(g, elem(node, 2)) + "))"
        return "(i64.extend_i32_u (i64.gt_s " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + "))"
    if t == ">=":
        if expr_type(g, elem(node, 1)) == "s" or expr_type(g, elem(node, 2)) == "s":
            return "(i64.extend_i32_u (i32.wrap_i64 (i64.xor (call $str_lt " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + ") (i64.const 1))))"
        if expr_type(g, elem(node, 1)) == "f" or expr_type(g, elem(node, 2)) == "f":
            return "(i64.extend_i32_u (f64.ge " + to_f(g, elem(node, 1)) + " " + to_f(g, elem(node, 2)) + "))"
        return "(i64.extend_i32_u (i64.ge_s " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + "))"
    if t == "==":
        if expr_type(g, elem(node, 1)) == "s" or expr_type(g, elem(node, 2)) == "s":
            return "(i64.extend_i32_u (i32.wrap_i64 (call $str_eq " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + ")))"
        if expr_type(g, elem(node, 1)) == "f" or expr_type(g, elem(node, 2)) == "f":
            return "(i64.extend_i32_u (f64.eq " + to_f(g, elem(node, 1)) + " " + to_f(g, elem(node, 2)) + "))"
        return "(i64.extend_i32_u (i64.eq " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + "))"
    if t == "!=":
        if expr_type(g, elem(node, 1)) == "s" or expr_type(g, elem(node, 2)) == "s":
            return "(i64.extend_i32_u (i32.wrap_i64 (i64.xor (call $str_eq " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + ") (i64.const 1))))"
        if expr_type(g, elem(node, 1)) == "f" or expr_type(g, elem(node, 2)) == "f":
            return "(i64.extend_i32_u (f64.ne " + to_f(g, elem(node, 1)) + " " + to_f(g, elem(node, 2)) + "))"
        return "(i64.extend_i32_u (i64.ne " + emit_expr(g, elem(node, 1)) + " " + emit_expr(g, elem(node, 2)) + "))"
    return "(i64.const 0)"


def emit_floordiv(g: Gen, a: JValue, b: JValue) -> str:
    if expr_type(g, a) == "f" or expr_type(g, b) == "f":
        return "(f64.floor (f64.div " + to_f(g, a) + " " + to_f(g, b) + "))"
    # q = a/b (trunc); correct down when remainder and divisor agree in sign
    q: str = g.fresh()
    r: str = g.fresh()
    al: str = g.fresh()
    bl: str = g.fresh()
    g.emit("(local.set " + al + " " + emit_expr(g, a) + ")")
    g.emit("(local.set " + bl + " " + emit_expr(g, b) + ")")
    ae: str = "(local.get " + al + ")"
    be: str = "(local.get " + bl + ")"
    g.emit("(local.set " + q + " (i64.div_s " + ae + " " + be + "))")
    g.emit("(local.set " + r + " (i64.rem_s " + ae + " " + be + "))")
    cond: str = "(i32.and (i64.ne (local.get " + r + ") (i64.const 0)) (i64.ne (i64.xor (i64.shr_s (local.get " + r + ") (i64.const 63)) (i64.shr_s " + be + " (i64.const 63))) (i64.const 0)))"
    return "(if (result i64) " + cond + " (then (i64.sub (local.get " + q + ") (i64.const 1))) (else (local.get " + q + ")))"


def emit_floormod(g: Gen, a: JValue, b: JValue) -> str:
    if expr_type(g, a) == "f" or expr_type(g, b) == "f":
        al2: str = g.fresh()
        bl2: str = g.fresh()
        q2: str = g.fresh()
        g.set_type(al2, "f")
        g.set_type(bl2, "f")
        g.set_type(q2, "f")
        g.emit("(local.set " + al2 + " " + to_f(g, a) + ")")
        g.emit("(local.set " + bl2 + " " + to_f(g, b) + ")")
        g.emit("(local.set " + q2 + " (f64.floor (f64.div (local.get " + al2 + ") (local.get " + bl2 + "))))")
        return "(f64.sub (local.get " + al2 + ") (f64.mul (local.get " + q2 + ") (local.get " + bl2 + ")))"
    # r = a%b (trunc); if r != 0 and sign(r) != sign(b): r += b
    r: str = g.fresh()
    al: str = g.fresh()
    bl: str = g.fresh()
    g.emit("(local.set " + al + " " + emit_expr(g, a) + ")")
    g.emit("(local.set " + bl + " " + emit_expr(g, b) + ")")
    ae: str = "(local.get " + al + ")"
    be: str = "(local.get " + bl + ")"
    g.emit("(local.set " + r + " (i64.rem_s " + ae + " " + be + "))")
    cond: str = "(i32.and (i64.ne (local.get " + r + ") (i64.const 0)) (i64.ne (i64.xor (i64.shr_s (local.get " + r + ") (i64.const 63)) (i64.shr_s " + be + " (i64.const 63))) (i64.const 0)))"
    return "(if (result i64) " + cond + " (then (i64.add (local.get " + r + ") " + be + ")) (else (local.get " + r + ")))"


def emit_ipow(g: Gen, a: JValue, b: JValue) -> str:
    # exponentiation by squaring into a temp; skip the dead final square
    base: str = g.fresh()
    e: str = g.fresh()
    r: str = g.fresh()
    g.emit("(local.set " + base + " " + emit_expr(g, a) + ")")
    g.emit("(local.set " + e + " " + emit_expr(g, b) + ")")
    g.emit("(local.set " + r + " (i64.const 1))")
    g.emit("(block (loop (br_if 1 (i64.le_s (local.get " + e + ") (i64.const 0))) (if (i32.wrap_i64 (i64.rem_s (local.get " + e + ") (i64.const 2))) (then (local.set " + r + " (i64.mul (local.get " + r + ") (local.get " + base + "))))) (local.set " + e + " (i64.div_s (local.get " + e + ") (i64.const 2))) (br_if 1 (i64.le_s (local.get " + e + ") (i64.const 0))) (local.set " + base + " (i64.mul (local.get " + base + ") (local.get " + base + "))) (br 0)))")
    return "(local.get " + r + ")"


def emit_stmts(g: Gen, stmts: JValue) -> int:
    i: int = 0
    while i < len(stmts.arr):
        emit_stmt(g, elem(stmts, i))
        i += 1
    return 0


def emit_stmt(g: Gen, stmt: JValue) -> int:
    t: str = tag(stmt)
    if t == "line":
        return 0
    if t == "subscript_assign":
        bt: str = expr_type(g, elem(stmt, 1))
        d: str = emit_expr(g, elem(stmt, 1))
        k: str = emit_expr(g, elem(stmt, 2))
        # value emitted exactly once per branch (side-effect safety);
        # str keys/values are stored as owned copies - a stored pointer
        # that aliases the source variable would be corrupted by the
        # narrow-window in-place extend
        if bt == "ds" or bt == "dsi":
            v: str = emit_expr(g, elem(stmt, 3))
            setter: str = "$ds_set"
            if bt == "dsi":
                setter = "$dsi_set"
            if bt == "ds":
                g.emit("(call " + setter + " " + d + " (call $s_copy " + k + ") " + v + ")")
            else:
                g.emit("(call " + setter + " " + d + " " + k + " " + v + ")")
        elif bt == "dsf" or bt == "dsif":
            setter = "$ds_set"
            if bt == "dsif":
                setter = "$dsi_set"
            if bt == "dsf":
                g.emit("(call " + setter + " " + d + " (call $s_copy " + k + ") (i64.reinterpret_f64 " + to_f(g, elem(stmt, 3)) + "))")
            else:
                g.emit("(call " + setter + " " + d + " " + k + " (i64.reinterpret_f64 " + to_f(g, elem(stmt, 3)) + "))")
        elif bt == "lf":
            g.emit("(call $li_set " + d + " " + k + " (i64.reinterpret_f64 " + to_f(g, elem(stmt, 3)) + "))")
        elif bt == "dss" or bt == "dsis":
            setter = "$ds_set"
            if bt == "dsis":
                setter = "$dsi_set"
            if bt == "dss":
                g.emit("(call " + setter + " " + d + " (call $s_copy " + k + ") (call $s_copy " + to_s(g, elem(stmt, 3)) + "))")
            else:
                g.emit("(call " + setter + " " + d + " " + k + " (call $s_copy " + to_s(g, elem(stmt, 3)) + "))")
        else:
            g.emit("(call $li_set " + d + " " + k + " " + emit_expr(g, elem(stmt, 3)) + ")")
        return 0
    if t == "assign" or t == "ann_assign":
        nm: str = "$" + elem_str(stmt, 1)
        if nm not in g.names and nm not in g.pars and elem_str(stmt, 1) in GNAMES:
            # module-level variable: mutate the wasm global
            gt: str = "$" + elem_str(stmt, 1)
            gi: int = 0
            gt2: str = "i"
            while gi < len(GNAMES):
                if GNAMES[gi] == elem_str(stmt, 1):
                    gt2 = GTYPES[gi]
                gi += 1
            if gt2 == "f":
                g.emit("(global.set " + gt + " " + to_f(g, elem(stmt, 2)) + ")")
            elif gt2 == "s":
                # narrow window extends the global's own buffer; any
                # other str bind takes an owned copy
                if is_str_window(g, stmt):
                    g.emit("(global.set " + gt + " (call $str_extend (global.get " + gt + ") " + to_s(g, elem(elem(stmt, 2), 2)) + "))")
                else:
                    g.emit("(global.set " + gt + " (call $s_copy " + to_s(g, elem(stmt, 2)) + "))")
            else:
                g.emit("(global.set " + gt + " " + emit_expr(g, elem(stmt, 2)) + ")")
            return 0
        if t == "ann_assign":
            g.set_type(nm, ann_type(elem(stmt, 3)))
        vt: str = expr_type(g, elem(stmt, 2))
        if vt == "f" or vt == "s" or vt == "li" or vt == "ds" or vt == "b":
            # empty container literals infer plain "ds"/"li" - never
            # downgrade a declared richer type back to them
            cur3: str = g.get_type(nm)
            downgrade: int = 0
            if vt == "ds" and (cur3 == "dsf" or cur3 == "dss" or cur3 == "dsi" or cur3 == "dsif" or cur3 == "dsis"):
                downgrade = 1
            if vt == "li" and cur3 == "lf":
                downgrade = 1
            if downgrade == 0:
                g.set_type(nm, vt)
        if g.get_type(nm) == "f":
            g.emit("(local.set " + nm + " " + to_f(g, elem(stmt, 2)) + ")")
        elif g.get_type(nm) == "s":
            # narrow window (x = x + e) extends the target's own buffer
            # in place; every other str bind takes an owned copy so no
            # two names ever share a mutable buffer
            if is_str_window(g, stmt):
                g.emit("(local.set " + nm + " (call $str_extend (local.get " + nm + ") " + to_s(g, elem(elem(stmt, 2), 2)) + "))")
            else:
                g.emit("(local.set " + nm + " (call $s_copy " + to_s(g, elem(stmt, 2)) + "))")
        else:
            g.emit("(local.set " + nm + " " + emit_expr(g, elem(stmt, 2)) + ")")
        return 0
    if t == "aug_assign":
        if tag(elem(stmt, 1)) == "subscript":
            # l[i] op= v / d[k] op= v: read-modify-write, each operand
            # evaluated once into a fresh local; only += -= *= here
            bt: str = expr_type(g, elem(elem(stmt, 1), 1))
            cl2: str = g.fresh()
            il2: str = g.fresh()
            g.emit("(local.set " + cl2 + " " + emit_expr(g, elem(elem(stmt, 1), 1)) + ")")
            g.emit("(local.set " + il2 + " " + emit_expr(g, elem(elem(stmt, 1), 2)) + ")")
            op2: str = elem_str(stmt, 2)
            cur: str = "(call $li_get (local.get " + cl2 + ") (local.get " + il2 + "))"
            setter: str = "$li_set"
            if bt == "dss" or bt == "dsif" or bt == "dsis":
                # str dict values have no read-modify-write here
                g.emit("(unreachable)")
                return 0
            if bt == "dsf" or bt == "lf":
                # float slots: read-modify-write through the bit packing;
                # the RHS is evaluated once into an f64 fresh local
                vf: str = g.fresh()
                g.set_type(vf, "f")
                g.emit("(local.set " + vf + " " + to_f(g, elem(stmt, 3)) + ")")
                cur2: str = "(f64.reinterpret_i64 " + cur + ")"
                if op2 == "+=":
                    body3: str = "(i64.reinterpret_f64 (f64.add " + cur2 + " (local.get " + vf + ")))"
                elif op2 == "-=":
                    body3 = "(i64.reinterpret_f64 (f64.sub " + cur2 + " (local.get " + vf + ")))"
                elif op2 == "*=":
                    body3 = "(i64.reinterpret_f64 (f64.mul " + cur2 + " (local.get " + vf + ")))"
                else:
                    g.emit("(unreachable)")
                    return 0
                g.emit("(call " + setter + " (local.get " + cl2 + ") (local.get " + il2 + ") " + body3 + ")")
                return 0
            # integer-valued slots: RHS evaluated once into an i64 fresh
            vl2: str = g.fresh()
            g.emit("(local.set " + vl2 + " " + emit_expr(g, elem(stmt, 3)) + ")")
            if bt == "dsi":
                cur = "(call $dsi_get (local.get " + cl2 + ") (local.get " + il2 + "))"
                setter = "$dsi_set"
            elif bt == "ds":
                cur = "(call $ds_get (local.get " + cl2 + ") (local.get " + il2 + "))"
                setter = "$ds_set"
            if op2 == "+=":
                body2: str = "(i64.add " + cur + " (local.get " + vl2 + "))"
            elif op2 == "-=":
                body2 = "(i64.sub " + cur + " (local.get " + vl2 + "))"
            elif op2 == "*=":
                body2 = "(i64.mul " + cur + " (local.get " + vl2 + "))"
            else:
                # //= %= **= on subscripts: unsupported (loud)
                g.emit("(unreachable)")
                return 0
            g.emit("(call " + setter + " (local.get " + cl2 + ") (local.get " + il2 + ") " + body2 + ")")
            return 0
        tgt: str = "$" + elem_str(elem(stmt, 1), 1)
        op: str = elem_str(stmt, 2)
        if CTX[0] == 1 and tgt not in g.names and elem_str(elem(stmt, 1), 1) in GNAMES:
            # module-level variable: read-modify-write the global
            gi: int = 0
            gt3: str = "i"
            while gi < len(GNAMES):
                if GNAMES[gi] == elem_str(elem(stmt, 1), 1):
                    gt3 = GTYPES[gi]
                gi += 1
            if gt3 == "f":
                rhs_g = to_f(g, elem(stmt, 3))
                if op == "+=":
                    g.emit("(global.set " + tgt + " (f64.add (global.get " + tgt + ") " + rhs_g + "))")
                elif op == "-=":
                    g.emit("(global.set " + tgt + " (f64.sub (global.get " + tgt + ") " + rhs_g + "))")
                elif op == "*=":
                    g.emit("(global.set " + tgt + " (f64.mul (global.get " + tgt + ") " + rhs_g + "))")
                elif op == "/=":
                    g.emit("(global.set " + tgt + " (f64.div (global.get " + tgt + ") " + rhs_g + "))")
                elif op == "//=":
                    g.emit("(global.set " + tgt + " (f64.floor (f64.div (global.get " + tgt + ") " + rhs_g + ")))")
                elif op == "%=":
                    qf: str = g.fresh()
                    g.emit("(local.set " + qf + " (f64.floor (f64.div (global.get " + tgt + ") " + rhs_g + ")))")
                    g.emit("(global.set " + tgt + " (f64.sub (global.get " + tgt + ") (f64.mul (local.get " + qf + ") " + rhs_g + ")))")
                return 0
            if gt3 == "s":
                # str aug: += is the narrow window (loud for everything
                # else - /= etc have no str meaning in CPython either)
                if op == "+=":
                    if tag(elem(stmt, 3)) == "name" and elem(elem(stmt, 3), 1).s == elem_str(elem(stmt, 1), 1):
                        g.emit("(global.set " + tgt + " (call $str_concat (global.get " + tgt + ") " + to_s(g, elem(stmt, 3)) + "))")
                    else:
                        g.emit("(global.set " + tgt + " (call $str_extend (global.get " + tgt + ") " + to_s(g, elem(stmt, 3)) + "))")
                else:
                    g.emit("(unreachable)")
                return 0
            rhs_g = emit_expr(g, elem(stmt, 3))
            if op == "+=":
                g.emit("(global.set " + tgt + " (i64.add (global.get " + tgt + ") " + rhs_g + "))")
            elif op == "-=":
                g.emit("(global.set " + tgt + " (i64.sub (global.get " + tgt + ") " + rhs_g + "))")
            elif op == "*=":
                g.emit("(global.set " + tgt + " (i64.mul (global.get " + tgt + ") " + rhs_g + "))")
            elif op == "//=":
                g.emit("(global.set " + tgt + " " + emit_floordiv(g, elem(stmt, 1), elem(stmt, 3)) + ")")
            elif op == "%=":
                g.emit("(global.set " + tgt + " " + emit_floormod(g, elem(stmt, 1), elem(stmt, 3)) + ")")
            elif op == "**=":
                g.emit("(global.set " + tgt + " " + emit_ipow(g, elem(stmt, 1), elem(stmt, 3)) + ")")
            return 0
        ftarget: str = g.get_type(tgt)
        if ftarget == "s":
            # plain-name str aug: += concatenates in place through the
            # narrow-window extend (was a silent pointer add before);
            # any other op on a str target is a loud gap
            if op == "+=":
                if tag(elem(stmt, 3)) == "name" and elem(elem(stmt, 3), 1).s == elem_str(elem(stmt, 1), 1):
                    g.emit("(local.set " + tgt + " (call $str_concat (local.get " + tgt + ") " + to_s(g, elem(stmt, 3)) + "))")
                else:
                    g.emit("(local.set " + tgt + " (call $str_extend (local.get " + tgt + ") " + to_s(g, elem(stmt, 3)) + "))")
            else:
                g.emit("(unreachable)")
            return 0
        if ftarget == "f":
            rhs_f: str = to_f(g, elem(stmt, 3))
            if op == "+=":
                g.emit("(local.set " + tgt + " (f64.add (local.get " + tgt + ") " + rhs_f + "))")
            elif op == "-=":
                g.emit("(local.set " + tgt + " (f64.sub (local.get " + tgt + ") " + rhs_f + "))")
            elif op == "*=":
                g.emit("(local.set " + tgt + " (f64.mul (local.get " + tgt + ") " + rhs_f + "))")
            elif op == "/=":
                g.emit("(local.set " + tgt + " (f64.div (local.get " + tgt + ") " + rhs_f + "))")
            elif op == "//=":
                g.emit("(local.set " + tgt + " (f64.floor (f64.div (local.get " + tgt + ") " + rhs_f + ")))")
            elif op == "%=":
                qf: str = g.fresh()
                g.emit("(local.set " + qf + " (f64.floor (f64.div (local.get " + tgt + ") " + rhs_f + ")))")
                g.emit("(local.set " + tgt + " (f64.sub (local.get " + tgt + ") (f64.mul (local.get " + qf + ") " + rhs_f + ")))")
            return 0
        rhs: str = emit_expr(g, elem(stmt, 3))
        if op == "+=":
            g.emit("(local.set " + tgt + " (i64.add (local.get " + tgt + ") " + rhs + "))")
        elif op == "-=":
            g.emit("(local.set " + tgt + " (i64.sub (local.get " + tgt + ") " + rhs + "))")
        elif op == "*=":
            g.emit("(local.set " + tgt + " (i64.mul (local.get " + tgt + ") " + rhs + "))")
        elif op == "//=":
            g.emit("(local.set " + tgt + " " + emit_floordiv(g, elem(stmt, 1), elem(stmt, 3)) + ")")
        elif op == "%=":
            g.emit("(local.set " + tgt + " " + emit_floormod(g, elem(stmt, 1), elem(stmt, 3)) + ")")
        elif op == "**=":
            g.emit("(local.set " + tgt + " " + emit_ipow(g, elem(stmt, 1), elem(stmt, 3)) + ")")
        else:
            # /= would retype the variable to float (CPython semantics) -
            # unsupported: loud trap, never silently keep the old value
            g.emit("(unreachable)")
        return 0
    if t == "call":
        head: JValue = elem(stmt, 1)
        if tag(head) == "attribute":
            mname: str = elem_str(head, 2)
            if mname == "append":
                av: str = emit_expr(g, elem(elem(stmt, 2), 0))
                if expr_type(g, elem(head, 1)) == "lf":
                    av = "(i64.reinterpret_f64 " + to_f(g, elem(elem(stmt, 2), 0)) + ")"
                g.emit("(call $li_append " + emit_expr(g, elem(head, 1)) + " " + av + ")")
                return 0
        name: str = elem(elem(stmt, 1), 1).s
        args: JValue = elem(stmt, 2)
        if name == "print":
            i: int = 0
            while i < len(args.arr):
                if i > 0:
                    g.emit("(call $print_sp)")
                at: str = expr_type(g, elem(args, i))
                if at == "b":
                    g.emit("(call $print_bool " + emit_expr(g, elem(args, i)) + ")")
                elif at == "f":
                    g.emit("(call $print_f64 " + emit_expr(g, elem(args, i)) + ")")
                elif at == "li":
                    g.emit("(call $print_li " + emit_expr(g, elem(args, i)) + ")")
                elif at == "lf":
                    g.emit("(call $print_lf " + emit_expr(g, elem(args, i)) + ")")
                elif at == "ds":
                    g.emit("(call $print_ds " + emit_expr(g, elem(args, i)) + ")")
                elif at == "dsf":
                    g.emit("(call $print_dsf " + emit_expr(g, elem(args, i)) + ")")
                elif at == "dss":
                    g.emit("(call $print_dss " + emit_expr(g, elem(args, i)) + ")")
                elif at == "dsi":
                    g.emit("(call $print_dsi " + emit_expr(g, elem(args, i)) + ")")
                elif at == "dsif" or at == "dsis":
                    # int-keyed float/str dict rendering: loud gap
                    g.emit("(unreachable)")
                elif at == "s":
                    # single evaluation: the slice result goes to a fresh
                    # local; write reads it twice (ptr + blen)
                    se: str = g.fresh()
                    g.emit("(local.set " + se + " " + emit_expr(g, elem(args, i)) + ")")
                    g.emit("(call $write (i32.const 1) (local.get " + se + ") (call $str_blen (local.get " + se + ")))")
                else:
                    g.emit("(call $print_i64 " + emit_expr(g, elem(args, i)) + ")")
                i += 1
            g.emit("(call $print_nl)")
            return 0
        fi = fn_lookup(name)
        if fi < 0:
            # unknown callee at statement level: loud trap
            g.emit("(unreachable)")
            return 0
        folded: str = ""
        i = 0
        while i < len(args.arr):
            pt3: str = ann_type(elem(FUNCS[fi].ptypes, i))
            if pt3 == "s":
                folded = folded + " (call $s_copy " + to_s(g, elem(args, i)) + ")"
            else:
                folded = folded + " " + emit_expr(g, elem(args, i))
            i += 1
        g.emit("(drop (call $" + name + folded + "))")
        return 0
    if t == "func_def":
        return 0
    if t == "return":
        if g.rtype == "f":
            g.emit("(local.set $rv " + to_f(g, elem(stmt, 1)) + ")")
        elif g.rtype == "s":
            g.emit("(local.set $rv " + to_s(g, elem(stmt, 1)) + ")")
        else:
            g.emit("(local.set $rv " + emit_expr(g, elem(stmt, 1)) + ")")
        g.emit("(br $fn_exit)")
        return 0
    if t == "if":
        cond: str = emit_expr(g, elem(stmt, 1))
        g.emit("(if (i32.wrap_i64 " + cond + ") (then")
        emit_stmts(g, elem(stmt, 2))
        g.emit(") (else")
        emit_stmts(g, elem(stmt, 3))
        g.emit("))")
        return 0
    if t == "for":
        # for x in l: body  ->  index temp; while idx < len(l): x = l[idx]
        bt: str = expr_type(g, elem(stmt, 2))
        var: str = "$" + elem(elem(stmt, 1), 1).s
        lst: str = emit_expr(g, elem(stmt, 2))
        if bt == "ds" or bt == "dsf" or bt == "dss" or bt == "dsi" or bt == "dsif" or bt == "dsis":
            di: str = g.fresh()
            dii: str = g.fresh()
            g.emit("(local.set " + di + " " + lst + ")")
            g.emit("(local.set " + dii + " (i64.const 0))")
            g.tmp += 1
            de: str = "$de" + g.show_int(g.tmp)
            dt: str = "$dt" + g.show_int(g.tmp)
            saved_de: str = g.loop_exit
            saved_dt: str = g.loop_top
            g.loop_exit = de
            g.loop_top = dt
            g.emit("(block " + de + " (loop " + dt)
            g.emit("(br_if " + de + " (i64.ge_u (local.get " + dii + ") (call $ds_len (local.get " + di + "))))")
            if bt == "ds" or bt == "dsf" or bt == "dss":
                g.set_type(var, "s")
                # owned copy: extending the loop var in the body must
                # never touch the dict's stored key
                g.emit("(local.set " + var + " (call $s_copy (call $ds_key (local.get " + di + ") (local.get " + dii + "))))")
            else:
                g.emit("(local.set " + var + " (call $ds_key (local.get " + di + ") (local.get " + dii + ")))")
            emit_stmts(g, elem(stmt, 3))
            g.emit("(local.set " + dii + " (i64.add (local.get " + dii + ") (i64.const 1)))")
            g.emit("(br " + dt + ")))")
            g.loop_exit = saved_de
            g.loop_top = saved_dt
            return 0
        li: str = g.fresh()
        idx: str = g.fresh()
        g.emit("(local.set " + li + " " + lst + ")")
        g.emit("(local.set " + idx + " (i64.const 0))")
        g.tmp += 1
        fe: str = "$fe" + g.show_int(g.tmp)
        ft: str = "$ft" + g.show_int(g.tmp)
        saved_fe: str = g.loop_exit
        saved_ft: str = g.loop_top
        g.loop_exit = fe
        g.loop_top = ft
        g.emit("(block " + fe + " (loop " + ft)
        g.emit("(br_if " + fe + " (i64.ge_u (local.get " + idx + ") (call $li_len (local.get " + li + "))))")
        if bt == "lf":
            g.set_type(var, "f")
            g.emit("(local.set " + var + " (f64.reinterpret_i64 (call $li_get (local.get " + li + ") (local.get " + idx + "))))")
        else:
            g.emit("(local.set " + var + " (call $li_get (local.get " + li + ") (local.get " + idx + ")))")
        emit_stmts(g, elem(stmt, 3))
        g.emit("(local.set " + idx + " (i64.add (local.get " + idx + ") (i64.const 1)))")
        g.emit("(br " + ft + ")))")
        g.loop_exit = saved_fe
        g.loop_top = saved_ft
        return 0
    if t == "while":
        g.tmp += 1
        we: str = "$we" + g.show_int(g.tmp)
        wt: str = "$wt" + g.show_int(g.tmp)
        saved_we: str = g.loop_exit
        saved_wt: str = g.loop_top
        g.loop_exit = we
        g.loop_top = wt
        g.emit("(block " + we + " (loop " + wt)
        cond: str = emit_expr(g, elem(stmt, 1))
        g.emit("(br_if " + we + " (i32.eqz (i32.wrap_i64 " + cond + ")))")
        emit_stmts(g, elem(stmt, 2))
        g.emit("(br " + wt + ")))")
        g.loop_exit = saved_we
        g.loop_top = saved_wt
        return 0
    if t == "break":
        if g.loop_exit == "":
            g.emit("(unreachable)")
        else:
            g.emit("(br " + g.loop_exit + ")")
        return 0
    if t == "continue":
        if g.loop_top == "":
            g.emit("(unreachable)")
        else:
            g.emit("(br " + g.loop_top + ")")
        return 0
    return 0


def emit_fn(g: Gen, fn: Fn) -> int:
    names: list[str] = []
    types: list[str] = []
    params: list[str] = []
    ptypes: list[str] = []
    i: int = 0
    sig: str = ""
    while i < len(fn.params.arr):
        pn: str = fn.params.arr[i].s
        pty: str = ann_type(elem(fn.ptypes, i))
        ptypes.append(pty)
        pyt: str = "i64"
        if pty == "f":
            pyt = "f64"
        sig = sig + " (param $" + pn + " " + pyt + ")"
        names.append(pn)
        params.append(pn)
        types.append(pty)
        i += 1
    collect_locals(fn.body, names, types)
    i = 0
    while i < len(fn.params.arr):
        if ptypes[i] == "f":
            types[i] = "f"
        i += 1
    # non-param source names + fresh temps all become wasm locals; the
    # body goes through a scratch Gen so its fresh temps are known
    # before the header closes
    local_names: list[str] = []
    local_types: list[str] = []
    i = len(params)
    while i < len(names):
        local_names.append("$" + names[i])
        local_types.append(types[i])
        i += 1
    tcopy: list[str] = []
    i = 0
    while i < len(local_names):
        tcopy.append(local_names[i])
        i += 1
    parnames: list[str] = []
    i = 0
    while i < len(params):
        parnames.append("$" + params[i])
        i += 1
    sub: Gen = Gen("", 0, local_names, tcopy, local_types, g.ar, "", "", fn.rtype, parnames)
    i = 0
    while i < len(params):
        sub.set_type("$" + params[i], ptypes[i])
        i += 1
    j: int = 0
    while j < len(GNAMES):
        sub.set_type("$" + GNAMES[j], GTYPES[j])
        j += 1
    emit_stmts(sub, fn.body)
    rvt: str = "i64"
    if fn.rtype == "f":
        rvt = "f64"
    head: str = "(func $" + fn.name + sig + " (result " + rvt + ")" + sub.decls() + " (local $rv " + rvt + ")"
    g.emit(head)
    g.emit("(block $fn_exit")
    g.out = g.out + sub.out
    g.emit(")")
    g.emit("(local.get $rv))")
    return 0


RT_HEAD = '''(module
(import "silu_host" "write" (func $write (param i32 i64 i64)))
(import "silu_host" "fmt_double" (func $fmt_double (param i64 i64 f64 i32 i32) (result i64)))
(import "silu_host" "pow" (func $f64_pow (param f64 f64) (result f64)))
(import "silu_host" "getchar" (func $getchar (result i32)))
(memory i64 1)
(export "memory" (memory 0))
'''

RT_FUNCS = '''(func $alloc (param $n i64) (result i64)
(local $old i64) (local $want i64) (local $pages i64) (local $cur i64)
(local.set $old (global.get $heap))
(local.set $want (i64.add (local.get $old) (local.get $n)))
(local.set $cur (i64.mul (memory.size) (i64.const 65536)))
(if (i64.gt_u (local.get $want) (local.get $cur))
  (then
    (local.set $pages (i64.div_u (i64.sub (i64.add (local.get $want) (i64.const 65535)) (local.get $cur)) (i64.const 65536)))
    (if (i64.eq (memory.grow (local.get $pages)) (i64.const -1))
      (then unreachable))))
(global.set $heap (local.get $want))
(local.get $old))
(func $li_new (result i64)
(local $p i64)
(local.set $p (call $alloc (i64.const 24)))
(i64.store (local.get $p) (i64.const 0))
(i64.store (i64.add (local.get $p) (i64.const 8)) (i64.const 0))
(i64.store (i64.add (local.get $p) (i64.const 16)) (i64.const 0))
(local.get $p))
(func $li_append (param $l i64) (param $v i64)
(local $len i64) (local $cap i64) (local $data i64) (local $ndata i64) (local $ncap i64)
(local.set $len (i64.load (local.get $l)))
(local.set $cap (i64.load (i64.add (local.get $l) (i64.const 8))))
(local.set $data (i64.load (i64.add (local.get $l) (i64.const 16))))
(if (i64.ge_u (local.get $len) (local.get $cap))
  (then
    (local.set $ncap (i64.mul (i64.add (local.get $cap) (i64.const 1)) (i64.const 2)))
    (local.set $ndata (call $alloc (i64.mul (local.get $ncap) (i64.const 8))))
    (memory.copy (local.get $ndata) (local.get $data) (i64.mul (local.get $len) (i64.const 8)))
    (i64.store (i64.add (local.get $l) (i64.const 16)) (local.get $ndata))
    (i64.store (i64.add (local.get $l) (i64.const 8)) (local.get $ncap))
    (local.set $data (local.get $ndata))))
(i64.store (i64.add (local.get $data) (i64.mul (local.get $len) (i64.const 8))) (local.get $v))
(i64.store (local.get $l) (i64.add (local.get $len) (i64.const 1))))
(func $li_get (param $l i64) (param $i i64) (result i64)
(local $data i64)
(if (i64.lt_s (local.get $i) (i64.const 0))
  (then (local.set $i (i64.add (local.get $i) (i64.load (local.get $l))))))
(if (i64.ge_u (local.get $i) (i64.load (local.get $l)))
  (then unreachable))
(local.set $data (i64.load (i64.add (local.get $l) (i64.const 16))))
(i64.load (i64.add (local.get $data) (i64.mul (local.get $i) (i64.const 8)))))
(func $li_set (param $l i64) (param $i i64) (param $v i64)
(local $data i64)
(if (i64.lt_s (local.get $i) (i64.const 0))
  (then (local.set $i (i64.add (local.get $i) (i64.load (local.get $l))))))
(if (i64.ge_u (local.get $i) (i64.load (local.get $l)))
