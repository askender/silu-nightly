(local.set $asc (i64.const 1))
(block $done (loop $rd
(local.set $ch (i64.extend_i32_s (call $getchar)))
(br_if $done (i64.eq (local.get $ch) (i64.const -1)))
(br_if $done (i64.eq (local.get $ch) (i64.const 10)))
(if (i64.ge_u (local.get $ch) (i64.const 128))
  (then (local.set $asc (i64.const 0))))
(i64.store8 (i64.add (i64.const 200) (local.get $i)) (local.get $ch))
(local.set $i (i64.add (local.get $i) (i64.const 1)))
(br_if $done (i64.ge_u (local.get $i) (i64.const 4096)))
(br $rd)))
(local.set $n (call $alloc (i64.add (local.get $i) (i64.const 17))))
(memory.copy (i64.add (local.get $n) (i64.const 16)) (i64.const 200) (local.get $i))
(i64.store8 (i64.add (i64.add (local.get $n) (i64.const 16)) (local.get $i)) (i64.const 0))
(i64.store (local.get $n) (local.get $i))
(if (i64.eqz (local.get $asc))
  (then (i64.store (i64.add (local.get $n) (i64.const 8)) (call $cp_scan (i64.add (local.get $n) (i64.const 16)) (local.get $i))))
  (else (i64.store (i64.add (local.get $n) (i64.const 8)) (local.get $i))))
(i64.add (local.get $n) (i64.const 16)))
(func $print_lf (param $l i64)
(local $i i64) (local $n i64)
(i64.store8 (i64.const 96) (i64.const 91))
(call $write (i32.const 1) (i64.const 96) (i64.const 1))
(local.set $n (i64.load (local.get $l)))
(local.set $i (i64.const 0))
(block $done
(loop $again
(br_if $done (i64.ge_u (local.get $i) (local.get $n)))
(if (i64.gt_u (local.get $i) (i64.const 0))
  (then
    (i64.store8 (i64.const 96) (i64.const 44))
    (i64.store8 (i64.const 97) (i64.const 32))
    (call $write (i32.const 1) (i64.const 96) (i64.const 2))))
(call $print_f64 (f64.reinterpret_i64 (call $li_get (local.get $l) (local.get $i))))
(local.set $i (i64.add (local.get $i) (i64.const 1)))
(br $again)))
(i64.store8 (i64.const 96) (i64.const 93))
(call $write (i32.const 1) (i64.const 96) (i64.const 1)))
(func $str_upper (param $p i64) (result i64)
(local $n i64) (local $p2 i64) (local $i i64) (local $b i64)
(local.set $n (call $str_blen (local.get $p)))
(local.set $p2 (call $alloc (i64.add (local.get $n) (i64.const 17))))
(local.set $i (i64.const 0))
(block $done (loop $again
(br_if $done (i64.ge_u (local.get $i) (local.get $n)))
(local.set $b (i64.load8_u (i64.add (local.get $p) (local.get $i))))
(if (i32.and (i64.ge_u (local.get $b) (i64.const 97)) (i64.le_u (local.get $b) (i64.const 122)))
  (then (local.set $b (i64.sub (local.get $b) (i64.const 32)))))
(i64.store8 (i64.add (i64.add (local.get $p2) (i64.const 16)) (local.get $i)) (local.get $b))
(local.set $i (i64.add (local.get $i) (i64.const 1)))
(br $again)))
(i64.store8 (i64.add (i64.add (local.get $p2) (i64.const 16)) (local.get $n)) (i64.const 0))
(i64.store (local.get $p2) (local.get $n))
;; the transform rewrites ASCII letters only: codepoint count preserved
(i64.store (i64.add (local.get $p2) (i64.const 8)) (call $str_clen (local.get $p)))
(i64.add (local.get $p2) (i64.const 16)))
(func $str_lower (param $p i64) (result i64)
(local $n i64) (local $p2 i64) (local $i i64) (local $b i64)
(local.set $n (call $str_blen (local.get $p)))
(local.set $p2 (call $alloc (i64.add (local.get $n) (i64.const 17))))
(local.set $i (i64.const 0))
(block $done (loop $again
(br_if $done (i64.ge_u (local.get $i) (local.get $n)))
(local.set $b (i64.load8_u (i64.add (local.get $p) (local.get $i))))
(if (i32.and (i64.ge_u (local.get $b) (i64.const 65)) (i64.le_u (local.get $b) (i64.const 90)))
  (then (local.set $b (i64.add (local.get $b) (i64.const 32)))))
(i64.store8 (i64.add (i64.add (local.get $p2) (i64.const 16)) (local.get $i)) (local.get $b))
(local.set $i (i64.add (local.get $i) (i64.const 1)))
(br $again)))
(i64.store8 (i64.add (i64.add (local.get $p2) (i64.const 16)) (local.get $n)) (i64.const 0))
(i64.store (local.get $p2) (local.get $n))
(i64.store (i64.add (local.get $p2) (i64.const 8)) (call $str_clen (local.get $p)))
(i64.add (local.get $p2) (i64.const 16)))
;; str(float): fmt_double renders into the shared scratch, then the
;; digits (pure ASCII) move into a real str object - every str value
;; in flight owns its length prefix
(func $str_from_f64 (param $v f64) (result i64)
(local $n i64) (local $q i64)
(local.set $n (call $fmt_double (i64.const 64) (i64.const 400) (local.get $v) (i32.const 114) (i32.const 17)))
(local.set $q (call $alloc (i64.add (local.get $n) (i64.const 17))))
(memory.copy (i64.add (local.get $q) (i64.const 16)) (i64.const 64) (local.get $n))
(i64.store8 (i64.add (i64.add (local.get $q) (i64.const 16)) (local.get $n)) (i64.const 0))
(i64.store (local.get $q) (local.get $n))
(i64.store (i64.add (local.get $q) (i64.const 8)) (local.get $n))
(i64.add (local.get $q) (i64.const 16)))
(func $print_i64 (param $v i64)
(local $p i64) (local $len i64)
(if (i64.lt_s (local.get $v) (i64.const 0))
  (then
    (i64.store8 (i64.const 64) (i64.const 45))
    (call $write (i32.const 1) (i64.const 64) (i64.const 1))
    (local.set $v (i64.sub (i64.const 0) (local.get $v)))))
(local.set $p (i64.const 87))
(loop $digits
  (local.set $p (i64.sub (local.get $p) (i64.const 1)))
  (i64.store8 (local.get $p) (i64.add (i64.const 48) (i64.rem_u (local.get $v) (i64.const 10))))
  (local.set $v (i64.div_u (local.get $v) (i64.const 10)))
  (br_if $digits (i64.gt_u (local.get $v) (i64.const 0))))
(call $write (i32.const 1) (local.get $p) (i64.sub (i64.const 87) (local.get $p))))
(func $print_f64 (param $v f64)
(local $n i64)
(local.set $n (call $fmt_double (i64.const 64) (i64.const 400) (local.get $v) (i32.const 114) (i32.const 17)))
(call $write (i32.const 1) (i64.const 64) (local.get $n)))
(func $print_li (param $l i64)
(local $i i64) (local $n i64)
(i64.store8 (i64.const 96) (i64.const 91))
(call $write (i32.const 1) (i64.const 96) (i64.const 1))
(local.set $n (i64.load (local.get $l)))
(local.set $i (i64.const 0))
(block $done
(loop $again
(br_if $done (i64.ge_u (local.get $i) (local.get $n)))
(if (i64.gt_u (local.get $i) (i64.const 0))
  (then
    (i64.store8 (i64.const 96) (i64.const 44))
    (i64.store8 (i64.const 97) (i64.const 32))
    (call $write (i32.const 1) (i64.const 96) (i64.const 2))))
(call $print_i64 (call $li_get (local.get $l) (local.get $i)))
(local.set $i (i64.add (local.get $i) (i64.const 1)))
(br $again)))
(i64.store8 (i64.const 96) (i64.const 93))
(call $write (i32.const 1) (i64.const 96) (i64.const 1)))
(func $print_sp
(i64.store8 (i64.const 90) (i64.const 32))
(call $write (i32.const 1) (i64.const 90) (i64.const 1)))
(func $print_nl
(i64.store8 (i64.const 90) (i64.const 10))
(call $write (i32.const 1) (i64.const 90) (i64.const 1)))'''


def main() -> int:
    src: str = read_stdin()
    parser: Json = Json(src, 0)
    root: JValue = parser.value()
    stmts: JValue = elem(root, 1)
    # pass 0: module-level variables -> wasm globals
    # 0a: collect annotated names first so bare-assign inference can
    # see through name operands
    i = 0
    while i < len(stmts.arr):
        s = elem(stmts, i)
        if tag(s) == "ann_assign":
            vname: str = elem_str(s, 1)
            if vname not in ANNTYPES:
                ANNTYPES.append(vname)
                ANNTYPES_T.append(ann_type(elem(s, 3)))
        i += 1
    i = 0
    while i < len(stmts.arr):
        s = elem(stmts, i)
        t0: str = tag(s)
        if t0 == "ann_assign" or t0 == "assign":
            vname: str = elem_str(s, 1)
            if vname not in GNAMES:
                GNAMES.append(vname)
                if t0 == "ann_assign":
                    GTYPES.append(ann_type(elem(s, 3)))
                else:
                    GTYPES.append(top_type(elem(s, 2)))
        i += 1
    # pass 1: register functions (hoisted to the top by the front end)
    i: int = 0
    while i < len(stmts.arr):
        s = elem(stmts, i)
        if tag(s) == "func_def":
            fn: Fn = Fn("", None, None, None, "")
            fn.name = elem_str(s, 1)
            fn.params = elem(s, 2)
            fn.ptypes = elem(s, 4)
            fn.body = elem(s, 3)
            rt = elem(s, 5)
            if rt.kind == JKind.NIL:
                fn.rtype = "i"
            else:
                fn.rtype = ann_type(rt)
            FUNCS.append(fn)
        i += 1
    ar: Arena = Arena(1024, [])
    body: Gen = Gen("", 0, [], [], [], ar, "", "", "i", [])
    # pass 2: user functions, then the top-level statements as $silu_main
    i = 0
    while i < len(FUNCS):
        emit_fn(body, FUNCS[i])
        i += 1
    names: list[str] = []
    types: list[str] = []
    collect_locals(stmts, names, types)
    local_names: list[str] = []
    local_types: list[str] = []
    i = 0
    while i < len(names):
        # globals live in wasm globals, not in $silu_main's locals
        if names[i] in GNAMES:
            i += 1
            continue
        local_names.append("$" + names[i])
        local_types.append(types[i])
        i += 1
    tcopy2: list[str] = []
    i = 0
    while i < len(local_names):
        tcopy2.append(local_names[i])
        i += 1
    sub: Gen = Gen("", 0, local_names, tcopy2, local_types, ar, "", "", "i", [])
    j: int = 0
    while j < len(GNAMES):
        sub.set_type("$" + GNAMES[j], GTYPES[j])
        j += 1
    CTX[0] = 1
    emit_stmts(sub, stmts)
    CTX[0] = 0
    body.emit("(func $silu_main (export \"silu_main\")" + sub.decls())
    body.out = body.out + sub.out
    body.emit(")")
    # assemble: head + heap (past all data) + data segs + funcs + close
    out: str = RT_HEAD
    si: int = 0
    out = out + "(global $heap (mut i64) (i64.const " + str(ar.off) + "))\n"
    # immutable copy of the data-segment end: $str_extend's region
    # guard rejects literal buffers (they live below this line)
    out = out + "(global $heap_base i64 (i64.const " + str(ar.off) + "))\n"
    gi = 0
    while gi < len(GNAMES):
        gty: str = "i64"
        if GTYPES[gi] == "f":
            gty = "f64"
        init: str = " (i64.const 0)"
        if GTYPES[gi] == "f":
            init = " (f64.const 0.0)"
        out = out + "(global $" + GNAMES[gi] + " (mut " + gty + ")" + init + ")\n"
        gi += 1
    while si < len(ar.segs):
        out = out + ar.segs[si] + "\n"
        si += 1
    out = out + RT_FUNCS
    out = out + body.out
    out = out + ")"
    print(out, end="")
    return 0
