# Silu Programming Language Demo
# Run this demo with: silu demo.si

print("========================================")
print("     Welcome to the Silu Demo!")
print("========================================")
print()

# Basic arithmetic operations
print("1. Basic Arithmetic Operations:")
print("-------------------------------")
x = 10 + 5
y = 10 - 3
z = 10 * 2
a = 10 / 3
b = 10 // 3
c = 10 % 3
d = 2 ** 3

print("x = 10 + 5 =", x)
print("y = 10 - 3 =", y)
print("z = 10 * 2 =", z)
print("a = 10 / 3 =", a)
print("b = 10 // 3 =", b)
print("c = 10 % 3 =", c)
print("d = 2 ** 3 =", d)
print()

# Unary operations
print("2. Unary Operations:")
print("--------------------")
e = +5
f = -5
g = not True
h = not False

print("e = +5 =", e)
print("f = -5 =", f)
print("g = not True =", g)
print("h = not False =", h)
print()

# Boolean operations
print("3. Boolean Operations:")
print("----------------------")
i = True and False
j = True or False
k = True and True
l = False or False

print("i = True and False =", i)
print("j = True or False =", j)
print("k = True and True =", k)
print("l = False or False =", l)
print()

# Comparison operations
print("4. Comparison Operations:")
print("-------------------------")
m = 5 == 5
n = 5 != 3
o = 5 < 10
p = 5 <= 5
q = 10 > 5
r = 10 >= 10

print("m = 5 == 5 =", m)
print("n = 5 != 3 =", n)
print("o = 5 < 10 =", o)
print("p = 5 <= 5 =", p)
print("q = 10 > 5 =", q)
print("r = 10 >= 10 =", r)
print()

# Chained comparisons
print("5. Chained Comparisons:")
print("-----------------------")
s = 3 < 5 < 7
t = 5 < 3 < 7

print("s = 3 < 5 < 7 =", s)
print("t = 5 < 3 < 7 =", t)
print()

# Variable assignments and usage
print("6. Variable Assignments and Usage:")
print("----------------------------------")
# Assign some values
width = 10
height = 5
area = width * height

# Use variables in expressions
perimeter = 2 * (width + height)

print("width =", width)
print("height =", height)
print("area = width * height =", area)
print("perimeter = 2 * (width + height) =", perimeter)
print()

# Complex expressions
print("7. Complex Expressions:")
print("-----------------------")
result = (10 + 5) * 2 - 5 // 2
print("(10 + 5) * 2 - 5 // 2 =", result)

comparison = (10 > 5) and (3 < 7)
print("(10 > 5) and (3 < 7) =", comparison)
print()

print("========================================")
print("        Demo completed successfully!")
print("========================================")