# Silu Programming Language - Core Features Demo
# Run with: silu demo.si

print("=== Silu Language Demo ===")

# 1. Variables and Basic Types
x = 42
y = 3.14
name = "Silu"
flag = True
print("Variables:", x, y, name, flag)

# 2. Arithmetic Operations
result = (10 + 5) * 2 - 8 // 3
print("Arithmetic result:", result)

# 3. Comparisons and Boolean Logic
check = (x > 30) and (y < 5) or flag
print("Boolean logic:", check)

# 4. Control Flow - If/Elif/Else
score = 85
if score >= 90:
    grade = "A"
elif score >= 80:
    grade = "B"
else:
    grade = "C"
print("Grade:", grade)

# 5. While Loop
count = 3
while count > 0:
    print("Countdown:", count)
    count = count - 1

# 6. For Loop with Range and Lists
numbers = [1, 2, 3, 4, 5]
total = 0
for num in numbers:
    total = total + num
print("Sum:", total)

# 7. Functions
def factorial(n):
    if n <= 1:
        return 1
    else:
        return n * factorial(n - 1)

print("Factorial of 5:", factorial(5))

# 8. Type Conversion and Checking
str_num = "123"
converted = int(str_num) + 77
print("Converted:", converted)
print("Type of converted:", type(converted))

# 9. Lambda Functions
double = lambda x: x * 2
print("Lambda result:", double(21))

# 10. Break and Continue
print("Even numbers 1-10:")
for i in range(1, 11):
    if i % 2 != 0:
        continue
    if i > 8:
        break
    print(i)

print("Demo completed!")
