# str semantics: concat, slicing by code point, len, comparison
s: str = "Hello, Silu!"
print(s)
print(len(s))
print(s[0], s[7])
print(s[7:11])
print(s[::-1])
print(s.upper())
print("ell" in s)
t: str = ""
i: int = 0
while i < 5:
    t = t + str(i) * (i % 3)
    i += 1
print(t)
print(s == "Hello, Silu!", s < "Hello, World!")
