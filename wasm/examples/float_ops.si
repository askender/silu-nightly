# float comparisons, float ** (host pow), str of float, floor semantics
def clamp(q: float) -> float:
    if q > 10.0:
        return 10.0
    if q < 0.5:
        return 0.5
    return q

print(clamp(3.25))
print(clamp(99.5))
print(clamp(0.1))

acc: float = 1.0
while acc < 100.0:
    acc = acc * 2.5
print(acc)

p: float = 2.0 ** 10.0
print(p)
print(9.0 ** 0.5)

x: float = 2.5
y: float = 1.25
if x > y and y > 0.5:
    print(x - y)

f: float = 7.5
g: float = 2.0
print(f / g)
print(f // g)
print(f % g)
s: str = str(f)
print(s + "!")
print(len(str(p)))
