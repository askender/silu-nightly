# while loops, counters, augmented assignment, nested control flow
i: int = 0
total: int = 0
while i < 10:
    total += i * i
    i += 1
print(total)

# collatz(27) - the famous long flight
n: int = 27
steps: int = 0
while n != 1:
    if n % 2 == 0:
        n //= 2
    else:
        n = 3 * n + 1
    steps += 1
print(steps)

d: int = 1
c: int = 0
while d <= 4096:
    d *= 2
    c += 1
print(d, c)

def digits_sum(n: int) -> int:
    s: int = 0
    while n > 0:
        s += n % 10
        n //= 10
    return s

print(digits_sum(2 ** 30))
