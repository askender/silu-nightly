# Symbolic Execution Demo for Silu Language
# This file demonstrates various control flow patterns that
# showcase the symbolic execution engine's capabilities

# Simple conditional function
def classify_number(x):
    if x > 0:
        if x > 10:
            return "large_positive"
        else:
            return "small_positive"
    elif x < 0:
        return "negative"
    else:
        return "zero"

# Function with loops and conditions
def process_value(n):
    result = 0
    i = 0
    while i < n:
        if i % 2 == 0:
            result = result + i
        else:
            result = result - i
        i = i + 1
    return result

# Nested conditions with multiple variables
def complex_logic(a, b, c):
    if a > b:
        if b > c:
            x = a + b + c
        else:
            x = a - b - c
    else:
        if a == b:
            x = a * b
        else:
            x = b - a

    if x > 100:
        return "high"
    elif x > 50:
        return "medium"
    else:
        return "low"

# Function with early returns
def early_return_example(value):
    if value < 0:
        return "negative"

    if value == 0:
        return "zero"

    if value > 100:
        return "too_large"

    # Normal processing
    result = value * 2
    if result > 50:
        return "large_result"
    else:
        return "small_result"

# Chained comparisons
def range_check(x):
    if 0 < x < 10:
        return "single_digit"
    elif 10 <= x <= 99:
        return "double_digit"
    elif 100 <= x <= 999:
        return "triple_digit"
    else:
        return "other"

# Function with boolean logic
def boolean_logic(p, q, r):
    if (p and q) or (not p and r):
        return "condition_1"
    elif p or (q and r):
        return "condition_2"
    else:
        return "condition_3"

# Main demonstration
print("Symbolic Execution Demo")
print("======================")

# These calls will be analyzed symbolically
result1 = classify_number(5)
print("Classification result:", result1)

result2 = process_value(3)
print("Process result:", result2)

result3 = complex_logic(10, 5, 8)
print("Complex logic result:", result3)

result4 = early_return_example(42)
print("Early return result:", result4)

result5 = range_check(25)
print("Range check result:", result5)

result6 = boolean_logic(True, False, True)
print("Boolean logic result:", result6)
